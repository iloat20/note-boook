/* ═══════════════════════════════════════════
   Minimal + Spatial UI Design System
   参考微信读书设计语言
   ═══════════════════════════════════════════ */

/* === Design Tokens === */
page {
  --color-bg: #F5F5F7;
  --color-surface: #FFFFFF;
  --color-title: #1D1D1F;
  --color-body: #6E6E73;
  --color-caption: #86868B;
  --color-separator: #E5E5EA;
  --color-accent: #FF6B35;
  --color-profit: #FF3B30;
  --color-loss: #34C759;
  --color-market-a: #007AFF;
  --color-market-hk: #FF9500;
  --color-market-us: #AF52DE;

  --shadow-sm: 0 1px 3px rgba(0,0,0,0.04);
  --shadow-md: 0 4px 12px rgba(0,0,0,0.06);
  --shadow-lg: 0 8px 30px rgba(0,0,0,0.08);

  --radius-card: 16px;
  --radius-btn: 12px;
  --radius-tag: 6px;
  --radius-input: 10px;

  --space-page: 20px;
  --space-module: 16px;
  --space-card-pad: 20px;
  --space-item: 12px;
  --space-inner: 8px;

  --font-display: 28px;
  --font-title: 20px;
  --font-body: 15px;
  --font-caption: 12px;

  --weight-display: 700;
  --weight-title: 600;
  --weight-body: 400;
  --weight-caption: 400;

  --transition-page: opacity 200ms ease-out, transform 200ms ease-out;

  /* === Liquid Glass Design Tokens === */
  --glass-bg: rgba(255, 255, 255, 0.72);
  --glass-bg-hover: rgba(255, 255, 255, 0.85);
  --glass-border: rgba(255, 255, 255, 0.3);
  --glass-shadow-out: 0 8px 32px rgba(0, 0, 0, 0.08);
  --glass-shadow-in: inset 0 1px 0 rgba(255, 255, 255, 0.6);
  --glass-blur: blur(20px);
  --glass-radius: 16px;

  background-color: var(--color-bg);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", sans-serif;
  font-size: var(--font-body);
  font-weight: var(--weight-body);
  color: var(--color-body);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* === Page Enter/Leave Transition === */
.page-enter {
  opacity: 0;
  transform: translateY(8px);
}
.page-enter-active {
  opacity: 1;
  transform: translateY(0);
  transition: var(--transition-page);
}

/* === Typography === */
.display {
  font-size: var(--font-display);
  font-weight: var(--weight-display);
  color: var(--color-title);
  letter-spacing: 0.02em;
  line-height: 1.2;
}
.title {
  font-size: var(--font-title);
  font-weight: var(--weight-title);
  color: var(--color-title);
  letter-spacing: 0.02em;
}
.body {
  font-size: var(--font-body);
  font-weight: var(--weight-body);
  color: var(--color-body);
  letter-spacing: -0.01em;
}
.caption {
  font-size: var(--font-caption);
  font-weight: var(--weight-caption);
  color: var(--color-caption);
}

/* === Surface Card === */
.card {
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: var(--space-card-pad);
  box-shadow: var(--shadow-md);
}
.card-sm {
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: var(--space-card-pad);
  box-shadow: var(--shadow-sm);
}
.card-lg {
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: var(--space-card-pad);
  box-shadow: var(--shadow-lg);
}

/* === CTA Button === */
.cta-btn {
  background: var(--color-accent);
  color: #FFFFFF;
  border-radius: var(--radius-btn);
  font-size: var(--font-body);
  font-weight: var(--weight-title);
  height: 44px;
  line-height: 44px;
  text-align: center;
  transition: opacity 100ms;
}
.cta-btn:active {
  opacity: 0.7;
}

/* === Text Button === */
.text-btn {
  color: var(--color-accent);
  font-size: var(--font-body);
  font-weight: var(--weight-title);
  padding: 8px 0;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 100ms;
}
.text-btn:active {
  opacity: 0.7;
}

/* === Tag Badge === */
.tag {
  display: inline-block;
  padding: 2px 8px;
  border-radius: var(--radius-tag);
  font-size: var(--font-caption);
  font-weight: 500;
}

/* === Profit / Loss Colors === */
.profit { color: var(--color-profit) !important; }
.loss { color: var(--color-loss) !important; }

/* === Market Colors === */
.market-a { background-color: var(--color-market-a); color: #FFF; }
.market-hk { background-color: var(--color-market-hk); color: #FFF; }
.market-us { background-color: var(--color-market-us); color: #FFF; }

/* === Divider === */
.divider {
  height: 1px;
  background: var(--color-separator);
  margin: var(--space-module) 0;
}

/* === Input === */
.input {
  background: var(--color-bg);
  border-radius: var(--radius-input);
  height: 44px;
  padding: 0 12px;
  font-size: var(--font-body);
  color: var(--color-title);
  transition: opacity 100ms;
}
.input:focus {
  background: #ECECEE;
}

/* === Page Container === */
.page-container {
  min-height: 100vh;
  padding: var(--space-page);
  padding-bottom: calc(80px + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* === Section Spacing === */
.section {
  margin-bottom: var(--space-module);
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

/* === Chip / Pill === */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 6px 14px;
  border-radius: 20px;
  background: var(--color-surface);
  box-shadow: var(--shadow-sm);
  font-size: var(--font-caption);
  color: var(--color-body);
  min-height: 32px;
  transition: opacity 100ms;
}
.chip-active {
  background: var(--color-title);
  color: #FFFFFF;
}
.chip:active { opacity: 0.7; }

/* === Empty State === */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 40px;
}
.empty-title {
  font-size: var(--font-title);
  font-weight: var(--weight-title);
  color: var(--color-title);
  margin-top: 16px;
}
.empty-desc {
  font-size: var(--font-body);
  color: var(--color-caption);
  margin-top: 8px;
}

/* === FAB === */
.fab {
  position: fixed;
  right: 24px;
  bottom: calc(100px + env(safe-area-inset-bottom));
  width: 56px;
  height: 56px;
  border-radius: 28px;
  background: var(--color-accent);
  color: #FFFFFF;
  box-shadow: var(--shadow-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  z-index: 100;
  transition: opacity 100ms;
}
.fab:active { opacity: 0.7; }

/* === Header Bar (自定义导航栏) === */
.nav-bar {
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--color-bg);
  padding-top: 0;
  padding-bottom: 8px;
}

/* === Liquid Slider (液态滑动器) === */
.liquid-slider {
  display: flex;
  background: #F0F0F3;
  border-radius: 12px;
  padding: 3px;
  position: relative;
  margin-bottom: var(--space-module);
}
.liquid-slider-bg {
  position: absolute;
  height: calc(100% - 6px);
  background: var(--color-accent);
  opacity: 0.15;
  border-radius: 10px;
  transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
}
.liquid-slider-item {
  flex: 1;
  text-align: center;
  padding: 8px 0;
  border-radius: 10px;
  font-size: var(--font-caption);
  color: var(--color-caption);
  position: relative;
  z-index: 1;
  transition: color 300ms;
}
.liquid-slider-item.active {
  color: var(--color-accent);
  font-weight: var(--weight-title);
}

/* === Scroll Container === */
/* 用在 scroll-view 上：继承父容器高度，配合 page-container 的 flex 布局 */
.scroll-container {
  flex: 1;
  height: 0;           /* flex 子项必须设 height:0 才能正确收缩 */
  min-height: 0;        /* 防止内容溢出 */
}

/* === Liquid Dissolve Animation (液态消融删除) === */
@keyframes dissolve-out {
  0% {
    transform: scale(1);
    opacity: 1;
    filter: blur(0);
  }
  100% {
    transform: scale(0.8);
    opacity: 0;
    filter: blur(4px);
  }
}
.dissolving {
  animation: dissolve-out 400ms ease-in forwards;
  pointer-events: none;
}

/* === Parallax (Z轴视差) === */
.parallax-container {
  perspective: 800px;
}
.parallax-card {
  transition: transform 100ms ease-out, box-shadow 100ms ease-out;
}
.parallax-near {
  transform: translateZ(20px);
}
.parallax-mid {
  transform: translateZ(0);
}
.parallax-far {
  transform: translateZ(-10px) scale(0.96);
}
