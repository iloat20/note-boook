/* ═════════════════════════════════════════╗
   小红书风格设计系统 v2 (Xiaohongshu Design)
   ╚════════════════════════════════════════╝ */

/* === Design Tokens === */
page {
  --xhs-primary: #FF2442;
  --xhs-primary-light: #FF6B7A;
  --xhs-primary-bg: rgba(255, 36, 66, 0.06);
  --xhs-primary-bg-2: rgba(255, 36, 66, 0.12);
  --xhs-primary-tag: rgba(255, 36, 66, 0.1);

  --xhs-bg: #FFFFFF;
  --xhs-bg-secondary: #F5F5F5;
  --xhs-surface: #FFFFFF;
  --xhs-surface-hover: #FAFAFA;

  --xhs-title: #1C1C1E;
  --xhs-body: #555555;
  --xhs-caption: #999999;
  --xhs-caption-light: #C7C7CC;
  --xhs-divider: rgba(0, 0, 0, 0.04);
  --xhs-divider-strong: rgba(0, 0, 0, 0.08);

  --xhs-profit: #FF6B6B;
  --xhs-profit-bg: rgba(255, 107, 107, 0.1);
  --xhs-loss: #34C759;
  --xhs-loss-bg: rgba(52, 199, 89, 0.1);
  --xhs-dividend: #FF9500;
  --xhs-dividend-bg: rgba(255, 149, 0, 0.1);

  --xhs-market-a: #007AFF;
  --xhs-market-a-bg: rgba(0, 122, 255, 0.08);
  --xhs-market-hk: #FF9500;
  --xhs-market-hk-bg: rgba(255, 149, 0, 0.08);
  --xhs-market-us: #AF52DE;
  --xhs-market-us-bg: rgba(175, 82, 222, 0.08);

  --xhs-card-shadow: 0 1px 4px rgba(0, 0, 0, 0.04), 0 2px 12px rgba(0, 0, 0, 0.06);
  --xhs-card-shadow-hover: 0 2px 8px rgba(0, 0, 0, 0.06), 0 4px 20px rgba(0, 0, 0, 0.08);
  --xhs-card-shadow-deep: 0 4px 12px rgba(0, 0, 0, 0.06), 0 8px 24px rgba(0, 0, 0, 0.08);
  --xhs-btn-shadow: 0 4px 12px rgba(255, 36, 66, 0.3);
  --xhs-btn-shadow-hover: 0 6px 20px rgba(255, 36, 66, 0.4);

  --xhs-radius-sm: 16rpx;
  --xhs-radius-md: 24rpx;
  --xhs-radius-lg: 32rpx;
  --xhs-radius-xl: 40rpx;
  --xhs-radius-pill: 999rpx;
  --xhs-radius-round: 50%;

  --xhs-space-xs: 8rpx;
  --xhs-space-sm: 16rpx;
  --xhs-space-md: 24rpx;
  --xhs-space-lg: 32rpx;
  --xhs-space-xl: 48rpx;
  --xhs-space-2xl: 64rpx;

  --xhs-font-xs: 20rpx;
  --xhs-font-sm: 22rpx;
  --xhs-font-md: 26rpx;
  --xhs-font-lg: 30rpx;
  --xhs-font-xl: 36rpx;
  --xhs-font-2xl: 44rpx;
  --xhs-font-3xl: 52rpx;
  --xhs-font-4xl: 64rpx;

  --xhs-weight-regular: 400;
  --xhs-weight-medium: 500;
  --xhs-weight-semibold: 600;
  --xhs-weight-bold: 700;

  --xhs-sans: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", "PingFang SC", sans-serif;

  --xhs-transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
  --xhs-transition-slow: all 300ms cubic-bezier(0.4, 0, 0.2, 1);

  background-color: var(--xhs-bg);
  font-family: var(--xhs-sans);
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-regular);
  color: var(--xhs-body);
  line-height: 1.6;
}

/* === Typography (XHS 风格) === */
.xhs-large-title {
  font-size: var(--xhs-font-4xl);
  font-weight: var(--xhs-weight-bold);
  color: var(--xhs-title);
  letter-spacing: -0.02em;
  line-height: 1.15;
}
.xhs-display {
  font-size: var(--xhs-font-3xl);
  font-weight: var(--xhs-weight-bold);
  color: var(--xhs-title);
  letter-spacing: -0.02em;
  line-height: 1.2;
}
.xhs-title {
  font-size: var(--xhs-font-xl);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
  letter-spacing: -0.01em;
}
.xhs-headline {
  font-size: var(--xhs-font-lg);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
}
.xhs-body {
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-regular);
  color: var(--xhs-body);
}
.xhs-footnote {
  font-size: var(--xhs-font-sm);
  font-weight: var(--xhs-weight-regular);
  color: var(--xhs-caption);
}
.xhs-caption {
  font-size: var(--xhs-font-xs);
  font-weight: var(--xhs-weight-medium);
  color: var(--xhs-caption);
  letter-spacing: 0.02em;
  text-transform: uppercase;
}

/* === Card (XHS 笔记卡片 — 纯白+中性灰阴影) === */
.xhs-card {
  background: var(--xhs-surface);
  border-radius: var(--xhs-radius-md);
  box-shadow: var(--xhs-card-shadow);
  padding: var(--_card-pad, var(--xhs-space-lg));
  position: relative;
  overflow: hidden;
  transition: var(--xhs-transition-slow);
}
.xhs-card:active {
  transform: scale(0.98);
  box-shadow: var(--xhs-card-shadow-hover);
}
.xhs-card-sm { --_card-pad: var(--xhs-space-md); }
.xhs-card-lg { --_card-pad: var(--xhs-space-xl); }

/* === CTA Button (XHS 纯红按钮) === */
.xhs-btn-primary {
  background: var(--xhs-primary);
  color: #FFFFFF;
  border-radius: var(--xhs-radius-pill);
  font-size: var(--xhs-font-lg);
  font-weight: var(--xhs-weight-semibold);
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  transition: var(--xhs-transition);
}
.xhs-btn-primary:active {
  opacity: 0.85;
}

/* === Ghost Button === */
.xhs-btn-ghost {
  background: transparent;
  border: 1px solid var(--xhs-divider-strong);
  border-radius: var(--xhs-radius-pill);
  color: var(--xhs-title);
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-medium);
  height: 80rpx;
  line-height: 78rpx;
  text-align: center;
  transition: var(--xhs-transition);
}
.xhs-btn-ghost:active {
  background: var(--xhs-hover, #F5F5F5);
}

/* === Text Button === */
.xhs-text-btn {
  color: var(--xhs-primary);
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-semibold);
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--xhs-transition);
}

/* === Tag / Badge (Pill Style) === */
.xhs-tag {
  display: inline-flex;
  align-items: center;
  padding: 2px 10px;
  border-radius: var(--xhs-radius-pill);
  font-size: var(--xhs-font-xs);
  font-weight: var(--xhs-weight-medium);
  letter-spacing: 0.01em;
  transition: var(--xhs-transition);
}

/* === Profit / Loss Colors === */
.xhs-profit { color: var(--xhs-profit) !important; }
.xhs-loss { color: var(--xhs-loss) !important; }

/* === Transaction Type Tags === */
.xhs-type-buy {
  background: var(--xhs-loss-bg);
  color: var(--xhs-loss);
}
.xhs-type-sell {
  background: var(--xhs-profit-bg);
  color: var(--xhs-profit);
}
.xhs-type-dividend {
  background: var(--xhs-dividend-bg);
  color: var(--xhs-dividend);
}

/* === Market Tags === */
.xhs-market-a {
  background: var(--xhs-market-a-bg);
  color: var(--xhs-market-a);
}
.xhs-market-hk {
  background: var(--xhs-market-hk-bg);
  color: var(--xhs-market-hk);
}
.xhs-market-us {
  background: var(--xhs-market-us-bg);
  color: var(--xhs-market-us);
}

/* === Divider === */
.xhs-divider {
  height: 1px;
  background: var(--xhs-divider);
  margin: var(--xhs-space-md) 0;
}
.xhs-divider-strong {
  height: 1px;
  background: var(--xhs-divider-strong);
  margin: var(--xhs-space-md) 0;
}

/* === Input (XHS 搜索框风格) === */
.xhs-input {
  background: var(--xhs-bg-secondary);
  border: 1px solid transparent;
  border-radius: var(--xhs-radius-pill);
  height: 80rpx;
  padding: 0 var(--xhs-space-md);
  font-size: var(--xhs-font-md);
  color: var(--xhs-title);
  transition: var(--xhs-transition);
}
.xhs-input:focus {
  border-color: var(--xhs-primary);
  background: var(--xhs-surface);
}

/* === Page Container === */
.xhs-page {
  min-height: 100vh;
  padding: var(--xhs-space-lg);
  padding-bottom: calc(80px + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* === Section Spacing === */
.xhs-section {
  margin-bottom: var(--xhs-space-lg);
}
.xhs-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--xhs-space-md);
}

/* === Chip / Filter Pill === */
.xhs-chip {
  display: inline-flex;
  align-items: center;
  padding: 6px 14px;
  border-radius: var(--xhs-radius-pill);
  background: var(--xhs-bg-secondary);
  font-size: var(--xhs-font-sm);
  color: var(--xhs-body);
  min-height: 32px;
  transition: var(--xhs-transition);
  border: 1px solid transparent;
}
.xhs-chip:active {
  transform: scale(0.95);
}
.xhs-chip-active {
  background: var(--xhs-primary-bg);
  color: var(--xhs-primary);
  border-color: var(--xhs-primary);
  font-weight: var(--xhs-weight-semibold);
}

/* === Empty State === */
.xhs-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 80rpx;
  text-align: center;
}
.xhs-empty-icon {
  font-size: 112rpx;
  margin-bottom: var(--xhs-space-lg);
  opacity: 0.8;
}
.xhs-empty-title {
  font-size: var(--xhs-font-xl);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
  margin-bottom: var(--xhs-space-sm);
}
.xhs-empty-desc {
  font-size: var(--xhs-font-md);
  color: var(--xhs-caption);
  line-height: 1.5;
}

/* === Slider Tab (分段选择器) === */
.xhs-slider {
  display: flex;
  background: var(--xhs-bg-secondary);
  border-radius: var(--xhs-radius-pill);
  padding: 3px;
  position: relative;
  margin-bottom: var(--xhs-space-lg);
}
.xhs-slider-bg {
  position: absolute;
  top: 3px;
  bottom: 3px;
  background: var(--xhs-surface);
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
  border-radius: var(--xhs-radius-pill);
  transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 1;
}
.xhs-slider-item {
  flex: 1;
  text-align: center;
  padding: 7px 0;
  font-size: var(--xhs-font-sm);
  font-weight: var(--xhs-weight-medium);
  color: var(--xhs-caption);
  position: relative;
  z-index: 2;
  transition: var(--xhs-transition);
}
.xhs-slider-item.active {
  color: var(--xhs-primary);
  font-weight: var(--xhs-weight-semibold);
}

/* === Scroll Container === */
.xhs-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

/* === FAB === */
.xhs-fab {
  position: fixed;
  right: var(--xhs-space-lg);
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: var(--xhs-radius-round);
  background: var(--xhs-primary);
  color: #FFFFFF;
  font-size: 52rpx;
  font-weight: var(--xhs-weight-bold);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--xhs-btn-shadow);
  z-index: 100;
  transition: var(--xhs-transition);
}
.xhs-fab:active {
  transform: scale(0.9);
  box-shadow: var(--xhs-btn-shadow-hover);
}
.xhs-fab-hidden {
  opacity: 0;
  pointer-events: none;
  transform: scale(0.8) rotate(90deg);
}

/* === Skeleton Screen === */
.xhs-skeleton {
  padding: var(--xhs-space-lg);
}
.xhs-skeleton-card {
  background: var(--xhs-surface);
  border-radius: var(--xhs-radius-md);
  box-shadow: var(--xhs-card-shadow);
  padding: var(--xhs-space-lg);
  margin-bottom: var(--xhs-space-md);
}
.xhs-skeleton-header {
  display: flex;
  align-items: center;
  gap: var(--xhs-space-sm);
  margin-bottom: var(--xhs-space-md);
}
.xhs-skeleton-tag {
  width: 96rpx;
  height: 48rpx;
  border-radius: var(--xhs-radius-pill);
  background: var(--xhs-divider);
}
.xhs-skeleton-text {
  height: 32rpx;
  border-radius: 8rpx;
  background: var(--xhs-divider);
}
.xhs-skeleton-body {
  display: flex;
  gap: var(--xhs-space-md);
}
.xhs-skeleton-item {
  flex: 1;
  height: 72rpx;
  border-radius: 8rpx;
  background: var(--xhs-divider);
}

/* === Shimmer Animation === */
.xhs-shimmer {
  background: linear-gradient(90deg, var(--xhs-divider) 25%, rgba(0,0,0,0.06) 50%, var(--xhs-divider) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* === Monospace Numbers === */
.xhs-mono {
  letter-spacing: 0.01em;
  font-weight: var(--xhs-weight-semibold);
}

/* === Dissolve Animation === */
@keyframes dissolve-out {
  0% { transform: scale(1); opacity: 1; }
  100% { transform: scale(0.85); opacity: 0; }
}
.dissolving {
  animation: dissolve-out 350ms ease-in forwards;
  pointer-events: none;
}
