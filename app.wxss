/* iOS 26.5 Frosted Glass Design System */

/* === Design Tokens === */
page {
  --color-bg: #F2F2F7;
  --color-surface: rgba(255, 255, 255, 0.65);
  --color-title: #1C1C1E;
  --color-body: #3C3C43;
  --color-caption: #8E8E93;
  --color-separator: rgba(60, 60, 67, 0.08);
  --color-accent: #FF3B30;
  --color-profit: #FF6B6B;
  --color-loss: #34C759;
  --color-market-a: #007AFF;
  --color-market-hk: #FF9500;
  --color-market-us: #AF52DE;

  --shadow-sm: 0 1px 3px rgba(0,0,0,0.04);
  --shadow-md: 0 2px 8px rgba(0,0,0,0.06);
  --shadow-lg: 0 8px 32px rgba(0,0,0,0.08);

  --radius-card: 14px;
  --radius-btn: 12px;
  --radius-tag: 8px;
  --radius-input: 10px;

  --space-page: 16px;
  --space-module: 12px;
  --space-card-pad: 16px;
  --space-item: 12px;
  --space-inner: 8px;

  --font-large-title: 34px;
  --font-display: 28px;
  --font-title: 20px;
  --font-headline: 17px;
  --font-body: 17px;
  --font-callout: 16px;
  --font-subhead: 15px;
  --font-footnote: 13px;
  --font-caption: 12px;

  --weight-display: 700;
  --weight-title: 600;
  --weight-body: 400;
  --weight-caption: 400;

  --transition-page: opacity 200ms ease-out, transform 200ms ease-out;

  /* === iOS 26.5 Glass Tokens === */
  --glass-bg: #FFFFFF;
  --glass-bg-hover: rgba(255, 255, 255, 0.95);
  --glass-border: rgba(0, 0, 0, 0.06);
  --glass-blur: blur(20px) saturate(1.8);
  --glass-shadow-out: 0 1px 3px rgba(0, 0, 0, 0.04), 0 4px 16px rgba(0, 0, 0, 0.06);
  --glass-shadow-in: inset 0 0.5px 0 rgba(255, 255, 255, 1);
  --glass-radius: 16px;

  background-color: var(--color-bg);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", sans-serif;
  font-size: var(--font-body);
  font-weight: var(--weight-body);
  color: var(--color-body);
  line-height: 1.6;
}

/* === Page Enter/Leave Transition === */
.page-enter {
  opacity: 0;
  transform: translateY(8px);
}
.page-enter-active {
  opacity: 1;
  transform: translateY(0);
  transition: var(--transition-page);
}

/* === Typography === */
.large-title {
  font-size: var(--font-large-title);
  font-weight: var(--weight-display);
  color: var(--color-title);
  letter-spacing: 0.01em;
  line-height: 1.15;
}
.display {
  font-size: var(--font-display);
  font-weight: var(--weight-display);
  color: var(--color-title);
  letter-spacing: 0.01em;
  line-height: 1.2;
}
.title {
  font-size: var(--font-title);
  font-weight: var(--weight-title);
  color: var(--color-title);
  letter-spacing: 0.01em;
}
.headline {
  font-size: var(--font-headline);
  font-weight: 600;
  color: var(--color-title);
}
.body {
  font-size: var(--font-body);
  font-weight: var(--weight-body);
  color: var(--color-body);
  letter-spacing: -0.01em;
}
.footnote {
  font-size: var(--font-footnote);
  font-weight: var(--weight-body);
  color: var(--color-caption);
}
.caption {
  font-size: var(--font-caption);
  font-weight: var(--weight-caption);
  color: var(--color-caption);
}

/* === Surface Card (iOS Frosted Glass) === */
.card {
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border-radius: var(--radius-card);
  border: 0.5px solid var(--glass-border);
  box-shadow: var(--glass-shadow-out), var(--glass-shadow-in);
  padding: var(--space-card-pad);
  position: relative;
  overflow: hidden;
}
.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.9), transparent);
  pointer-events: none;
}
.card-sm {
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border-radius: var(--radius-card);
  border: 0.5px solid var(--glass-border);
  box-shadow: var(--glass-shadow-out), var(--glass-shadow-in);
  padding: var(--space-card-pad);
  position: relative;
  overflow: hidden;
}
.card-sm::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.9), transparent);
  pointer-events: none;
}
.card-lg {
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border-radius: var(--radius-card);
  border: 0.5px solid var(--glass-border);
  box-shadow: var(--glass-shadow-out), var(--glass-shadow-in);
  padding: var(--space-card-pad);
  position: relative;
  overflow: hidden;
}
.card-lg::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.9), transparent);
  pointer-events: none;
}

/* === CTA Button (Frosted Glass) === */
.cta-btn {
  background: linear-gradient(135deg, rgba(255, 59, 48, 0.92), rgba(255, 59, 48, 0.98));
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: 0 4px 16px rgba(255, 59, 48, 0.3), inset 0 0.5px 0 rgba(255, 255, 255, 0.3);
  color: #FFFFFF;
  border-radius: var(--radius-btn);
  font-size: var(--font-body);
  font-weight: var(--weight-title);
  height: 44px;
  line-height: 44px;
  text-align: center;
  transition: opacity 100ms;
}

/* === Text Button === */
.text-btn {
  color: var(--color-accent);
  font-size: var(--font-body);
  font-weight: var(--weight-title);
  padding: 8px 0;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 100ms;
}

/* === Tag Badge (Frosted Glass) === */
.tag {
  display: inline-block;
  padding: 3px 10px;
  border-radius: var(--radius-tag);
  font-size: var(--font-caption);
  font-weight: 500;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

/* === Profit / Loss Colors === */
.profit { color: var(--color-profit) !important; }
.loss { color: var(--color-loss) !important; }

/* === Transaction Type Tags (Frosted Glass) === */
.type-tag { margin-left: auto; }
.tag-buy { background: rgba(52, 199, 89, 0.12); color: #34C759; border: 0.5px solid rgba(52, 199, 89, 0.2); }
.tag-sell { background: rgba(255, 59, 48, 0.1); color: #FF3B30; border: 0.5px solid rgba(255, 59, 48, 0.18); }
.tag-dividend { background: rgba(255, 149, 0, 0.1); color: #FF9500; border: 0.5px solid rgba(255, 149, 0, 0.18); }

/* === Market Colors (Frosted Glass) === */
.market-a { background: rgba(0, 122, 255, 0.12); color: #007AFF; border: 0.5px solid rgba(0, 122, 255, 0.2); }
.market-hk { background: rgba(255, 149, 0, 0.12); color: #FF9500; border: 0.5px solid rgba(255, 149, 0, 0.2); }
.market-us { background: rgba(175, 82, 222, 0.12); color: #AF52DE; border: 0.5px solid rgba(175, 82, 222, 0.2); }

/* === Divider === */
.divider {
  height: 0.5px;
  background: rgba(60, 60, 67, 0.08);
  margin: var(--space-module) 0;
}

/* === Input (Frosted Glass) === */
.input {
  background: rgba(0, 0, 0, 0.04);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 0.5px solid rgba(0, 0, 0, 0.06);
  border-radius: var(--radius-input);
  height: 44px;
  padding: 0 12px;
  font-size: var(--font-body);
  color: var(--color-title);
  transition: opacity 100ms;
}

/* === Page Container === */
.page-container {
  min-height: 100vh;
  padding: var(--space-page);
  padding-bottom: calc(80px + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* === Section Spacing === */
.section {
  margin-bottom: var(--space-module);
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

/* === Chip / Pill (Frosted Glass) === */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 6px 14px;
  border-radius: 20px;
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 0.5px solid var(--glass-border);
  font-size: var(--font-caption);
  color: var(--color-body);
  min-height: 32px;
  transition: opacity 100ms;
}
.chip-active {
  background: rgba(255, 59, 48, 0.15);
  color: #FF3B30;
  border-color: rgba(255, 59, 48, 0.25);
}

/* === Empty State === */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 40px;
}
.empty-title {
  font-size: var(--font-title);
  font-weight: var(--weight-title);
  color: var(--color-title);
  margin-top: 16px;
}
.empty-desc {
  font-size: var(--font-body);
  color: var(--color-caption);
  margin-top: 8px;
}

/* === Header Bar (Frosted Glass) === */
.nav-bar {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(242, 242, 247, 0.6);
  backdrop-filter: saturate(180%) blur(40px);
  -webkit-backdrop-filter: saturate(180%) blur(40px);
  padding-top: 0;
  padding-bottom: 8px;
  border-bottom: 0.5px solid rgba(255, 255, 255, 0.5);
}
.nav-header {
  display: flex;
  align-items: flex-end;
  padding: 0 var(--space-page);
  height: 100%;
}
.nav-header-title {
  font-size: var(--font-large-title);
  font-weight: var(--weight-display);
  color: var(--color-title);
  letter-spacing: 0.01em;
  line-height: 1.15;
  padding-bottom: 4px;
}

/* === Liquid Slider (Frosted Glass) === */
.liquid-slider {
  display: flex;
  background: rgba(0, 0, 0, 0.04);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 0.5px solid rgba(0, 0, 0, 0.06);
  border-radius: 12px;
  padding: 3px;
  position: relative;
  margin-bottom: var(--space-module);
}
.liquid-slider-bg {
  position: absolute;
  height: calc(100% - 6px);
  background: var(--glass-bg);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 0.5px solid var(--glass-border);
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
  border-radius: 10px;
  transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
}
.liquid-slider-item {
  flex: 1;
  text-align: center;
  padding: 8px 0;
  border-radius: 10px;
  font-size: var(--font-caption);
  color: var(--color-caption);
  position: relative;
  z-index: 1;
  transition: color 300ms;
}
.liquid-slider-item.active {
  color: var(--color-accent);
  font-weight: var(--weight-title);
}

/* === Scroll Container === */
.scroll-container {
  flex: 1;
  height: 0;
  min-height: 0;
}

/* === Liquid Dissolve Animation === */
@keyframes dissolve-out {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  100% {
    transform: scale(0.8);
    opacity: 0;
  }
}
.dissolving {
  animation: dissolve-out 400ms ease-in forwards;
  pointer-events: none;
}

/* === Visual Feedback === */
.parallax-container {
  /* container */
}
.parallax-card {
  transition: transform 100ms ease-out, box-shadow 100ms ease-out;
}
.parallax-near {
  transform: scale(1.02);
}
.parallax-mid {
  transform: scale(1);
}
.parallax-far {
  transform: scale(0.98);
}

/* === Skeleton Screen === */
.skeleton-container {
  padding: var(--space-page);
}

.skeleton-card {
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 0.5px solid var(--glass-border);
  border-radius: var(--radius-card);
  padding: var(--space-card-pad);
  margin-bottom: var(--space-module);
}

.skeleton-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 12px;
}

.skeleton-tag {
  width: 48px;
  height: 24px;
  border-radius: var(--radius-tag);
  background: rgba(0, 0, 0, 0.06);
}

.skeleton-text {
  height: 20px;
  border-radius: 4px;
  background: rgba(0, 0, 0, 0.06);
}

.skeleton-header .skeleton-text:first-child {
  width: 80px;
}

.skeleton-header .skeleton-text:last-child {
  width: 100px;
}

.skeleton-body {
  display: flex;
  gap: 12px;
}
.skeleton-body .skeleton-item {
  flex: 1;
}

.skeleton-item {
  height: 40px;
  border-radius: 8px;
  background: rgba(0, 0, 0, 0.06);
}

/* === Shimmer Animation === */
.shimmer {
  background: linear-gradient(90deg, rgba(0,0,0,0.04) 25%, rgba(0,0,0,0.08) 50%, rgba(0,0,0,0.04) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
