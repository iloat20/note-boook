/* ═════════════════════════════════════════╗
   小红书风格 - 年度投资报告
   ╚════════════════════════════════════════╝ */

/* === Overlay === */
.ar-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--xhs-bg);
  z-index: 9999;
  isolation: isolate;
  animation: arFadeIn 0.3s ease;
}

.ar-close {
  position: fixed;
  top: 48px;
  left: 20px;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--xhs-bg-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  color: var(--xhs-caption);
  z-index: 2010;
  transition: var(--xhs-transition);
}

.ar-close:active {
  transform: scale(0.9);
  background: var(--xhs-divider-strong);
}

.ar-scroll {
  width: 100%;
  height: 100%;
  background: var(--xhs-bg);
}

/* === Hero === */
.ar-hero {
  padding: 80px 32px 48px;
  text-align: center;
  background: linear-gradient(180deg, var(--xhs-primary-bg) 0%, transparent 100%);
}

.ar-year {
  font-size: 72px;
  font-weight: 800;
  color: var(--xhs-divider-strong);
  display: block;
  line-height: 1;
  letter-spacing: -4px;
}

.ar-title {
  font-size: 15px;
  color: var(--xhs-caption);
  display: block;
  margin-top: -12px;
  margin-bottom: 24px;
  letter-spacing: 4px;
}

.ar-hero-pnl {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 8px;
}

.ar-hero-sign {
  font-size: 28px;
  font-weight: 700;
  color: var(--xhs-profit);
  margin-right: 4px;
}

.ar-hero-value {
  font-size: 48px;
  font-weight: 800;
  color: var(--xhs-title);
  letter-spacing: -2px;
}

.ar-hero-pct {
  font-size: 16px;
  color: var(--xhs-caption);
}

/* === Sections === */
.ar-section {
  padding: 0 24px;
  margin-bottom: 36px;
}

.ar-section-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--xhs-caption);
  text-transform: uppercase;
  letter-spacing: 2px;
  display: block;
  margin-bottom: 16px;
}

/* === Grid === */
.ar-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.ar-grid-item {
  box-sizing: border-box;
  width: calc(50% - 6px);
  background: var(--xhs-surface);
  border: 1px solid var(--xhs-divider);
  border-radius: var(--xhs-radius-md);
  padding: 16px;
  text-align: center;
  box-shadow: var(--xhs-card-shadow);
}

.ar-grid-value {
  font-size: 28px;
  font-weight: 700;
  color: var(--xhs-title);
  display: block;
  margin-bottom: 4px;
}

.ar-grid-label {
  font-size: 12px;
  color: var(--xhs-caption);
}

/* === Flow === */
.ar-flow {
  display: flex;
  align-items: center;
  background: var(--xhs-surface);
  border: 1px solid var(--xhs-divider);
  border-radius: var(--xhs-radius-md);
  padding: 16px 0;
  box-shadow: var(--xhs-card-shadow);
}

.ar-flow-item {
  flex: 1;
  text-align: center;
}

.ar-flow-label {
  font-size: 11px;
  color: var(--xhs-caption);
  display: block;
  margin-bottom: 6px;
}

.ar-flow-value {
  font-size: 16px;
  font-weight: 700;
  color: var(--xhs-title);
}

.ar-flow-divider {
  width: 1px;
  height: 32px;
  background: var(--xhs-divider-strong);
}

/* === Chart === */
.ar-chart-box {
  background: var(--xhs-surface);
  border: 1px solid var(--xhs-divider);
  border-radius: var(--xhs-radius-md);
  padding: 16px;
  height: 180px;
  box-shadow: var(--xhs-card-shadow);
}

.ar-monthly-canvas {
  width: 100%;
  height: 100%;
}

.ar-chart-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ar-chart-empty-text {
  font-size: 13px;
  color: var(--xhs-caption-light);
}

/* === Rank === */
.ar-rank-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid var(--xhs-divider);
}

.ar-rank-item:last-child {
  border-bottom: none;
}

.ar-rank-badge {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}

.ar-rank-0 {
  background: linear-gradient(135deg, #FFD700, #FFA500);
}

.ar-rank-1 {
  background: linear-gradient(135deg, #C0C0C0, #A0A0A0);
}

.ar-rank-2 {
  background: linear-gradient(135deg, #CD7F32, #B8860B);
}

.ar-rank-other {
  background: var(--xhs-divider-strong);
  color: var(--xhs-caption);
}

.ar-rank-info {
  flex: 1;
  min-width: 0;
}

.ar-rank-name {
  font-size: 15px;
  font-weight: 600;
  color: var(--xhs-title);
  display: block;
}

.ar-rank-code {
  font-size: 12px;
  color: var(--xhs-caption-light);
}

.ar-rank-pnl {
  font-size: 16px;
  font-weight: 700;
  flex-shrink: 0;
}

.ar-profit {
  color: var(--xhs-profit);
}

.ar-loss {
  color: var(--xhs-loss);
}

/* === Strategy === */
.ar-strategy-item {
  margin-bottom: 14px;
}

.ar-strategy-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
}

.ar-strategy-tag {
  font-size: 14px;
  font-weight: 500;
  color: var(--xhs-title);
}

.ar-strategy-count {
  font-size: 12px;
  color: var(--xhs-caption);
}

.ar-strategy-bar-bg {
  height: 6px;
  border-radius: 3px;
  background: var(--xhs-divider);
  overflow: hidden;
}

.ar-strategy-bar {
  height: 100%;
  border-radius: 3px;
  background: linear-gradient(90deg, var(--xhs-primary-light), var(--xhs-primary));
  transition: width 0.6s ease;
}

/* === Footer === */
.ar-footer {
  text-align: center;
  padding: 32px 24px 16px;
}

.ar-footer-text {
  font-size: 12px;
  color: var(--xhs-caption-light);
}

@keyframes arFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* === Export Button === */
.ar-export-btn {
  position: fixed;
  bottom: 120px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--xhs-primary);
  color: #fff;
  font-size: 15px;
  font-weight: 600;
  padding: 14px 48px;
  border-radius: 28px;
  display: flex;
  align-items: center;
  gap: 8px;
  box-shadow: var(--xhs-btn-shadow);
  z-index: 2010;
}

.ar-exporting {
  opacity: 0.6;
}

.ar-export-icon {
  font-size: 18px;
}

.ar-export-text {
  font-size: 15px;
}

/* === Export Canvas (hidden) === */
.ar-export-canvas {
  position: fixed;
  left: 0;
  top: 0;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
  z-index: -1;
}
