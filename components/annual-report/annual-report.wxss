.ar-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  background-color: var(--xhs-bg);
  z-index: 9999;
}

/* === 固定毛玻璃顶栏（滚动内容被遮住，不穿帮） === */
.ar-top-bar {
  flex-shrink: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 16px;
  background: rgba(250, 250, 252, 0.82);
  -webkit-backdrop-filter: blur(20rpx) saturate(160%);
  backdrop-filter: blur(20rpx) saturate(160%);
  border-bottom: 1rpx solid var(--xhs-divider);
}

.ar-close {
  width: 36px;
  height: 36px;
  background-color: var(--xhs-surface);
  border: 1px solid var(--xhs-divider);
  box-shadow: var(--xhs-elevation-2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--xhs-title);
  font-size: 20px;
}

/* === 滚动区：flex 稳定布局（stats 页同款） === */
.ar-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  background-color: var(--xhs-bg);
}

/* === 统一白卡 === */
.ar-card {
  background-color: var(--xhs-surface);
  border: 1px solid var(--xhs-divider);
  border-radius: var(--xhs-radius-lg);
  box-shadow: var(--xhs-elevation-2);
  margin: 24rpx 20rpx;
  padding: 32rpx 28rpx;
}

/* === Hero 品牌渐变头（仅年份标题） === */
.ar-hero {
  background: linear-gradient(135deg, #FF3B30 0%, #FF6B61 100%);
  color: #ffffff;
  padding: 48rpx 32rpx 52rpx;
  text-align: center;
}

.ar-hero-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 0.04em;
  margin-bottom: 12rpx;
}

.ar-hero-year {
  display: block;
  font-size: 72rpx;
  font-weight: var(--xhs-weight-bold);
  color: #ffffff;
  letter-spacing: 0.02em;
  line-height: 1.1;
}

/* === 区块标题 === */
.ar-section-title {
  font-size: 30rpx;
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
  margin-bottom: 24rpx;
  display: block;
}

/* === 流入/流出对比条 === */
.ar-bar-wrap {
  margin-bottom: 32rpx;
}

.ar-bar-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.ar-bar-row:last-child {
  margin-bottom: 0;
}

.ar-bar-label {
  width: 56rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--xhs-caption);
}

.ar-bar-track {
  flex: 1;
  height: 18rpx;
  background-color: var(--xhs-bg-secondary);
  border-radius: var(--xhs-radius-pill);
  overflow: hidden;
}

.ar-bar-fill {
  height: 100%;
  border-radius: var(--xhs-radius-pill);
  transition: width 400ms cubic-bezier(0.4, 0, 0.2, 1);
}

.ar-bar-in {
  background: linear-gradient(90deg, #FF6B61, #FF3B30);
}

.ar-bar-out {
  background-color: var(--xhs-bg-tertiary);
}

.ar-bar-amount {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
}

.ar-bar-amount-in {
  color: var(--xhs-primary);
}

/* === 2×2 四宫格 === */
.ar-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.ar-grid-item {
  flex: 0 0 calc(50% - 8rpx);
  background: var(--xhs-bg-secondary);
  border-radius: var(--xhs-radius-md);
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.ar-grid-accent {
  background: var(--xhs-primary-bg);
}

.ar-grid-accent-profit {
  background: var(--xhs-profit-bg);
}

.ar-grid-accent-loss {
  background: var(--xhs-loss-bg);
}

.ar-grid-value {
  font-size: 36rpx;
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
}

.ar-grid-label {
  font-size: 24rpx;
  color: var(--xhs-caption);
}

/* === 净变化正负语义色 === */
.ar-profit {
  color: var(--xhs-profit);
}

.ar-loss {
  color: var(--xhs-loss);
}

/* === 资产持有画像 === */
.ar-portrait {
  display: flex;
  gap: 14rpx;
}

.ar-portrait-item {
  flex: 1;
  background: var(--xhs-bg-secondary);
  border-radius: var(--xhs-radius-md);
  padding: 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.ar-portrait-name {
  font-size: 24rpx;
  color: var(--xhs-title);
  max-width: 100%;
  min-width: 0;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.ar-portrait-value {
  font-size: 32rpx;
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-primary);
}

.ar-portrait-label {
  font-size: 22rpx;
  color: var(--xhs-caption);
}

/* === 页脚 === */
.ar-footer {
  text-align: center;
  padding: 24rpx 20rpx 8rpx;
}

.ar-footer-text {
  color: var(--xhs-caption-light);
  font-size: 22rpx;
}

/* === 顶部分享按钮（浅色 pill） === */
.ar-share-btn {
  background: var(--xhs-glass-bg);
  border: 1px solid var(--xhs-glass-border);
  box-shadow: var(--xhs-elevation-2);
  color: var(--xhs-title);
  padding: 6px 18px;
  border-radius: var(--xhs-radius-pill);
  display: flex;
  align-items: center;
}

.ar-share-text {
  font-size: 14px;
  font-weight: 500;
}

.ar-exporting {
  opacity: 0.6;
}

/* === 离屏 canvas === */
.ar-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 750px;
  height: 1600px;
}
