.ar-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 9999;
}

.ar-scroll {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #1a1a1a;
  padding-bottom: 40px;
}

.ar-scroll-spacer {
  width: 100%;
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a5a 100%);
}

.ar-top-bar {
  position: fixed;
  left: 0;
  right: 0;
  padding: 12px 16px 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 100;
}

.ar-close {
  width: 36px;
  height: 36px;
  background-color: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 20px;
}

.ar-hero {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a5a 100%);
  padding: 24px 20px 40px;
  text-align: center;
  color: #fff;
}

.ar-year {
  font-size: 48px;
  font-weight: bold;
  opacity: 0.3;
  margin-bottom: 8px;
  display: block;
}

.ar-title {
  font-size: 16px;
  opacity: 0.9;
  display: block;
}

.ar-hero-pnl {
  margin: 24px 0 8px;
}

.ar-hero-sign {
  font-size: 32px;
  font-weight: bold;
}

.ar-hero-value {
  font-size: 48px;
  font-weight: bold;
}

.ar-section {
  padding: 16px 20px;
  background: #fff;
  margin-bottom: 10px;
}

.ar-section-title {
  font-size: 14px;
  color: #999;
  margin-bottom: 12px;
  display: block;
}

.ar-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.ar-grid-item {
  flex: 0 0 calc(50% - 8rpx);
  background: var(--xhs-surface);
  border-radius: var(--xhs-radius-lg);
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ar-grid-value {
  font-size: 36rpx;
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
}

.ar-grid-label {
  font-size: 24rpx;
  color: var(--xhs-caption);
}

.ar-profit {
  color: #ff6b6b;
}

.ar-loss {
  color: #34c759;
}

.ar-footer {
  text-align: center;
  padding: 20px;
}

.ar-footer-text {
  color: #c7c7cc;
  font-size: 12px;
}

.ar-export-btn {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  color: #333;
  padding: 6px 14px;
  border-radius: 18px;
  display: flex;
  align-items: center;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.ar-export-icon {
  margin-right: 6px;
  font-size: 16px;
}

.ar-export-text {
  font-size: 14px;
  font-weight: 500;
}

.ar-exporting {
  opacity: 0.6;
}

.ar-portrait {
  display: flex;
  gap: 12rpx;
}

.ar-portrait-item {
  flex: 1;
  background: var(--xhs-surface);
  border-radius: var(--xhs-radius-lg);
  padding: 20rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.ar-portrait-name {
  font-size: 24rpx;
  color: var(--xhs-title);
  max-width: 100%;
  min-width: 0;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ar-portrait-value {
  font-size: 30rpx;
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-primary);
}

.ar-portrait-label {
  font-size: 22rpx;
  color: var(--xhs-caption);
}

.ar-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 750px;
  height: 1600px;
}

.ar-hero-conclusion {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--xhs-caption);
}
