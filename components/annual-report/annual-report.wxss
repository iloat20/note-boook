.ar-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(20, 20, 22, 0.38);
  z-index: 9999;
}

.ar-scroll {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--xhs-bg);
  padding-bottom: 40px;
}

.ar-scroll-spacer {
  width: 100%;
  background: transparent;
}

.ar-top-bar {
  position: fixed;
  left: 0;
  right: 0;
  padding: 12px 16px 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 100;
}

.ar-close {
  width: 36px;
  height: 36px;
  background-color: var(--xhs-surface);
  border: 1px solid var(--xhs-divider);
  box-shadow: var(--xhs-elevation-2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--xhs-title);
  font-size: 20px;
}

/* === 统一白卡 === */
.ar-card {
  background-color: var(--xhs-surface);
  border: 1px solid var(--xhs-divider);
  border-radius: var(--xhs-radius-md);
  box-shadow: var(--xhs-elevation-2);
  margin: 16rpx 20rpx;
  padding: 32rpx 24rpx;
}

/* === Hero 白底巨号年份 === */
.ar-hero {
  text-align: center;
}

.ar-year {
  font-size: 44rpx;
  font-weight: var(--xhs-weight-bold);
  color: var(--xhs-title);
  letter-spacing: 0.04em;
  display: block;
  margin-bottom: 8rpx;
}

.ar-title {
  font-size: 26rpx;
  color: var(--xhs-caption);
  display: block;
}

.ar-hero-pnl {
  margin: 28rpx 0 12rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.ar-hero-sign {
  font-size: 40rpx;
  font-weight: var(--xhs-weight-bold);
}

.ar-hero-value {
  font-size: 72rpx;
  font-weight: var(--xhs-weight-bold);
  line-height: 1;
  letter-spacing: -0.01em;
}

.ar-hero-conclusion {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--xhs-caption);
  display: block;
}

/* === 区块标题 === */
.ar-section-title {
  font-size: 28rpx;
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
  margin-bottom: 20rpx;
  display: block;
}

/* === 流入/流出对比条 === */
.ar-bar-wrap {
  margin-bottom: 28rpx;
}

.ar-bar-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.ar-bar-row:last-child {
  margin-bottom: 0;
}

.ar-bar-label {
  width: 56rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--xhs-caption);
}

.ar-bar-track {
  flex: 1;
  height: 16rpx;
  background-color: var(--xhs-bg-secondary);
  border-radius: var(--xhs-radius-pill);
  overflow: hidden;
}

.ar-bar-fill {
  height: 100%;
  border-radius: var(--xhs-radius-pill);
  transition: width 400ms cubic-bezier(0.4, 0, 0.2, 1);
}

.ar-bar-in {
  background-color: var(--xhs-secondary);
}

.ar-bar-out {
  background-color: var(--xhs-bg-tertiary);
}

.ar-bar-amount {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
}

.ar-bar-amount-in {
  color: var(--xhs-secondary);
}

/* === 2×2 四宫格 === */
.ar-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.ar-grid-item {
  flex: 0 0 calc(50% - 8rpx);
  background: var(--xhs-bg-secondary);
  border-radius: var(--xhs-radius-sm);
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ar-grid-value {
  font-size: 34rpx;
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
}

.ar-grid-label {
  font-size: 24rpx;
  color: var(--xhs-caption);
}

/* === 净变化正负语义色 === */
.ar-profit {
  color: var(--xhs-profit);
}

.ar-loss {
  color: var(--xhs-loss);
}

/* === 资产持有画像 === */
.ar-portrait {
  display: flex;
  gap: 12rpx;
}

.ar-portrait-item {
  flex: 1;
  background: var(--xhs-bg-secondary);
  border-radius: var(--xhs-radius-sm);
  padding: 20rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.ar-portrait-name {
  font-size: 24rpx;
  color: var(--xhs-title);
  max-width: 100%;
  min-width: 0;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.ar-portrait-value {
  font-size: 30rpx;
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-secondary);
}

.ar-portrait-label {
  font-size: 22rpx;
  color: var(--xhs-caption);
}

/* === 页脚 === */
.ar-footer {
  text-align: center;
  padding: 20px;
}

.ar-footer-text {
  color: var(--xhs-caption-light);
  font-size: 12px;
}

/* === 顶部导出按钮（浅色 pill） === */
.ar-export-btn {
  background: var(--xhs-glass-bg);
  border: 1px solid var(--xhs-glass-border);
  box-shadow: var(--xhs-elevation-2);
  color: var(--xhs-title);
  padding: 6px 14px;
  border-radius: var(--xhs-radius-pill);
  display: flex;
  align-items: center;
}

.ar-export-icon {
  margin-right: 6px;
  font-size: 16px;
}

.ar-export-text {
  font-size: 14px;
  font-weight: 500;
}

.ar-exporting {
  opacity: 0.6;
}

/* === 离屏 canvas === */
.ar-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 750px;
  height: 1600px;
}
