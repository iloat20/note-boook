.ar-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 9999;
}

.ar-scroll {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #f5f5f5;
  padding-bottom: 40px;
}

.ar-top-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding: calc(12px + env(safe-area-inset-top, 20px)) 16px 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 100;
}

.ar-close {
  width: 36px;
  height: 36px;
  background-color: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 20px;
}

.ar-hero {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a5a 100%);
  padding: calc(60px + env(safe-area-inset-top, 20px)) 20px 40px;
  text-align: center;
  color: #fff;
}

.ar-year {
  font-size: 48px;
  font-weight: bold;
  opacity: 0.3;
  margin-bottom: 8px;
  display: block;
}

.ar-title {
  font-size: 16px;
  opacity: 0.9;
  display: block;
}

.ar-hero-pnl {
  margin: 24px 0 8px;
}

.ar-hero-sign {
  font-size: 32px;
  font-weight: bold;
}

.ar-hero-value {
  font-size: 48px;
  font-weight: bold;
}

.ar-hero-pct {
  font-size: 18px;
  opacity: 0.9;
}

.ar-section {
  padding: 16px 20px;
  background: #fff;
  margin-bottom: 10px;
}

.ar-section-title {
  font-size: 14px;
  color: #999;
  margin-bottom: 12px;
  display: block;
}

.ar-grid {
  display: flex;
  justify-content: space-between;
}

.ar-grid-item {
  flex: 1;
  text-align: center;
  padding: 12px 8px;
}

.ar-grid-value {
  font-size: 24px;
  font-weight: bold;
  color: #1c1c1e;
  display: block;
}

.ar-grid-label {
  font-size: 12px;
  color: #999;
  margin-top: 4px;
  display: block;
}

.ar-flow {
  display: flex;
  background-color: #f5f5f5;
  border-radius: 12px;
  padding: 16px 0;
}

.ar-flow-item {
  flex: 1;
  text-align: center;
}

.ar-flow-label {
  font-size: 12px;
  color: #999;
  display: block;
  margin-bottom: 4px;
}

.ar-flow-value {
  font-size: 16px;
  font-weight: bold;
  color: #1c1c1e;
  display: block;
}

.ar-flow-divider {
  width: 1px;
  background-color: rgba(0, 0, 0, 0.08);
}

.ar-chart-box {
  width: 100%;
  height: auto;
  position: relative;
  background-color: #fff;
  border-radius: 8px;
  padding: 16px;
}

.ar-chart-css {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.ar-chart-css-row {
  display: flex;
  align-items: center;
  gap: 12px;
}

.ar-chart-css-label {
  width: 40px;
  font-size: 13px;
  color: #666;
  text-align: left;
}

.ar-chart-css-bar-wrap {
  flex: 1;
  height: 24px;
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 4px;
  overflow: hidden;
}

.ar-chart-css-bar {
  height: 100%;
  border-radius: 4px;
  min-width: 4px;
}

.ar-chart-css-profit {
  background-color: #FF6B6B;
}

.ar-chart-css-loss {
  background-color: #34C759;
}

.ar-chart-css-value {
  width: 80px;
  font-size: 12px;
  text-align: right;
  font-weight: 500;
}

.ar-chart-empty {
  padding: 40px 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 14px;
}

.ar-rank-item {
  display: flex;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #f5f5f5;
}

.ar-rank-item:last-child {
  border-bottom: none;
}

.ar-rank-badge {
  width: 28px;
  height: 28px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: bold;
  color: #fff;
  margin-right: 12px;
}

.ar-rank-0 { background-color: #ffd700; }
.ar-rank-1 { background-color: #c0c0c0; }
.ar-rank-2 { background-color: #cd7f32; }
.ar-rank-other { background-color: rgba(0, 0, 0, 0.08); color: #666; }

.ar-rank-info {
  flex: 1;
}

.ar-rank-name {
  font-size: 15px;
  color: #1c1c1e;
  display: block;
}

.ar-rank-code {
  font-size: 12px;
  color: #999;
  display: block;
  margin-top: 2px;
}

.ar-rank-pnl {
  font-size: 16px;
  font-weight: bold;
}

.ar-profit {
  color: #ff6b6b;
}

.ar-loss {
  color: #34c759;
}

.ar-strategy-item {
  margin-bottom: 16px;
}

.ar-strategy-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.ar-strategy-tag {
  font-size: 14px;
  color: #1c1c1e;
}

.ar-strategy-count {
  font-size: 12px;
  color: #999;
}

.ar-strategy-bar-bg {
  height: 6px;
  background-color: rgba(0, 0, 0, 0.04);
  border-radius: 3px;
  overflow: hidden;
}

.ar-strategy-bar {
  height: 100%;
  background: linear-gradient(90deg, #ff6b6b, #ee5a5a);
  border-radius: 3px;
}

.ar-footer {
  text-align: center;
  padding: 20px;
}

.ar-footer-text {
  color: #c7c7cc;
  font-size: 12px;
}

.ar-export-btn {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  color: #333;
  padding: 6px 14px;
  border-radius: 18px;
  display: flex;
  align-items: center;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.ar-export-icon {
  margin-right: 6px;
  font-size: 16px;
}

.ar-export-text {
  font-size: 14px;
  font-weight: 500;
}

.ar-exporting {
  opacity: 0.6;
}
