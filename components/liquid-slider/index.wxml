<view class="xhs-slider" style="position: relative;">
  <view wx:for="{{tabs}}" wx:key="key"
        class="xhs-slider-item {{currentKey === item.key ? 'active' : ''}}"
        bindtap="onTap"
        data-key="{{item.key}}">
    <view class="xhs-slider-label">
      {{item.label}}
      <text wx:if="{{showCount && item.count !== undefined}}"> ({{item.count}})</text>
    </view>
  </view>
</view>
