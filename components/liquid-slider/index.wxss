.liquid-slider {
  display: flex;
  background: var(--xhs-bg-secondary);
  border-radius: var(--xhs-radius-pill);
  padding: 3px;
  position: relative;
}

.liquid-slider-bg {
  position: absolute;
  top: 3px;
  bottom: 3px;
  background: var(--xhs-surface);
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
  border-radius: var(--xhs-radius-pill);
  transition: left 300ms cubic-bezier(0.4, 0, 0.2, 1), width 300ms cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 1;
}

.liquid-slider-item {
  flex: 1;
  text-align: center;
  padding: 7px 0;
  font-size: var(--xhs-font-sm);
  font-weight: var(--xhs-weight-medium);
  color: var(--xhs-caption);
  position: relative;
  z-index: 2;
  transition: color 200ms cubic-bezier(0.4, 0, 0.2, 1);
}

.liquid-slider-item.active {
  color: var(--xhs-primary);
  font-weight: var(--xhs-weight-semibold);
}
