.strategy-tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  margin-top: 6px;
}

.strategy-tag {
  display: inline-flex;
  align-items: center;
  padding: 2px 10px;
  border-radius: var(--xhs-radius-pill);
  background: var(--xhs-primary-bg-2, rgba(255, 59, 48, 0.12));
  color: var(--xhs-primary);
  font-size: var(--xhs-font-xs);
  font-weight: var(--xhs-weight-medium);
  line-height: 1.4;
}

.strategy-tag-mini {
  display: inline-flex;
  align-items: center;
  padding: 1px 6px;
  border-radius: var(--xhs-radius-pill);
  background: var(--xhs-primary-bg-2, rgba(255, 59, 48, 0.12));
  color: var(--xhs-primary);
  font-size: 18rpx;
  font-weight: var(--xhs-weight-medium);
  line-height: 1.3;
}
