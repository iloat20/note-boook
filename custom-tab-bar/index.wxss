/* ═════════════════════════════════════════╗
   高级底部导航栏动画 (Premium Tab Bar)
   ╚════════════════════════════════════════╝ */

.tab-bar {
  display: flex;
  flex-direction: row;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 62rpx;
  background: rgba(255, 255, 255, 0.95);
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 0;
}

.tab-icon {
  display: none;
}

.tab-text {
  font-size: 26rpx;
  color: var(--xhs-caption-light, #C7C7CC);
  line-height: 1;
  letter-spacing: 0.01em;
  transition: color 350ms cubic-bezier(0.4, 0, 0.2, 1), opacity 350ms cubic-bezier(0.4, 0, 0.2, 1);
  opacity: 0.7;
}

/* Active state */
.tab-item.active .tab-text {
  color: var(--xhs-title, #1C1C1E);
  font-weight: var(--xhs-weight-semibold, 600);
  opacity: 1;
}

/* Active indicator - 文字下方红线 */
.tab-item::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%) scaleX(0);
  width: 48rpx;
  height: 3rpx;
  background: var(--xhs-primary, #FF3B30);
  border-radius: 1.5rpx;
  transition: transform 350ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tab-item.active::after {
  transform: translateX(-50%) scaleX(1);
}

.tab-item:active {
  opacity: 0.6;
}
