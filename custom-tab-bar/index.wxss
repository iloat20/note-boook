/* ═════════════════════════════════════════╗
   小红书风格底部导航栏 (XHS Tab Bar)
   ╚════════════════════════════════════════╝ */

.tab-bar {
  display: flex;
  flex-direction: row;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 104rpx;
  background: var(--xhs-surface, #FFFFFF);
  border-top: 1rpx solid var(--xhs-divider, rgba(0, 0, 0, 0.04));
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--xhs-space-sm, 16rpx) 0 var(--xhs-space-xs, 8rpx);
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: var(--xhs-space-xxs, 4rpx);
  transition: var(--xhs-transition, all 200ms cubic-bezier(0.4, 0, 0.2, 1));
}

.tab-text {
  font-size: var(--xhs-font-xs, 20rpx);
  color: var(--xhs-caption-light, #C7C7CC);
  line-height: 1;
  letter-spacing: 0.01em;
  transition: var(--xhs-transition, all 200ms cubic-bezier(0.4, 0, 0.2, 1));
}

/* Active text */
.tab-item.active .tab-text {
  color: var(--xhs-title, #1C1C1E);
  font-weight: var(--xhs-weight-semibold, 600);
}

.tab-item:active {
  transform: scale(0.95);
}
