/* ═════════════════════════════════════════╗
   小红书风格底部导航栏 (XHS Tab Bar)
   ╚════════════════════════════════════════╝ */

.tab-bar {
  display: flex;
  flex-direction: row;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 104rpx;
  background: #FFFFFF;
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0 8rpx;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 4rpx;
  transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
}

.tab-text {
  font-size: 20rpx;
  color: #C7C7CC;
  line-height: 1;
  letter-spacing: 0.01em;
  transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
}

/* Active: 底部红线 + 黑色文字 */
.tab-item.active .tab-text {
  color: #1C1C1E;
  font-weight: 600;
}

.tab-item:active {
  transform: scale(0.95);
}
