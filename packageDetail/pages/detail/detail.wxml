<view class="page-container" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar" style="height: {{navBarHeight}}px; display: flex; align-items: flex-end; padding: 0 16px;">
    <view bindtap="goBack" class="back-btn">
      <view class="back-icon-wrap">
        <text class="back-icon">‹</text>
      </view>
    </view>
  </view>

  <scroll-view wx:if="{{stock}}" class="scroll-container" scroll-y>
    <view style="display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: var(--xhs-space-md);">
      <market-tag market="{{stock.market}}" label="{{marketLabel}}" />
      <text class="title">{{stock.code}}</text>
      <text class="body">{{stock.name}}</text>
    </view>

    <text class="title" style="display: block; margin-bottom: 12px;">持仓信息</text>
    <view class="card section">
      <view style="display: flex; flex-wrap: wrap; gap: 12px;">
        <view style="width: calc(50% - 6px);">
          <text class="caption">持仓数量</text>
          <view class="body" style="color: var(--xhs-title); margin-top: 2px;">{{position.quantity}}股</view>
        </view>
        <view style="width: calc(50% - 6px);">
          <text class="caption">成本价</text>
          <view class="body" style="color: var(--xhs-title); margin-top: 2px;">{{formatAvgCost}}</view>
        </view>
        <view style="width: calc(50% - 6px);">
          <text class="caption">现价</text>
          <input type="digit" placeholder="--" value="{{position.currentPrice || ''}}" bindblur="updatePrice" style="margin-top: 2px; height: 48rpx; font-size: var(--xhs-font-md); color: var(--xhs-title); background: transparent; border: none; padding: 0;"/>
        </view>
        <view style="width: calc(50% - 6px);">
          <text class="caption">市值</text>
          <view class="body" style="color: var(--xhs-title); margin-top: 2px;">{{formatMarketValue}}</view>
        </view>
      </view>
    </view>

    <text class="title" style="display: block; margin-bottom: 12px;">盈亏统计</text>
    <view class="card section">
      <view style="display: flex; flex-wrap: wrap; gap: 12px;">
        <view style="width: calc(50% - 6px);">
          <text class="caption">浮动盈亏</text>
          <view class="body {{floatingPnLClass}}" style="font-weight: var(--xhs-weight-semibold); margin-top: 2px;">{{floatingPnLText}}</view>
        </view>
        <view style="width: calc(50% - 6px);">
          <text class="caption">盈亏比例</text>
          <view class="body {{floatingPnLClass}}" style="font-weight: var(--xhs-weight-semibold); margin-top: 2px;">{{floatingPnLPercent}}%</view>
        </view>
        <view style="width: calc(50% - 6px);">
          <text class="caption">已实现盈亏</text>
          <view class="body {{realizedPnLClass}}" style="font-weight: var(--xhs-weight-semibold); margin-top: 2px;">{{realizedPnLText}}</view>
        </view>
        <view style="width: calc(50% - 6px);">
          <text class="caption">分红收益</text>
          <view class="body profit" style="font-weight: var(--xhs-weight-semibold); margin-top: 2px;">+{{formatDividendIncome}}</view>
        </view>
      </view>
      <view style="display: flex; justify-content: space-between; padding-top: 16px; margin-top: 12px; border-top: 1px solid var(--color-separator);">
        <text class="body" style="font-weight: var(--weight-title); color: var(--color-title);">总盈亏</text>
        <text class="body {{totalPnLClass}}" style="font-weight: var(--weight-display);">{{totalPnLText}}</text>
      </view>
    </view>

    <view class="section">
      <section-header title="交易记录">
      <view slot="actions" class="text-btn" bindtap="goToRecord" style="font-size: var(--xhs-font-sm);">+ 添加</view>
    </section-header>
      <view wx:if="{{transactions.length > 0}}">
        <view wx:for="{{transactions}}" wx:key="id" class="card card-sm record-item-card {{disTransId === item.id ? 'dissolving' : ''}}" bindtap="showTransactionActions" data-id="{{item.id}}" data-type="transaction">
          <!-- 第一行：标签+日期时间 | 价格 -->
          <view class="record-header">
            <view class="record-header-left">
              <view class="tag type-tag {{item.type === 'BUY' ? 'tag-buy' : 'tag-sell'}}">{{item.typeText}}</view>
              <text class="record-datetime">{{item.dateText}} {{item.timeText}}</text>
            </view>
            <text class="record-price {{item.type === 'BUY' ? 'record-price--buy' : 'record-price--sell'}}">{{item.priceText}}</text>
          </view>
          <!-- 第二行：股数 | 手续费 总金额 -->
          <view class="record-body">
            <text class="record-qty">{{item.quantity}}股</text>
            <view class="record-body-right">
              <text class="record-fee">手续费{{item.feeText}}</text>
              <text class="record-amount">{{item.amountText}}</text>
            </view>
          </view>
          <!-- 第三行：笔记 -->
          <view wx:if="{{item.hasJournal}}" class="record-journal">
            <strategy-tags wx:if="{{item.strategies.length > 0}}" tags="{{item.strategies}}" />
            <text wx:if="{{item.reason}}" class="record-reason">{{item.reason}}</text>
          </view>
        </view>
      </view>
      <view wx:else class="card card-sm" style="text-align: center;">
        <text class="caption">暂无交易记录</text>
      </view>
    </view>

    <view class="section">
      <section-header title="分红记录">
        <view slot="actions" class="text-btn" bindtap="goToDividend" style="font-size: var(--xhs-font-sm);">+ 添加</view>
      </section-header>
      <view wx:if="{{dividends.length > 0}}">
        <view wx:for="{{dividends}}" wx:key="id" class="card card-sm record-item-card {{disDivId === item.id ? 'dissolving' : ''}}" style="margin-bottom: 8px;"
bindtap="showDividendActions" data-id="{{item.id}}" data-type="dividend">
          <view style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
            <view class="tag type-tag tag-dividend">分红</view>
            <text class="caption">{{item.dateText}}</text>
          </view>
          <view style="display: flex; gap: 16px;">
            <text class="caption">每股: {{item.perShareText}}</text>
            <text class="caption">数量: {{item.quantity}}股</text>
          </view>
          <text class="body profit" style="font-weight: var(--weight-title); margin-top: 4px;">+{{item.totalText}}</text>
        </view>
      </view>
      <view wx:else class="card card-sm" style="text-align: center;">
        <text class="caption">暂无分红记录</text>
      </view>
    </view>

    <view wx:if="{{strategySummary.length > 0}}" class="section">
      <text class="title" style="display: block; margin-bottom: 12px;">策略复盘</text>
      <view class="card section">
        <view wx:for="{{strategySummary}}" wx:key="tag" style="padding: 8px 0; {{index > 0 ? 'border-top: 1px solid var(--color-separator);' : ''}}">
          <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
            <view style="display: flex; align-items: center; gap: 8px;">
              <view class="strategy-tag">{{item.tag}}</view>
              <text class="caption">{{item.count}}笔</text>
            </view>
            <text class="caption" style="color: {{item.netPnL >= 0 ? 'var(--color-profit)' : 'var(--color-loss)'}};">{{item.netPnL >= 0 ? '+' : ''}}{{item.netPnL}}</text>
          </view>
        </view>
      </view>
    </view>
    <view style="height: 100px;"></view>
  </scroll-view>

  <empty-state 
    wx:else
    title="股票不存在"
  />
</view>
