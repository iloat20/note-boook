/* Minimal + Spatial UI - 详情页 */

.record-item-card {
  min-height: 44px;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.record-item-card.dissolving {
  opacity: 0;
  transform: scaleY(0.6);
  max-height: 0;
  margin-bottom: 0;
  padding-top: 0;
  padding-bottom: 0;
  overflow: hidden;
}

.strategy-tag {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 11px;
  background: rgba(255, 59, 48, 0.08);
  color: var(--color-accent);
}
