@import '../../../styles/common.wxss';

page {
  background: #FAFAFC;
}

/* =============================
   Hero Section
   ============================= */
.hero-section {
  padding: 16rpx 0;
}

.hero-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.hero-info-group {
  display: flex;
  align-items: center;
  gap: var(--xhs-space-sm);
  flex: 1;
  min-width: 0;
}

/* iOS 毛玻璃编辑按钮 */
.hero-glass-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  min-width: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(40px);
  -webkit-backdrop-filter: blur(40px);
  border: 0.5px solid rgba(255, 255, 255, 0.5);
  box-shadow:
    0 2px 8px rgba(0, 0, 0, 0.04),
    0 1px 2px rgba(0, 0, 0, 0.02);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: default;
}

.hero-glass-btn:active {
  opacity: 0.75;
  transform: scale(0.94);
  box-shadow:
    0 1px 4px rgba(0, 0, 0, 0.06),
    0 0px 1px rgba(0, 0, 0, 0.03);
}

/* 返回按钮（与编辑按钮同款毛玻璃风格） */
.hero-back-btn {
  width: 56rpx;
  height: 56rpx;
  min-width: 56rpx;
  padding: 0;
  justify-content: center;
}

.hero-back-icon {
  font-size: 28px;
  font-weight: 300;
  color: var(--xhs-title);
  line-height: 1;
  transform: translateX(2rpx);
}

.hero-glass-btn-text {
  font-size: 13px;
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-primary);
  letter-spacing: 0.01em;
  line-height: 1;
}

.hero-glass-btn-active {
  background: rgba(255, 59, 48, 0.75);
  backdrop-filter: blur(40px);
  -webkit-backdrop-filter: blur(40px);
  border-color: rgba(255, 59, 48, 0.3);
  box-shadow:
    0 2px 12px rgba(255, 59, 48, 0.25),
    0 1px 3px rgba(255, 59, 48, 0.15);
}

.hero-glass-btn-active .hero-glass-btn-text {
  color: #fff;
}

.hero-stock-code {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
  font-weight: var(--xhs-weight-regular);
  letter-spacing: 0.02em;
}

.hero-stock-name {
  display: block;
  font-size: 40rpx;
  font-weight: var(--xhs-weight-bold);
  color: var(--xhs-title);
  line-height: 1.2;
  margin-bottom: 16rpx;
  letter-spacing: -0.01em;
}

.hero-price {
  display: block;
  font-size: 56rpx;
  font-weight: var(--xhs-weight-bold);
  color: var(--xhs-title);
  line-height: 1.1;
  letter-spacing: -0.02em;
  margin-bottom: 12rpx;
  font-family: -apple-system, 'Helvetica Neue', sans-serif;
}

.hero-pnl-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hero-pnl-amount {
  font-size: 40rpx;
  font-weight: var(--xhs-weight-bold);
  letter-spacing: -0.01em;
  font-family: -apple-system, 'Helvetica Neue', sans-serif;
}

.pnl-pill {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 20rpx;
  border-radius: var(--xhs-radius-pill);
}

.pnl-pill.profit {
  background: var(--xhs-profit-bg);
}

.pnl-pill.loss {
  background: var(--xhs-loss-bg);
}

.pnl-pill-text {
  font-size: 24rpx;
  font-weight: var(--xhs-weight-semibold);
  letter-spacing: 0.01em;
}

.pnl-pill.profit .pnl-pill-text {
  color: var(--xhs-profit);
}

.pnl-pill.loss .pnl-pill-text {
  color: var(--xhs-loss);
}

/* =============================
   Detail Cards (matching index)
   ============================= */
.detail-card {
  background: #FFFDF7;
  border-radius: 24rpx;
  border: 1px solid rgba(0, 0, 0, 0.03);
  box-shadow:
    0 2px 8px rgba(0, 0, 0, 0.04),
    0 4px 16px rgba(0, 0, 0, 0.02);
  padding: var(--page-margin);
  margin-bottom: var(--xhs-space-md);
  position: relative;
  overflow: hidden;
  transition: var(--xhs-transition-slow);
}

.detail-card-no-pad {
  padding: 0;
}

.detail-card-header {
  padding: var(--page-margin) var(--page-margin) 0;
}

.detail-card-header-with-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.detail-card-title {
  font-size: var(--xhs-font-lg);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
  letter-spacing: -0.01em;
}

.detail-card-action {
  font-size: var(--xhs-font-sm);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-primary);
  padding: 8rpx 20rpx;
  border-radius: var(--xhs-radius-pill);
  background: var(--xhs-primary-bg);
  transition: var(--xhs-transition);
}

.detail-card-action:active {
  opacity: 0.7;
  transform: scale(0.95);
}

.detail-card-body {
  padding: var(--page-margin);
}

.detail-card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.detail-card-row + .detail-card-row {
  border-top: 1px solid var(--xhs-divider);
}

.detail-card-row-sub {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 12rpx;
  padding-left: 16rpx;
  border-top: 1px solid var(--xhs-divider);
}

.detail-card-row-dividend {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-top: 1px solid var(--xhs-divider);
}

.detail-card-label {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
  font-weight: var(--xhs-weight-medium);
  letter-spacing: 0.02em;
  flex-shrink: 0;
}

.detail-card-label-sub {
  font-size: 20rpx;
  color: var(--xhs-caption-light);
  font-weight: var(--xhs-weight-regular);
  flex-shrink: 0;
}

.detail-card-value {
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
  text-align: right;
  font-family: -apple-system, 'Helvetica Neue', sans-serif;
  letter-spacing: 0.01em;
}

.detail-card-value-sub {
  font-size: 22rpx;
  font-weight: var(--xhs-weight-medium);
  font-family: -apple-system, 'Helvetica Neue', sans-serif;
  text-align: right;
}

.detail-card-divider {
  height: 1px;
  background: var(--xhs-divider);
  margin: 0 var(--page-margin);
}

.detail-card-total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--page-margin);
  border-top: 1px solid var(--xhs-divider);
  background: rgba(255, 253, 247, 0.8);
}

.detail-card-total-label {
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
}

.detail-card-total-value {
  font-size: var(--xhs-font-lg);
  font-weight: var(--xhs-weight-bold);
  font-family: -apple-system, 'Helvetica Neue', sans-serif;
}

.detail-card-empty {
  padding: var(--page-margin);
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
}

.detail-card-empty-text {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
}

/* =============================
   Edit Mode within Cards
   ============================= */
.detail-card-edit-row {
  display: flex;
  align-items: center;
  gap: 4px;
}

.detail-card-currency {
  font-size: var(--xhs-font-md);
  color: var(--xhs-caption);
  font-weight: var(--xhs-weight-semibold);
}

.detail-card-unit {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
  font-weight: var(--xhs-weight-medium);
}

.edit-input {
  flex: 1;
  height: 40px;
  background: var(--xhs-surface);
  border: 1.5px solid var(--xhs-divider-strong);
  border-radius: 10px;
  padding: 0 12px;
  font-size: 16px;
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
  font-family: -apple-system, 'Helvetica Neue', sans-serif;
  transition: var(--xhs-transition);
  min-width: 80px;
  text-align: right;
}

.edit-input:focus {
  border-color: var(--xhs-primary);
  background: var(--xhs-primary-bg);
  box-shadow: 0 0 0 3px rgba(255, 59, 48, 0.08);
}

.edit-actions {
  display: flex;
  gap: var(--xhs-space-sm);
  padding: var(--page-margin);
}

.btn-cancel {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-caption);
  background: var(--xhs-bg-secondary);
  border-radius: 12px;
  transition: var(--xhs-transition);
}

.btn-cancel:active {
  opacity: 0.7;
  transform: scale(0.98);
}

.btn-save {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-semibold);
  color: #fff;
  background: var(--xhs-primary);
  border-radius: 12px;
  box-shadow: 0 4px 16px rgba(255, 59, 48, 0.25);
  transition: var(--xhs-transition);
}

.btn-save:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* =============================
   Transaction Records (inside card)
   ============================= */
.record-item {
  padding: var(--page-margin);
  border-top: 1px solid var(--xhs-divider);
  transition: var(--xhs-transition-slow);
}

.record-item:first-child {
  border-top: none;
}

.record-item:active {
  background: rgba(0, 0, 0, 0.02);
}

.record-item.dissolving {
  opacity: 0;
  transform: translateX(100%) scale(0.9);
  max-height: 0 !important;
  margin-bottom: 0 !important;
  padding-top: 0 !important;
  padding-bottom: 0 !important;
  overflow: hidden !important;
  transition: opacity 400ms cubic-bezier(0.4, 0, 0.2, 1), transform 400ms cubic-bezier(0.4, 0, 0.2, 1), max-height 400ms cubic-bezier(0.4, 0, 0.2, 1), padding 400ms cubic-bezier(0.4, 0, 0.2, 1) !important;
}

.record-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.record-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.record-tag-row {
  display: flex;
  align-items: center;
  gap: var(--xhs-space-xs);
}

.record-date {
  font-size: 20rpx;
  color: var(--xhs-caption-light);
  font-weight: var(--xhs-weight-regular);
}

.record-qty {
  font-size: var(--xhs-font-sm);
  font-weight: var(--xhs-weight-medium);
  color: var(--xhs-body);
}

.record-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.record-price {
  font-weight: var(--xhs-weight-bold);
  font-size: 30rpx;
  letter-spacing: 0.01em;
  font-family: -apple-system, 'Helvetica Neue', sans-serif;
  line-height: 1.2;
}

.record-price--buy {
  color: var(--xhs-profit);
}

.record-price--sell {
  color: var(--xhs-loss);
}

.record-amount {
  font-size: 22rpx;
  font-weight: var(--xhs-weight-medium);
  color: var(--xhs-caption);
}

.record-fee-row {
  margin-top: 8rpx;
  padding-top: 8rpx;
  border-top: 1px solid var(--xhs-divider);
}

.record-fee-text {
  font-size: 20rpx;
  color: var(--xhs-caption-light);
  font-weight: var(--xhs-weight-regular);
}

.record-journal {
  margin-top: 8rpx;
  padding-top: 8rpx;
  border-top: 1px solid var(--xhs-divider);
}

.record-reason {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-body);
  line-height: 1.5;
  margin-top: 4rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* =============================
   Dividend Records (inside card)
   ============================= */
.dividend-item {
  padding: var(--page-margin);
  border-top: 1px solid var(--xhs-divider);
  transition: var(--xhs-transition-slow);
}

.dividend-item:first-child {
  border-top: none;
}

.dividend-item:active {
  background: rgba(0, 0, 0, 0.02);
}

.dividend-item.dissolving {
  opacity: 0;
  transform: translateX(100%) scale(0.9);
  max-height: 0 !important;
  margin-bottom: 0 !important;
  padding-top: 0 !important;
  padding-bottom: 0 !important;
  overflow: hidden !important;
  transition: opacity 400ms cubic-bezier(0.4, 0, 0.2, 1), transform 400ms cubic-bezier(0.4, 0, 0.2, 1), max-height 400ms cubic-bezier(0.4, 0, 0.2, 1), padding 400ms cubic-bezier(0.4, 0, 0.2, 1) !important;
}

.dividend-main-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.dividend-date {
  font-size: 20rpx;
  color: var(--xhs-caption-light);
  font-weight: var(--xhs-weight-regular);
}

.dividend-detail-row {
  display: flex;
  gap: var(--xhs-space-md);
  margin-bottom: 8rpx;
}

.dividend-detail {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
  font-weight: var(--xhs-weight-medium);
}

.dividend-amount {
  font-size: var(--xhs-font-lg);
  font-weight: var(--xhs-weight-bold);
}

/* =============================
   Strategy Section
   ============================= */
.strategy-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.strategy-row-bordered {
  border-top: 1px solid var(--xhs-divider);
}

.strategy-left {
  display: flex;
  align-items: center;
  gap: var(--xhs-space-sm);
}

.strategy-tag {
  display: inline-block;
  padding: 4px 12px;
  border-radius: var(--xhs-radius-pill);
  font-size: 20rpx;
  background: var(--xhs-primary-bg);
  color: var(--xhs-primary);
  font-weight: var(--xhs-weight-medium);
}

.strategy-count {
  font-size: 20rpx;
  color: var(--xhs-caption);
  font-weight: var(--xhs-weight-regular);
}

.strategy-pnl {
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-semibold);
}

/* =============================
   Dissolve animation fallback
   ============================= */
@keyframes dissolve-out {
  0% { opacity: 1; transform: translateX(0) scale(1); max-height: 300px; padding: var(--page-margin); }
  50% { opacity: 0; transform: translateX(100%) scale(0.9); max-height: 300px; padding: var(--page-margin); }
  100% { opacity: 0; transform: translateX(100%) scale(0.9); max-height: 0; padding-top: 0; padding-bottom: 0; }
}

.dissolving {
  animation: dissolve-out 350ms ease-in forwards;
  pointer-events: none;
}
