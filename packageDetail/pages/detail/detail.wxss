/* ═════════════════════════════════════════╗
   小红书风格 - 详情页 v2
   ╚════════════════════════════════════════╝ */

@import '../../../styles/common.wxss';

page {
  background: var(--xhs-bg);
}

/* === 返回按钮 === */
.back-btn {
  min-height: 44px;
  min-width: 44px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.back-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--xhs-radius-round);
  background: var(--xhs-surface);
  box-shadow: var(--xhs-elevation-2);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--xhs-transition);
}

.back-icon-wrap:active {
  transform: scale(0.9);
}

.back-icon {
  font-size: 24px;
  color: var(--xhs-title);
  font-weight: var(--xhs-weight-semibold);
  line-height: 1;
  margin-left: -1px;
}

/* === 图标按钮 === */
.icon-btn {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 6px 14px;
  background: var(--xhs-surface);
  border-radius: 20px;
  box-shadow: var(--xhs-elevation-2);
  transition: var(--xhs-transition);
}

.icon-btn:active {
  transform: scale(0.95);
  box-shadow: var(--xhs-elevation-1);
}

.icon-btn-icon {
  font-size: 14px;
  line-height: 1;
}

.icon-btn-text {
  font-size: var(--xhs-font-sm);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-primary);
}

.icon-btn-add {
  background: linear-gradient(135deg, var(--xhs-primary) 0%, #ff6b6b 100%);
  box-shadow: 0 4px 12px rgba(255, 36, 66, 0.25);
}

.icon-btn-add:active {
  box-shadow: 0 2px 8px rgba(255, 36, 66, 0.2);
}

.icon-btn-add .icon-btn-text {
  color: #fff;
}

/* === 导航栏 === */
.nav-bar {
  display: flex;
  align-items: flex-end;
  background: var(--xhs-bg);
  padding: 0 var(--xhs-space-md) var(--xhs-space-sm);
}

/* === 卡片容器 === */
.card {
  background: var(--xhs-surface);
  border-radius: var(--xhs-radius-lg);
  box-shadow: var(--xhs-elevation-2);
  padding: var(--space-card-pad, var(--xhs-space-lg));
  position: relative;
  overflow: hidden;
  transition: var(--xhs-transition-slow);
}

.card:active {
  transform: scale(0.98);
}

.card-sm {
  padding: var(--xhs-space-md);
}

/* === 信息字段 === */
.card .caption {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
  letter-spacing: 0.02em;
  font-weight: var(--xhs-weight-medium);
  display: block;
  margin-bottom: var(--xhs-space-xs);
}

.card .body {
  font-size: var(--xhs-font-lg);
  font-weight: var(--xhs-weight-medium);
  color: var(--xhs-title);
}

.card .mono-num {
  font-size: var(--xhs-font-lg);
  font-weight: var(--xhs-weight-semibold);
  letter-spacing: 0.01em;
}

.card .title {
  font-size: var(--xhs-font-xl);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
}

/* === 交易记录卡片 === */
.record-item-card {
  min-height: 44px;
  margin-bottom: var(--xhs-space-xs);
  padding: var(--xhs-space-sm) var(--xhs-space-md);
  transition: var(--xhs-transition-slow);
}

.record-item-card:active {
  transform: scale(0.98);
  box-shadow: none;
}

.record-item-card.dissolving {
  opacity: 0;
  transform: translateX(100%) scale(0.9);
  max-height: 0 !important;
  margin-bottom: 0 !important;
  padding-top: 0 !important;
  padding-bottom: 0 !important;
  overflow: hidden !important;
  transition: all 400ms cubic-bezier(0.4, 0, 0.2, 1) !important;
}

.record-item-card .tag {
  display: inline-flex;
  align-items: center;
  padding: 3px 12px;
  border-radius: var(--xhs-radius-pill);
  font-size: var(--xhs-font-xs);
  font-weight: var(--xhs-weight-medium);
  letter-spacing: 0.01em;
}

.type-tag {
  display: inline-block;
}

/* === 策略标签 === */
.strategy-tag {
  display: inline-block;
  padding: 3px 10px;
  border-radius: var(--xhs-radius-pill);
  font-size: var(--xhs-font-xs);
  background: var(--xhs-primary-bg);
  color: var(--xhs-primary);
  font-weight: var(--xhs-weight-medium);
  margin-right: var(--xhs-space-xs);
}

/* === Section Header === */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--xhs-space-md);
}

.section-header .title {
  font-size: var(--xhs-font-xl);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
}

/* === Input (价格编辑) === */
.input {
  background: transparent;
  border: none;
  border-radius: 0;
  height: 24px;
  font-size: var(--xhs-font-md);
  color: var(--xhs-title);
  padding: 0;
}

/* === 编辑输入框 === */
.edit-input {
  flex: 1;
  height: 40px;
  background: var(--xhs-surface);
  border: 1.5px solid var(--xhs-divider-strong);
  border-radius: 10px;
  padding: 0 var(--xhs-space-sm);
  font-size: var(--xhs-font-lg);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
  font-family: var(--xhs-mono, -apple-system, 'Helvetica Neue', sans-serif);
  transition: var(--xhs-transition);
}

.edit-input:focus {
  border-color: var(--xhs-primary);
  background: var(--xhs-primary-bg);
  box-shadow: 0 0 0 3px rgba(255, 59, 48, 0.08);
}

/* === 编辑按钮 === */
.btn-cancel {
  flex: 1;
  height: 44px;
  line-height: 44px;
  text-align: center;
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-caption);
  background: var(--xhs-bg-secondary);
  border-radius: 10px;
  transition: var(--xhs-transition);
}

.btn-cancel:active {
  opacity: 0.7;
  transform: scale(0.98);
}

.btn-save {
  flex: 1;
  height: 44px;
  line-height: 44px;
  text-align: center;
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-semibold);
  color: #fff;
  background: var(--xhs-primary);
  border-radius: 10px;
  box-shadow: 0 4px 16px rgba(255, 36, 66, 0.25);
  transition: var(--xhs-transition);
}

.btn-save:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* === 交易记录布局 === */
.record-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--xhs-space-xs);
}

.record-header-left {
  display: flex;
  align-items: center;
  gap: var(--xhs-space-xs);
}

.record-datetime {
  font-size: var(--xhs-font-xs);
  color: var(--xhs-caption);
}

.record-price {
  font-weight: var(--xhs-weight-bold);
  font-size: 17px;
  letter-spacing: 0.01em;
  font-family: var(--xhs-mono, -apple-system, 'Helvetica Neue', sans-serif);
}

.record-price--buy {
  color: var(--xhs-profit);
}

.record-price--sell {
  color: var(--xhs-loss);
}

/* 第二行 */
.record-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: var(--xhs-space-xs);
  border-top: 1px solid var(--xhs-divider);
}

.record-qty {
  font-weight: var(--xhs-weight-semibold);
  font-size: var(--xhs-font-md);
  color: var(--xhs-title);
}

.record-body-right {
  display: flex;
  align-items: center;
  gap: var(--xhs-space-xs);
}

.record-fee {
  font-size: var(--xhs-font-xs);
  color: var(--xhs-caption);
}

.record-amount {
  font-size: var(--xhs-font-sm);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
}

/* 第三行：笔记 */
.record-journal {
  margin-top: var(--xhs-space-xs);
  padding-top: var(--xhs-space-xs);
  border-top: 1px solid var(--xhs-divider);
}

.record-reason {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-body);
  line-height: 1.5;
  margin-top: var(--xhs-space-xxs);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
