<view class="page-container" style="padding-top: {{statusBarHeight + navBarHeight}}px;">
  <!-- 导航栏 -->
  <view class="nav-bar" style="height: {{navBarHeight}}px;">
    <view class="nav-back" bindtap="goBack">
      <view class="nav-back-circle">
        <text class="nav-back-arrow">‹</text>
      </view>
    </view>
    <text class="nav-title">{{isEdit ? '编辑分红' : '添加分红'}}</text>
  </view>

  <scroll-view class="scroll-container" scroll-y>
    <text class="section-title">分红信息</text>
    <view class="record-card">
      <view class="field-group">
        <text class="field-label">选择股票</text>
        <picker mode="selector" range="{{stockOptions}}" range-key="label" bindchange="selStock">
          <view class="record-input picker-input">
            <text class="{{stockText !== '请选择股票' ? '' : 'picker-placeholder'}}">{{stockText}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <!-- 分红类型选择 -->
      <view class="field-group">
        <text class="field-label">分红类型</text>
        <view class="segmented-control">
          <view class="segment-item {{divType === 'CASH' ? 'segment-active' : ''}}" bindtap="selectDivType" data-type="CASH">现金分红</view>
          <view class="segment-item {{divType === 'SHARE' ? 'segment-active' : ''}}" bindtap="selectDivType" data-type="SHARE">送股</view>
        </view>
      </view>

      <!-- 现金分红字段 -->
      <block wx:if="{{divType === 'CASH'}}">
        <view class="field-group">
          <text class="field-label">每股分红金额</text>
          <input class="record-input" type="digit" placeholder="0.00" value="{{perShare}}" bindinput="onPS"/>
        </view>
      </block>

      <!-- 送股字段 -->
      <block wx:if="{{divType === 'SHARE'}}">
        <view class="field-group">
          <text class="field-label">送股数量（股）</text>
          <input class="record-input" type="digit" placeholder="0" value="{{shareQty}}" bindinput="onShareQty"/>
        </view>
      </block>

      <view class="field-group">
        <text class="field-label">持股数量（股）</text>
        <input class="record-input" type="digit" placeholder="0" value="{{qty}}" bindinput="onQty"/>
      </view>
      <view class="field-row">
        <view class="field-group field-half">
          <text class="field-label">分红日期</text>
          <picker mode="date" value="{{date}}" bindchange="onDate">
            <view class="record-input picker-input">
              <text class="{{date ? '' : 'picker-placeholder'}}">{{date || '选择日期'}}</text>
              <text class="picker-arrow">›</text>
            </view>
          </picker>
        </view>
      </view>
      <view class="field-group field-last">
        <text class="field-label">备注（选填）</text>
        <textarea class="record-input record-textarea"
          placeholder="添加备注..."
          value="{{note}}"
          bindinput="onNote"/>
      </view>
    </view>

    <view class="record-section">
      <text class="section-title">预览</text>
      <view class="record-card preview-card">
        <view wx:if="{{divType === 'CASH'}}" class="preview-row">
          <text class="preview-label">每股分红</text>
          <text class="preview-value">{{perShareText}}</text>
        </view>
        <view wx:if="{{divType === 'SHARE'}}" class="preview-row">
          <text class="preview-label">送股数量</text>
          <text class="preview-value">{{shareQty || 0}}股</text>
        </view>
        <view class="preview-row">
          <text class="preview-label">持股数量</text>
          <text class="preview-value">{{qty}}股</text>
        </view>
        <view class="preview-divider"></view>
        <view class="preview-row">
          <text class="preview-label preview-label-bold">{{divType === 'SHARE' ? '送股合计' : '分红总额'}}</text>
          <text class="preview-value preview-value-bold">{{divType === 'SHARE' ? totalText : '+' + totalText}}</text>
        </view>
      </view>
    </view>

    <view class="bottom-spacer"></view>
  </scroll-view>

  <!-- 底部确认按钮 -->
  <view class="submit-bar">
    <view class="submit-btn" bindtap="submit">{{isEdit ? '保存修改' : '确认添加'}}</view>
  </view>
</view>
