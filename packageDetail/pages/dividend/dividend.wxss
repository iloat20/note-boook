/* ═════════════════════════════════════════╗
   小红书风格 - 分红页 v2
   ╚════════════════════════════════════════╝ */

@import '../../../styles/common.wxss';

/* === 导航栏 === */
.nav-bar {
  position: sticky;
  top: 0;
  z-index: var(--xhs-z-sticky);
  display: flex;
  align-items: flex-end;
  background: var(--xhs-bg);
  padding: 0 var(--xhs-space-md) var(--xhs-space-sm);
}

.nav-back {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-back-circle {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--xhs-surface);
  box-shadow: var(--xhs-elevation-1);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--xhs-transition);
}

.nav-back-circle:active {
  transform: scale(0.9);
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
}

.nav-back-arrow {
  font-size: 52rpx;
  color: var(--xhs-title);
  font-weight: 400;
  line-height: 1;
  margin-top: -2px;
}

.nav-title {
  flex: 1;
  font-size: var(--xhs-font-lg);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
  text-align: center;
  letter-spacing: -0.01em;
  padding-right: 44px;
}

/* === 区块标题 === */
.section-title {
  display: block;
  font-size: var(--xhs-font-sm);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-caption);
  padding: var(--xhs-space-md) var(--xhs-space-xxs) var(--xhs-space-xs);
  letter-spacing: 0.02em;
}

/* === 卡片 === */
.record-card {
  background: var(--xhs-surface);
  border-radius: var(--xhs-radius-md);
  box-shadow: var(--xhs-elevation-2);
  padding: var(--xhs-space-md);
}

/* === 分段控制器 === */
.segmented-control {
  display: flex;
  background: var(--xhs-bg-secondary);
  border-radius: 10px;
  padding: 3px;
  margin-bottom: var(--xhs-space-sm);
  position: relative;
}

.segment-item {
  flex: 1;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--xhs-font-sm);
  font-weight: var(--xhs-weight-medium);
  color: var(--xhs-caption);
  border-radius: 8px;
  transition: var(--xhs-transition);
  position: relative;
  z-index: 1;
}

.segment-active {
  background: var(--xhs-surface);
  font-weight: var(--xhs-weight-semibold);
  box-shadow: var(--xhs-elevation-1);
}

/* === 表单字段 === */
.field-group {
  margin-bottom: 14px;
}

.field-last {
  margin-bottom: 0;
}

.field-label {
  display: block;
  font-size: var(--xhs-font-xs);
  font-weight: var(--xhs-weight-medium);
  color: var(--xhs-caption);
  margin-bottom: 6px;
  letter-spacing: 0.03em;
}

.field-row {
  display: flex;
  gap: 12px;
  margin-bottom: 14px;
}

.field-half {
  flex: 1;
  margin-bottom: 0;
}

/* === 输入框 === */
.record-input {
  width: 100%;
  height: 44px;
  background: var(--xhs-bg-secondary);
  border: 1.5px solid transparent;
  border-radius: 10px;
  padding: 0 12px;
  font-size: var(--xhs-font-md);
  color: var(--xhs-title);
  box-sizing: border-box;
  transition: all 200ms ease;
}

.record-input:focus {
  border-color: var(--xhs-primary);
  background: var(--xhs-surface);
  box-shadow: 0 0 0 3px rgba(255, 36, 66, 0.06);
}

.record-textarea {
  height: 80px;
  padding: 12px;
  line-height: 1.5;
  border-radius: 10px;
}

.picker-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-placeholder {
  color: var(--xhs-caption-light);
}

.picker-arrow {
  font-size: var(--xhs-font-lg);
  color: var(--xhs-caption-light);
  font-weight: 300;
}

/* === 预览卡片 === */
.preview-card {
  padding: 16px;
}

.preview-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 0;
}

.preview-label {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
}

.preview-label-bold {
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
  font-size: var(--xhs-font-md);
}

.preview-value {
  font-size: var(--xhs-font-md);
  color: var(--xhs-title);
  font-weight: var(--xhs-weight-medium);
}

.preview-value-bold {
  font-weight: var(--xhs-weight-bold);
  font-size: var(--xhs-font-lg);
}

.preview-divider {
  height: 1px;
  background: var(--xhs-divider);
  margin: 6px 0;
}

/* === 底部间距 === */
.bottom-spacer {
  height: 140px;
}

/* === 底部提交栏 === */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: var(--xhs-z-overlay);
  padding: var(--xhs-space-sm) var(--xhs-space-md);
  padding-bottom: calc(var(--xhs-space-sm) + env(safe-area-inset-bottom));
  background: linear-gradient(to top, var(--xhs-bg) 60%, transparent);
  pointer-events: none;
}

.submit-btn {
  height: 48px;
  line-height: 48px;
  text-align: center;
  color: #fff;
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-semibold);
  border-radius: var(--xhs-radius-sm);
  transition: var(--xhs-transition);
  pointer-events: auto;
}

.submit-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}
