/* ═════════════════════════════════════════╗
   交易编辑页 — 小红书风格 v3
   ╚════════════════════════════════════════╝ */

@import '../../../styles/common.wxss';
@import '../../../styles/_nav-bar.wxss';

page {
  background: var(--xhs-bg);
}


/* === 滚动区 === */
.scroll-container {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 0 var(--xhs-space-md);
}

/* === 区块标题 === */
.record-section {
  margin-bottom: var(--xhs-space-sm);
}

.section-title {
  display: block;
  font-size: var(--xhs-font-sm);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-caption);
  padding: var(--xhs-space-md) var(--xhs-space-xxs) var(--xhs-space-xs);
  letter-spacing: 0.02em;
}

/* === 卡片 === */
.record-card {
  background: var(--xhs-surface);
  border-radius: var(--xhs-radius-md);
  box-shadow: var(--xhs-elevation-2);
  padding: var(--xhs-space-md);
}

/* === 分段控制器（市场 / 买卖） === */
.segmented-control {
  display: flex;
  background: var(--xhs-bg-secondary);
  border-radius: 10px;
  padding: 3px;
  margin-bottom: var(--xhs-space-sm);
  position: relative;
}

.segment-item {
  flex: 1;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--xhs-font-sm);
  font-weight: var(--xhs-weight-medium);
  color: var(--xhs-caption);
  border-radius: 8px;
  transition: var(--xhs-transition);
  position: relative;
  z-index: 1;
}

.segment-active {
  background: var(--xhs-surface);
  font-weight: var(--xhs-weight-semibold);
  box-shadow: var(--xhs-elevation-1);
}

.segment-buy {
  color: var(--xhs-profit);
}

.segment-sell {
  color: var(--xhs-loss);
}

/* === 买卖方向选择器（大卡片） === */
.type-selector {
  display: flex;
  align-items: center;
  gap: 0;
  background: var(--xhs-bg-secondary);
  border-radius: 14px;
  padding: var(--xhs-space-xxs);
}

.type-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 14px 8px 12px;
  border-radius: 12px;
  transition: var(--xhs-transition);
  cursor: pointer;
  gap: 2px;
}

.type-option:active {
  transform: scale(0.97);
}

.type-active {
  background: var(--xhs-surface);
  box-shadow: var(--xhs-elevation-1);
}

.type-buy-active {
  background: var(--xhs-profit-bg);
  box-shadow: 0 2px 12px rgba(255, 107, 107, 0.15);
}

.type-buy-active .type-emoji { transform: scale(1.15); }

.type-sell-active {
  background: var(--xhs-loss-bg);
  box-shadow: 0 2px 12px rgba(52, 199, 89, 0.15);
}

.type-sell-active .type-emoji { transform: scale(1.15); }

.type-emoji {
  font-size: 28px;
  margin-bottom: var(--xhs-space-xxs);
  transition: transform 250ms ease;
}

.type-label {
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-caption);
  transition: color 200ms ease;
}

.type-buy-active .type-label { color: var(--xhs-profit); }
.type-sell-active .type-label { color: var(--xhs-loss); }

.type-desc {
  font-size: var(--xhs-font-xs);
  color: var(--xhs-caption-light);
  margin-top: 1px;
  transition: color 200ms ease;
}

.type-buy-active .type-desc { color: var(--xhs-profit); opacity: 0.7; }
.type-sell-active .type-desc { color: var(--xhs-loss); opacity: 0.7; }

.type-divider {
  width: 1px;
  height: 36px;
  background: var(--xhs-divider);
  flex-shrink: 0;
}

/* === 代码输入 + 市场徽章 === */
.code-input-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.code-input {
  padding-right: 56px;
}

.code-market-badge {
  position: absolute;
  right: 10px;
  top: 50%;
  transform: translateY(-50%);
  font-size: var(--xhs-font-xs);
  padding: 2px 10px;
  border-radius: 10px;
  background: var(--xhs-primary-bg);
  color: var(--xhs-primary);
  font-weight: var(--xhs-weight-medium);
  pointer-events: none;
}

/* === 搜索建议中的市场标签 === */
.suggestion-market-tag {
  font-size: var(--xhs-font-xs);
  padding: 2px 8px;
  border-radius: 10px;
  background: var(--xhs-bg-secondary);
  color: var(--xhs-caption-light);
  font-weight: var(--xhs-weight-medium);
  flex-shrink: 0;
}

/* === 表单字段 === */
.field-group {
  margin-bottom: var(--xhs-space-md);
}

.field-last {
  margin-bottom: 0;
}

.field-label {
  display: block;
  font-size: var(--xhs-font-xs);
  font-weight: var(--xhs-weight-medium);
  color: var(--xhs-caption);
  margin-bottom: 6px;
  letter-spacing: 0.03em;
}

.field-error {
  font-size: var(--xhs-font-xs);
  color: var(--xhs-profit);
  margin-top: var(--xhs-space-xxs);
  padding-left: 2px;
}

/* 日期/时间 并排 */
.field-row {
  display: flex;
  gap: var(--xhs-space-sm);
  margin-bottom: var(--xhs-space-md);
}

.field-half {
  flex: 1;
  margin-bottom: 0;
}

/* === 输入框 === */
.record-input {
  width: 100%;
  height: 44px;
  background: var(--xhs-bg-secondary);
  border: 1.5px solid transparent;
  border-radius: 10px;
  padding: 0 var(--xhs-space-sm);
  font-size: var(--xhs-font-md);
  color: var(--xhs-title);
  box-sizing: border-box;
  transition: var(--xhs-transition);
}

.record-input:focus {
  border-color: var(--xhs-primary);
  background: var(--xhs-surface);
  box-shadow: 0 0 0 3px rgba(255, 36, 66, 0.06);
}

.record-textarea {
  height: 80px;
  padding: var(--xhs-space-sm);
  line-height: 1.5;
  border-radius: 10px;
}

.picker-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-placeholder {
  color: var(--xhs-caption-light);
}

.picker-arrow {
  font-size: var(--xhs-font-lg);
  color: var(--xhs-caption-light);
  font-weight: 300;
}

/* === 搜索建议下拉 === */
.suggestions-dropdown {
  margin-top: var(--xhs-space-xs);
  background: var(--xhs-surface);
  border-radius: var(--xhs-radius-sm);
  box-shadow: var(--xhs-elevation-4);
  max-height: 220px;
  overflow-y: auto;
  position: relative;
  z-index: var(--xhs-z-modal);
  border: 1px solid var(--xhs-divider);
}

.suggestion-item {
  padding: 12px 14px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: background 150ms ease;
}

.suggestion-item:active {
  background: var(--xhs-bg-secondary);
}

.suggestion-item:not(:last-child) {
  border-bottom: 1px solid var(--xhs-divider);
}

.suggestion-code {
  font-size: var(--xhs-font-md);
  color: var(--xhs-title);
  font-weight: var(--xhs-weight-semibold);
}

.suggestion-name {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
}

/* === 搜索历史 === */
.sh-hint {
  padding: 8px 14px;
  font-size: var(--xhs-font-xs, 11px);
  color: var(--xhs-caption);
  font-weight: var(--xhs-weight-medium);
}

.history-item {
  padding-left: 14px;
}

.history-keyword {
  font-weight: var(--xhs-weight-medium);
  color: var(--xhs-body);
}

/* === 手续费明细 === */
.fee-breakdown {
  margin-top: 8px;
  padding: 10px 12px;
  background: var(--xhs-bg-secondary);
  border-radius: 10px;
}

.fee-item {
  display: flex;
  justify-content: space-between;
  padding: 4px 0;
}

.fee-item:not(:last-child) {
  border-bottom: 1px solid var(--xhs-divider);
}

.fee-name {
  font-size: var(--xhs-font-xs);
  color: var(--xhs-caption);
}

.fee-value {
  font-size: var(--xhs-font-xs);
  color: var(--xhs-body);
  font-weight: var(--xhs-weight-medium);
}

/* === 交易笔记 === */
.journal-toggle {
  display: flex;
  align-items: center;
  padding: 2px 0;
}

.journal-title {
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
}

.journal-optional {
  font-size: var(--xhs-font-xs);
  color: var(--xhs-caption-light);
  margin-left: 6px;
}

.journal-spacer {
  flex: 1;
}

.journal-badges {
  display: flex;
  gap: 6px;
  margin-right: 8px;
}

.journal-badge {
  font-size: 11px;
  padding: 3px 8px;
  border-radius: 20px;
  background: var(--xhs-primary-bg);
  color: var(--xhs-primary);
  font-weight: var(--xhs-weight-medium);
}

.journal-arrow {
  font-size: var(--xhs-font-xl);
  color: var(--xhs-caption-light);
  transition: transform 250ms ease;
}

.journal-arrow-open {
  transform: rotate(90deg);
}

.journal-body {
  margin-top: 14px;
  padding-top: 14px;
  border-top: 1px solid var(--xhs-divider);
}

/* === 策略标签 === */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.tag-item {
  padding: 7px 16px;
  border-radius: 20px;
  font-size: var(--xhs-font-sm);
  border: 1px solid var(--xhs-divider-strong);
  background: var(--xhs-bg-secondary);
  color: var(--xhs-body);
  transition: background-color 150ms ease, border-color 150ms ease, transform 150ms ease;
}

.tag-item:active {
  transform: scale(0.96);
}

.tag-selected {
  background: var(--xhs-primary);
  color: #fff;
  border-color: var(--xhs-primary);
  font-weight: var(--xhs-weight-semibold);
  display: flex;
  align-items: center;
  gap: 4px;
}

.tag-remove {
  font-size: 12px;
  opacity: 0.7;
}

.tag-add {
  background: var(--xhs-primary-bg);
  color: var(--xhs-primary);
  border: 1px dashed var(--xhs-primary-light);
  font-weight: var(--xhs-weight-medium);
}

/* === 策略选择弹窗（小红书底部弹窗风格） === */
.picker-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  animation: fadeIn 200ms ease;
}

.picker-sheet {
  width: 100%;
  max-height: 65vh;
  background: var(--xhs-surface);
  border-radius: 20px 20px 0 0;
  box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.08);
  padding: 20px;
  padding-bottom: calc(20px + env(safe-area-inset-bottom));
  overflow-y: auto;
  animation: slideUp 300ms cubic-bezier(0.4, 0, 0.2, 1);
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.picker-title {
  font-size: var(--xhs-font-lg);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
}

.picker-done {
  padding: 6px 16px;
  font-size: var(--xhs-font-md);
  color: #fff;
  font-weight: var(--xhs-weight-semibold);
  background: var(--xhs-primary);
  border-radius: 20px;
  transition: opacity 150ms ease, transform 150ms ease;
  opacity: 0.85;
  transform: scale(0.95);
}

.picker-custom {
  display: flex;
  gap: 8px;
  margin-bottom: 16px;
}

.picker-custom-input {
  flex: 1;
}

.picker-custom-btn {
  flex-shrink: 0;
  align-self: center;
}

.picker-tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

/* === 预览卡片 === */
.preview-card {
  padding: 16px;
}

.preview-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 0;
}

.preview-label {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
}

.preview-label-bold {
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
  font-size: var(--xhs-font-md);
}

.preview-value {
  font-size: var(--xhs-font-md);
  color: var(--xhs-title);
  font-weight: var(--xhs-weight-medium);
}

.preview-value-bold {
  font-weight: var(--xhs-weight-bold);
  font-size: var(--xhs-font-lg);
}

.preview-divider {
  height: 1px;
  background: var(--xhs-divider);
  margin: 6px 0;
}

/* 预览金额颜色跟随买卖类型 */
.preview-amount-buy {
  color: var(--xhs-profit);
}

.preview-amount-sell {
  color: var(--xhs-loss);
}

/* === 底部间距 === */
.bottom-spacer {
  height: 140px;
}

/* === 底部提交栏 === */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 10;
  padding: 12px 16px;
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
  background: linear-gradient(to top, var(--xhs-bg) 60%, transparent);
  pointer-events: none;
}

.submit-btn {
  height: 48px;
  line-height: 48px;
  text-align: center;
  color: #fff;
  font-size: 16px;
  font-weight: var(--xhs-weight-semibold);
  border-radius: 12px;
  transition: opacity 200ms ease, transform 200ms ease;
  pointer-events: auto;
}

.submit-btn-buy {
  background: var(--xhs-profit);
  box-shadow: 0 4px 16px rgba(255, 107, 107, 0.3);
}

.submit-btn-sell {
  background: var(--xhs-loss);
  box-shadow: 0 4px 16px rgba(52, 199, 89, 0.3);
}

.submit-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* === 动画 === */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
