<!--pages/chat/chat.wxml-->
<view class="chat">
  <view class="chat-header">
    <button class="back-btn" bindtap="goBack">←</button>
    <text class="header-title">{{formatDate(date)}}</text>
    <button class="summary-btn" bindtap="generateSummary">AI总结</button>
  </view>
  
  <scroll-view class="chat-messages" scroll-y>
    <!-- 系统消息 -->
    <view class="system-message">
      <text class="system-text">你发起了聊天，开始记录今天的事情</text>
    </view>
    
    <view 
      wx:for="{{messages}}" 
      wx:key="index"
      class="message-container {{message.sender === 'user' ? 'user-message' : 'ai-message'}}"
    >
      <view wx:if="{{message.sender !== 'user'}}" class="message-avatar">
        <view class="avatar">{{message.sender.charAt(0)}}</view>
      </view>
      <view class="message-content-wrapper">
        <view wx:if="{{message.sender !== 'user'}}" class="message-nickname">{{message.sender}}</view>
        <view class="message-content">
          <view wx:if="{{message.type === 'text'}}" class="text-message">
            {{message.content}}
          </view>
          <view wx:elif="{{message.type === 'image'}}" class="image-message">
            <image src="{{message.content}}" mode="aspectFit" bindtap="previewImage" data-src="{{message.content}}" />
          </view>
          <view wx:elif="{{message.type === 'audio'}}" class="audio-message">
            <audio src="{{message.content}}" controls />
          </view>
          <view wx:elif="{{message.type === 'video'}}" class="video-message">
            <video src="{{message.content}}" controls bindtap="previewVideo" data-src="{{message.content}}" />
          </view>
          <view wx:elif="{{message.type === 'file'}}" class="file-message">
            <navigator url="{{message.content}}" target="_blank">下载文件</navigator>
          </view>
        </view>
        <view class="message-time">{{message.time}}</view>
      </view>
      <view wx:if="{{message.sender === 'user'}}" class="message-avatar">
        <view class="avatar user-avatar">你</view>
      </view>
    </view>
    
    <view wx:if="{{summary}}" class="summary-container">
      <text class="summary-title">今日总结</text>
      <text class="summary-content">{{summary}}</text>
    </view>
  </scroll-view>
  
  <view class="chat-input">
    <button class="voice-btn" bindtap="toggleRecording">
      {{isRecording ? '停止' : '按住说话'}}
    </button>
    <input 
      value="{{inputMessage}}"
      type="text"
      placeholder="输入消息..."
      class="text-input"
      bindinput="handleInput"
      bindconfirm="sendMessage"
    />
    <button class="emoji-btn" bindtap="toggleEmojiPicker">😊</button>
    <button class="add-btn" bindtap="triggerFileUpload">+</button>
  </view>
  
  <!-- 表情选择器 -->
  <view wx:if="{{showEmojiPicker}}" class="emoji-picker">
    <view class="emoji-grid">
      <view 
        wx:for="{{emojis}}" 
        wx:key="index"
        class="emoji-item"
        bindtap="selectEmoji"
        data-emoji="{{item}}"
      >
        {{item}}
      </view>
    </view>
    <button class="close-emoji-btn" bindtap="toggleEmojiPicker">关闭</button>
  </view>
</view>