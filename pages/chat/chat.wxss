/* pages/chat/chat.wxss */
.chat {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f2f2f2;
}

.chat-header {
  padding: 0 20rpx;
  height: 88rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #e5e5e5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}

.back-btn {
  background: none;
  border: none;
  font-size: 36rpx;
  cursor: pointer;
  padding: 0;
  line-height: 1;
  color: #333;
  width: 60rpx;
}

.header-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  flex: 1;
  text-align: center;
  margin: 0;
}

.summary-btn {
  background-color: #07c160;
  color: white;
  border: none;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  cursor: pointer;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  width: 120rpx;
  text-align: center;
}

.chat-messages {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  background-color: #f2f2f2;
}

.system-message {
  align-self: center;
  margin: 10rpx 0;
  padding: 5rpx 15rpx;
  background-color: rgba(0, 0, 0, 0.05);
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.system-text {
  font-size: 22rpx;
  color: #999;
}

.message-container {
  margin-bottom: 20rpx;
  max-width: 75%;
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
}

.user-message {
  align-self: flex-end;
  flex-direction: row-reverse;
}

.ai-message {
  align-self: flex-start;
}

.message-avatar {
  width: 50rpx;
  height: 50rpx;
  flex-shrink: 0;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background-color: #e5e5e5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #666;
}

.user-avatar {
  background-color: #07c160;
  color: white;
}

.message-content-wrapper {
  display: flex;
  flex-direction: column;
  max-width: calc(100% - 60rpx);
}

.message-nickname {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 5rpx;
  margin-left: 10rpx;
}

.message-content {
  padding: 12rpx 18rpx;
  border-radius: 18rpx;
  position: relative;
  word-wrap: break-word;
  line-height: 1.4;
  font-size: 28rpx;
  max-width: 100%;
}

.user-message .message-content {
  background-color: #07c160;
  color: white;
  border-bottom-right-radius: 4rpx;
}

.ai-message .message-content {
  background-color: white;
  color: #333;
  border-bottom-left-radius: 4rpx;
}

.image-message {
  cursor: pointer;
}

.image-message image {
  max-width: 100%;
  max-height: 400rpx;
  border-radius: 12rpx;
  margin: 0;
  display: block;
}

.audio-message audio {
  width: 100%;
  margin: 0;
}

.video-message {
  cursor: pointer;
}

.video-message video {
  width: 100%;
  max-height: 400rpx;
  margin: 0;
  display: block;
  border-radius: 12rpx;
}

.file-message navigator {
  color: #07c160;
  text-decoration: none;
  display: block;
  padding: 10rpx;
  background-color: white;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.message-time {
  font-size: 20rpx;
  color: #999;
  margin-top: 8rpx;
  text-align: right;
  padding: 0 10rpx;
}

.user-message .message-time {
  text-align: left;
}

.summary-container {
  background-color: white;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-top: 30rpx;
  align-self: center;
  max-width: 90%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.summary-title {
  color: #07c160;
  font-weight: bold;
  margin-bottom: 10rpx;
  display: block;
  font-size: 26rpx;
}

.summary-content {
  font-size: 24rpx;
  line-height: 1.5;
  color: #666;
}

.chat-input {
  padding: 10rpx 20rpx;
  background-color: #f7f7f7;
  border-top: 1rpx solid #e5e5e5;
  display: flex;
  align-items: center;
  gap: 15rpx;
  height: 100rpx;
}

.voice-btn {
  background: none;
  border: none;
  font-size: 24rpx;
  color: #666;
  cursor: pointer;
  padding: 0;
  line-height: 1;
}

.text-input {
  flex: 1;
  padding: 15rpx 20rpx;
  background-color: white;
  border: 1rpx solid #e5e5e5;
  border-radius: 40rpx;
  outline: none;
  font-size: 28rpx;
  min-height: 70rpx;
  max-height: 140rpx;
  line-height: 1.4;
  word-wrap: break-word;
}

.emoji-btn,
.add-btn {
  background: none;
  border: none;
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-size: 32rpx;
  color: #666;
}

/* 表情选择器样式 */
.emoji-picker {
  background-color: white;
  border-top: 1rpx solid #e5e5e5;
  padding: 20rpx;
  max-height: 300rpx;
  overflow-y: auto;
}

.emoji-grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.emoji-item {
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  cursor: pointer;
  border-radius: 8rpx;
  transition: background-color 0.2s;
}

.emoji-item:hover {
  background-color: #f2f2f2;
}

.close-emoji-btn {
  background-color: #f2f2f2;
  color: #333;
  border: none;
  padding: 15rpx;
  border-radius: 8rpx;
  width: 100%;
  font-size: 28rpx;
  margin-top: 10rpx;
}

/* 适配不同屏幕尺寸 */
@media (max-width: 375px) {
  .message-container {
    max-width: 80%;
  }
  
  .text-input {
    font-size: 26rpx;
    padding: 12rpx 18rpx;
  }
  
  .message-content {
    font-size: 26rpx;
    padding: 10rpx 16rpx;
  }
}

/* 滚动条样式 */
.chat-messages::-webkit-scrollbar {
  width: 6rpx;
}

.chat-messages::-webkit-scrollbar-track {
  background: transparent;
}

.chat-messages::-webkit-scrollbar-thumb {
  background: rgba(0, 0, 0, 0.1);
  border-radius: 3rpx;
}