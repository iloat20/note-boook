<view class="page-container page-entrance" style="padding-top: {{statusBarHeight + navBarHeight}}px;">
  <!-- 标题栏 -->
  <view class="page-title animate-stagger stagger-delay-1">
    <view class="title-row">
      <view class="title-icon-wrap">
        <image class="title-icon" src="/images/title-history.svg" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- 搜索栏 (小红书风格圆角) -->
  <view class="search-bar-wrap animate-stagger stagger-delay-2">
    <view class="search-bar">
      <image src="/images/search.svg" mode="aspectFit" class="search-icon" />
      <input class="search-input" placeholder="搜索股票代码/名称..." value="{{searchKeyword}}" bindinput="onSearchInput" />
      <view wx:if="{{searchKeyword}}" class="search-clear" bindtap="clearSearch">
        <text class="search-clear-icon">✕</text>
      </view>
    </view>
  </view>

  <!-- 骨架屏 -->
  <view wx:if="{{loading}}" class="skeleton-container">
    <view class="xhs-skeleton-card" wx:for="{{[1,2,3,4]}}" wx:key="*this">
      <view class="xhs-skeleton-header">
        <view class="xhs-skeleton-tag xhs-shimmer"></view>
        <view class="xhs-skeleton-text xhs-shimmer"></view>
        <view class="xhs-skeleton-text xhs-shimmer"></view>
      </view>
      <view class="xhs-skeleton-body">
        <view class="xhs-skeleton-item xhs-shimmer"></view>
        <view class="xhs-skeleton-item xhs-shimmer"></view>
      </view>
    </view>
  </view>

  <!-- 类型筛选 (买入/卖出/分红) -->
  <liquid-slider
    class="animate-stagger stagger-delay-3"
    tabs="{{filterTabs}}"
    currentKey="{{currentFilter}}"
    bind:change="onFilterTabChange"
  />

  <!-- 市场和策略筛选 (合并为一行滑动) -->
  <scroll-view scroll-x class="filter-chips animate-stagger stagger-delay-4" enhanced show-scrollbar="{{false}}">
    <view class="chip-row">
      <!-- 市场筛选 -->
      <view
        wx:for="{{marketTabs}}"
        wx:key="key"
        class="chip {{currentMarket === item.key ? 'chip-active' : ''}}"
        bindtap="switchMarket"
        data-market="{{item.key}}"
      >{{item.label}}</view>

      <!-- 策略筛选分隔 -->
      <view wx:if="{{activeStrategies.length > 0}}" class="chip-divider"></view>

      <!-- 策略筛选 -->
      <view wx:for="{{activeStrategies}}" wx:key="tag"
            class="chip {{currentStrategy === item.tag ? 'chip-active' : ''}}"
            bindtap="switchStrategy" data-strategy="{{item.tag}}">
        {{item.tag}}
      </view>

      <!-- 批量选择 -->
      <view class="chip-divider"></view>
      <view class="chip {{selectMode ? 'chip-active chip-batch' : ''}}" bindtap="toggleSelectMode"><view class="batch-icon"></view> 批量</view>
    </view>
  </scroll-view>

  <!-- 记录列表 -->
  <scroll-view wx:if="{{groupedHistory.length > 0}}" class="scroll-container animate-stagger stagger-delay-5" scroll-y bindscrolltolower="loadMore" enhanced show-scrollbar="{{false}}">
    <view wx:for="{{groupedHistory}}" wx:key="date" class="section">
      <!-- 日期标题 (更突出) -->
      <view class="date-header">
        <view class="date-dot"></view>
        <text class="date-text">{{item.date}}</text>
      </view>

      <!-- 交易卡片 (XHS feed 风格) -->
      <view wx:for="{{item.items}}" wx:key="id" wx:for-item="record"
        class="record-card {{dissolvingId === record.id ? 'dissolving' : ''}} {{selectMode ? 'record-card-selectable' : ''}} {{selectMode && selectedMap[record.id] ? 'record-card-selected' : ''}}"
        data-record="{{record}}"
        data-id="{{record.id}}"
        data-index="{{index}}"
        bindlongpress="{{selectMode ? '' : 'showActions'}}"
        bindtap="{{selectMode ? 'onRecordTap' : ''}}"
      >
        <!-- 批量选择复选框 -->
        <view wx:if="{{selectMode}}" class="record-checkbox" catchtap="toggleSelectItem" data-id="{{record.id}}" data-type="{{record.type}}">
          <view class="xhs-checkbox {{selectedMap[record.id] ? 'xhs-checkbox-checked' : ''}}"></view>
        </view>

        <!-- 左侧: 类型色条 -->
        <view class="{{record.typeBarClass}}"></view>

        <!-- 主内容 -->
        <view class="record-main">
          <!-- 第一行: 交易信息(居左) + 买卖标签 + 时间(居右) -->
          <view class="record-top">
            <view class="record-info">
              <market-tag market="{{record.market}}" label="{{record.marketLabel}}" />
              <text class="record-code">{{record.code}}</text>
              <text class="record-name">{{record.name}}</text>
            </view>
            <view class="{{record.typeTagClass}}">
              {{record.typeText}}
            </view>
            <text class="record-time">{{record.time}}</text>
          </view>

          <!-- 第二行: 股价 × 股数 (左)  ...  金额 (右) -->
          <view wx:if="{{record.type !== 'DIVIDEND'}}" class="record-detail">
            <text class="detail-price mono-num">¥{{record.priceText}}</text>
            <text class="detail-multiply">×</text>
            <text class="detail-quantity">{{record.quantity}}股</text>
            <text class="{{record.amountClass}}">
              {{record.amountText}}
            </text>
          </view>

          <!-- 分红: 金额 (右) -->
          <view wx:if="{{record.type === 'DIVIDEND'}}" class="record-detail">
            <text class="{{record.amountClass}}">{{record.amountText}}</text>
          </view>

          <!-- 策略标签 -->
          <strategy-tags wx:if="{{record.strategies.length > 0}}" tags="{{record.strategies}}" size="mini" />
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view wx:if="{{hasMore}}" class="load-more animate-stagger stagger-delay-6" bindtap="loadMore">
      <text wx:if="{{!loadingMore}}" class="load-more-text">展开更多记录</text>
      <view wx:else class="loading-dots">
        <view class="dot"></view>
        <view class="dot"></view>
        <view class="dot"></view>
      </view>
    </view>
    <view wx:else class="no-more animate-stagger stagger-delay-6">
      <text class="no-more-text">— 已经到底了 —</text>
    </view>
    <view style="height: {{selectMode ? '300rpx' : '160rpx'}};"></view>
  </scroll-view>

  <!-- 搜索无结果 -->
  <view wx:elif="{{searchKeyword && recordCount > 0 && groupedHistory.length === 0}}" class="search-empty animate-stagger stagger-delay-5">
    <text class="search-empty-icon">🔍</text>
    <text class="search-empty-text">未找到"{{searchKeyword}}"相关记录</text>
  </view>

  <!-- 批量选择底部工具栏 -->
  <view wx:if="{{selectMode}}" class="batch-bar">
    <view class="batch-bar-inner">
      <view class="batch-left" bindtap="toggleSelectAll">
        <view class="xhs-checkbox {{selectAll ? 'xhs-checkbox-checked' : ''}}"></view>
        <text class="batch-label">全选</text>
      </view>
      <view class="batch-center">
        <text class="batch-count">已选 {{selectedIds.length}} 项</text>
      </view>
      <view class="batch-right">
        <view class="batch-btn-cancel" bindtap="toggleSelectMode">取消</view>
        <view class="batch-btn-delete {{selectedIds.length === 0 ? 'batch-btn-disabled' : ''}}" bindtap="batchDelete">
          删除 ({{selectedIds.length}})
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <empty-state wx:else icon="📝" title="暂无记录" desc="记录每一笔交易，让投资有迹可循" showSlot="{{true}}">
    <view slot="actions" class="empty-actions">
      <view class="empty-btn animate-scale-in" bindtap="goToRecord">📈 添加买入记录</view>
      <view class="empty-btn animate-scale-in" style="animation-delay: 100ms;" bindtap="goToDividend">💰 添加分红记录</view>
    </view>
  </empty-state>
</view>
