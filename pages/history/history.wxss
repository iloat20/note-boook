/* ═════════════════════════════════════════╗
   小红书风格 - 流水页 v3
   ╚════════════════════════════════════════╝ */

@import '../../styles/common.wxss';

.page-title {
  margin-bottom: var(--xhs-space-lg);
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 0 var(--page-margin);
}

.title-icon-wrap {
  display: flex;
  align-items: center;
}

.title-icon {
  width: 36rpx;
  height: 36rpx;
}

/* === 骨架屏 === */
.skeleton-container {
  padding-top: var(--page-margin);
}

/* === 搜索栏 === */
.search-bar-wrap {
  padding: 0 var(--page-margin);
  margin-bottom: var(--xhs-space-sm);
}

.search-bar {
  background: var(--xhs-bg-secondary);
  border-radius: var(--xhs-radius-pill);
  padding: var(--xhs-space-sm) var(--xhs-space-md);
  display: flex;
  align-items: center;
  gap: var(--xhs-space-sm);
  height: 72rpx;
  box-sizing: border-box;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  opacity: 0.4;
}

.search-input {
  flex: 1;
  font-size: var(--xhs-font-md);
  color: var(--xhs-title);
  height: 100%;
}

.search-input::placeholder {
  color: var(--xhs-caption-light);
}

.search-clear {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  opacity: 0.4;
}

.search-clear-icon {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
}

/* === 筛选 Chip === */
.filter-chips {
  white-space: nowrap;
  padding: 0 var(--page-margin);
  margin-bottom: var(--xhs-space-sm);
}

.chip-row {
  display: inline-flex;
  align-items: center;
  gap: var(--xhs-space-sm);
  padding: var(--xhs-space-xs) 0;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: var(--xhs-space-xs) var(--xhs-space-md);
  background: var(--xhs-bg-secondary);
  border-radius: var(--xhs-radius-pill);
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
  font-weight: var(--xhs-weight-medium);
  white-space: nowrap;
  transition: var(--xhs-transition);
}

.chip:active {
  transform: scale(0.96);
}

.chip-active {
  background: var(--xhs-primary-bg);
  color: var(--xhs-primary);
  font-weight: var(--xhs-weight-semibold);
}

.chip-divider {
  width: 1rpx;
  height: 32rpx;
  background: var(--xhs-divider);
  flex-shrink: 0;
}

.batch-icon {
  width: 14rpx;
  height: 14rpx;
  border: 2rpx solid currentColor;
  border-radius: 2rpx;
  margin-right: 6rpx;
  position: relative;
}

.batch-icon::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 6rpx;
  height: 2rpx;
  background: currentColor;
}

.chip-batch.chip-active .batch-icon {
  background: currentColor;
}

.chip-batch.chip-active .batch-icon::before {
  background: var(--xhs-primary-bg);
}

/* === 日期标题 === */
.date-header {
  display: flex;
  align-items: center;
  gap: var(--xhs-space-sm);
  margin-top: var(--xhs-space-md);
  margin-bottom: var(--xhs-space-xs);
}

.date-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--xhs-primary);
  flex-shrink: 0;
}

.date-text {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
  font-weight: var(--xhs-weight-semibold);
}

/* === 交易卡片 === */
.record-card {
  display: flex;
  background: var(--xhs-surface);
  border-radius: var(--xhs-radius-md);
  box-shadow: var(--xhs-elevation-2);
  margin-bottom: var(--xhs-space-xs);
  overflow: hidden;
  transition: var(--xhs-transition);
  position: relative;
}

.record-card:active {
  transform: scale(0.99);
}

.record-card-selectable {
  padding-left: 0;
}

.record-card-selected {
  background: var(--xhs-primary-bg);
}

.record-checkbox {
  width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.xhs-checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--xhs-caption-light);
  border-radius: var(--xhs-radius-sm);
  transition: var(--xhs-transition);
}

.xhs-checkbox-checked {
  background: var(--xhs-primary);
  border-color: var(--xhs-primary);
}

.xhs-checkbox-checked::before {
  content: '✓';
  color: white;
  font-size: 20rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.record-type-bar {
  width: 6rpx;
  flex-shrink: 0;
}

.bar-buy { background: var(--xhs-profit); }
.bar-sell { background: var(--xhs-loss); }
.bar-dividend { background: var(--xhs-primary); }

.record-main {
  flex: 1;
  padding: var(--page-margin);
  min-width: 0;
}

.record-top {
  display: flex;
  align-items: center;
  gap: var(--xhs-space-sm);
  margin-bottom: var(--xhs-space-sm);
}

.record-info {
  display: flex;
  align-items: center;
  gap: var(--xhs-space-sm);
  flex: 1;
  min-width: 0;
}

.record-code {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
  font-weight: var(--xhs-weight-medium);
  flex-shrink: 0;
}

.record-name {
  font-size: var(--xhs-font-md);
  color: var(--xhs-title);
  font-weight: var(--xhs-weight-semibold);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-time {
  font-size: var(--xhs-font-xs);
  color: var(--xhs-caption);
  flex-shrink: 0;
}

/* === 完整交易明细行 === */
.record-detail {
  display: flex;
  align-items: flex-end;
  margin-bottom: var(--xhs-space-xs);
  line-height: 1;
}

.detail-price {
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-profit);
}

.detail-multiply {
  font-size: var(--xhs-font-md);
  color: var(--xhs-caption);
  margin: 0 4rpx;
}

.detail-quantity {
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
}

.detail-amount {
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-semibold);
  margin-left: auto;
  flex-shrink: 0;
}

.detail-amount.dividend {
  color: var(--xhs-primary);
}

/* Tag */
.type-tag {
  flex-shrink: 0;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 3px 10px;
  border-radius: var(--xhs-radius-pill);
  font-size: var(--xhs-font-xs);
  font-weight: var(--xhs-weight-medium);
  line-height: 1.2;
  flex-shrink: 0;
}

.tag-buy {
  background: var(--xhs-profit-bg);
  color: var(--xhs-profit);
}

.tag-sell {
  background: var(--xhs-loss-bg);
  color: var(--xhs-loss);
}

.tag-dividend {
  background: var(--xhs-primary-bg);
  color: var(--xhs-primary);
}

/* === 删除动画 (keyframes defined in app.wxss) === */
.dissolving {
  animation: dissolve-out 350ms ease-in forwards;
  pointer-events: none;
}

/* === 批量工具栏 === */
.batch-bar {
  position: fixed;
  bottom: calc(104rpx + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  background: var(--xhs-surface);
  border-top: 1rpx solid var(--xhs-divider);
  z-index: 998;
  animation: slide-up 250ms ease-out;
}

@keyframes slide-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.batch-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--xhs-space-md) var(--page-margin);
  height: 100rpx;
}

.batch-left {
  display: flex;
  align-items: center;
  gap: var(--xhs-space-sm);
}

.batch-label {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
  font-weight: var(--xhs-weight-medium);
}

.batch-center {
  flex: 1;
  text-align: center;
}

.batch-count {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
}

.batch-right {
  display: flex;
  align-items: center;
  gap: var(--xhs-space-md);
}

.batch-btn-cancel {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
  font-weight: var(--xhs-weight-medium);
  padding: var(--xhs-space-sm) var(--xhs-space-md);
}

.batch-btn-delete {
  background: var(--xhs-primary);
  color: white;
  font-size: var(--xhs-font-sm);
  font-weight: var(--xhs-weight-semibold);
  padding: var(--xhs-space-sm) var(--page-margin);
  border-radius: var(--xhs-radius-pill);
}

.batch-btn-disabled {
  background: var(--xhs-bg-tertiary);
  color: var(--xhs-caption);
}

/* === 加载更多 === */
.load-more {
  text-align: center;
  padding: var(--page-margin);
}

.load-more-text {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
}

.loading-dots {
  display: inline-flex;
  gap: 8rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--xhs-caption-light);
  animation: dot-bounce 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes dot-bounce {
  0%, 80%, 100% {
    transform: scale(0);
  }
  40% {
    transform: scale(1);
  }
}

/* === 空状态 === */
.empty-actions {
  margin-top: var(--page-margin);
  display: flex;
  flex-direction: column;
  gap: var(--xhs-space-sm);
  width: 100%;
}

.empty-btn {
  background: var(--xhs-surface);
  color: var(--xhs-title);
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-semibold);
  border-radius: var(--xhs-radius-md);
  padding: var(--xhs-space-md) var(--page-margin);
  text-align: center;
  border: 1px solid var(--xhs-divider);
  transition: var(--xhs-transition);
}

.empty-btn:active {
  transform: scale(0.98);
  background: var(--xhs-bg-secondary);
}

/* === Scroll === */
.scroll-container {
  height: auto;
  flex: 1;
  min-height: 0;
}

/* === 搜索无结果 === */
.search-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx var(--page-margin);
  gap: var(--xhs-space-md);
}

.search-empty-icon {
  font-size: 80rpx;
  opacity: 0.6;
}

.search-empty-text {
  font-size: var(--xhs-font-md);
  color: var(--xhs-caption);
}
