/* ═════════════════════════════════════════╗
   小红书风格 - 流水页 v3
   ╚════════════════════════════════════════╝ */

@import '../../styles/common.wxss';

.page-title {
  margin-bottom: var(--xhs-space-lg);
}

/* === 骨架屏 === */
.skeleton-container {
  padding-top: var(--xhs-space-md);
}

.page-title-text {
  font-size: var(--xhs-font-4xl);
  font-weight: var(--xhs-weight-bold);
  color: var(--xhs-title);
  letter-spacing: -0.02em;
  line-height: 1.15;
}

/* === 搜索栏 === */
.search-bar-wrap {
  margin-bottom: var(--xhs-space-md);
}

.search-bar {
  display: flex;
  align-items: center;
  gap: var(--xhs-space-sm);
  background: var(--xhs-bg-secondary);
  border-radius: var(--xhs-radius-pill);
  padding: 0 var(--xhs-space-md);
  height: 80rpx;
  transition: var(--xhs-transition);
}

.search-bar:focus-within {
  background: var(--xhs-surface);
  border: 1px solid var(--xhs-primary);
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.4;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: var(--xhs-font-md);
  color: var(--xhs-title);
  background: transparent;
  height: 80rpx;
  padding: 0;
}

.search-input::placeholder {
  color: var(--xhs-caption-light);
}

.search-clear {
  padding: var(--xhs-space-sm);
  margin: calc(-1 * var(--xhs-space-sm));
}

.search-clear-icon {
  font-size: 28rpx;
  color: var(--xhs-caption-light);
}

/* === 筛选 (合并一行滑动) === */
.filter-chips {
  overflow-x: auto;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
  margin-bottom: var(--xhs-space-lg);
  padding-bottom: var(--xhs-space-xs);
  scrollbar-width: none;
  mask-image: linear-gradient(to right, black calc(100% - 40px), transparent 100%);
  -webkit-mask-image: linear-gradient(to right, black calc(100% - 40px), transparent 100%);
}

.filter-chips::-webkit-scrollbar {
  display: none;
}

.chip-row {
  display: flex;
  gap: var(--xhs-space-sm);
  align-items: center;
}

.chip-batch {
  color: var(--xhs-primary) !important;
  display: inline-flex;
  align-items: center;
  gap: var(--xhs-space-xs);
}

/* 批量图标 */
.batch-icon {
  display: inline-block;
  position: relative;
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

.batch-icon::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 24rpx;
  height: 24rpx;
  border: 2rpx solid currentColor;
  border-radius: 5rpx;
  box-sizing: border-box;
}

.batch-icon::after {
  content: '';
  position: absolute;
  top: 7rpx;
  left: 5rpx;
  right: 5rpx;
  height: 2rpx;
  background: currentColor;
  border-radius: 1rpx;
  box-shadow: 0 6rpx 0 currentColor;
}

.chip-divider {
  width: 1px;
  height: 24px;
  background: var(--xhs-divider-strong);
  flex-shrink: 0;
}

/* === 日期标题 === */
.section {
  margin-bottom: var(--xhs-space-xl);
}

.date-header {
  display: flex;
  align-items: center;
  gap: var(--xhs-space-sm);
  margin-bottom: var(--xhs-space-md);
}

.date-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--xhs-primary);
  flex-shrink: 0;
}

.date-text {
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
  letter-spacing: 0.01em;
}

/* === 交易卡片 === */
.record-card {
  background: var(--xhs-surface);
  border-radius: var(--xhs-radius-md);
  box-shadow: var(--xhs-elevation-2);
  margin-bottom: var(--xhs-space-md);
  display: flex;
  overflow: hidden;
  transition: var(--xhs-transition-slow);
  position: relative;
}

.record-card:active {
  transform: scale(0.98);
  box-shadow: var(--xhs-elevation-3);
}

.record-type-bar {
  width: 6rpx;
  flex-shrink: 0;
}

.bar-buy {
  background: var(--xhs-profit);
}

.bar-sell {
  background: var(--xhs-loss);
}

.bar-dividend {
  background: var(--xhs-dividend);
}

.record-main {
  flex: 1;
  padding: var(--xhs-space-md);
}

.record-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--xhs-space-sm);
}

.record-info {
  display: flex;
  align-items: center;
  gap: var(--xhs-space-sm);
  flex: 1;
  min-width: 0;
  flex-wrap: wrap;
}

.record-code {
  font-size: var(--xhs-font-lg);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
}

.record-name {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-time {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
}

.record-amount {
  font-size: var(--xhs-font-xl);
  font-weight: var(--xhs-weight-semibold);
  letter-spacing: 0.01em;
}

/* === 类型标签 === */
.type-tag {
  margin-left: auto;
  flex-shrink: 0;
}

/* === 策略标签 === */
.strategy-tag-mini {
  display: inline-block;
  padding: 2px 8px;
  border-radius: var(--xhs-radius-pill);
  font-size: var(--xhs-font-xs);
  background: var(--xhs-primary-bg);
  color: var(--xhs-primary);
  font-weight: var(--xhs-weight-medium);
}

.strategy-tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: var(--xhs-space-xs);
  margin-top: var(--xhs-space-sm);
}

/* === 加载更多 === */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--xhs-space-lg);
  margin: var(--xhs-space-md) 0;
  background: var(--xhs-bg-secondary);
  border-radius: var(--xhs-radius-pill);
  transition: var(--xhs-transition);
}

.load-more:active {
  transform: scale(0.97);
  background: var(--xhs-divider-strong);
}

.load-more-text {
  font-size: var(--xhs-font-md);
  color: var(--xhs-primary);
  font-weight: var(--xhs-weight-medium);
}

/* === 加载动画 === */
.loading-dots {
  display: flex;
  gap: var(--xhs-space-xxs);
  align-items: center;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--xhs-primary);
  opacity: 0.5;
  animation: dotPulse 1.4s infinite ease-in-out;
}

.dot:first-child { animation-delay: 0s; }
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:last-child { animation-delay: 0.4s; }

@keyframes dotPulse {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.4;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* === 没有更多数据 === */
.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--xhs-space-xl) var(--xhs-space-lg);
}

.no-more-text {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption-light);
}

/* === 空状态按钮 === */
.empty-actions {
  margin-top: var(--xhs-space-xl);
  display: flex;
  gap: var(--xhs-space-md);
}

.empty-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--xhs-space-xs);
  padding: var(--xhs-space-sm) var(--xhs-space-xl);
  background: var(--xhs-surface);
  border: 1px solid var(--xhs-divider-strong);
  border-radius: var(--xhs-radius-pill);
  font-size: var(--xhs-font-md);
  color: var(--xhs-title);
  font-weight: var(--xhs-weight-medium);
  transition: var(--xhs-transition);
  min-height: 80rpx;
}

.empty-btn:active {
  background: var(--xhs-bg-secondary);
  transform: scale(0.97);
}

/* === 批量选择模式 === */
.batch-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: var(--xhs-z-overlay);
  padding: 0 var(--xhs-space-lg);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, var(--xhs-surface) 60%, transparent);
  pointer-events: none;
}

.batch-bar-inner {
  background: var(--xhs-surface);
  border-radius: var(--xhs-radius-lg);
  box-shadow: var(--xhs-elevation-top);
  padding: var(--xhs-space-sm) var(--xhs-space-md);
  display: flex;
  align-items: center;
  pointer-events: auto;
}

.batch-left {
  display: flex;
  align-items: center;
  gap: var(--xhs-space-xs);
  padding: var(--xhs-space-xs) 0;
  flex-shrink: 0;
}

.batch-label {
  font-size: var(--xhs-font-md);
  color: var(--xhs-title);
  font-weight: var(--xhs-weight-medium);
}

.batch-center {
  flex: 1;
  text-align: center;
}

.batch-count {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
}

.batch-right {
  display: flex;
  align-items: center;
  gap: var(--xhs-space-sm);
  flex-shrink: 0;
}

.batch-btn-cancel {
  padding: 14rpx 24rpx;
  font-size: var(--xhs-font-md);
  color: var(--xhs-caption);
  font-weight: var(--xhs-weight-medium);
  border-radius: var(--xhs-radius-pill);
  transition: var(--xhs-transition);
}

.batch-btn-cancel:active {
  background: var(--xhs-bg-secondary);
}

.batch-btn-delete {
  padding: 14rpx 28rpx;
  font-size: var(--xhs-font-md);
  color: #FFFFFF;
  font-weight: var(--xhs-weight-semibold);
  background: var(--xhs-primary);
  border-radius: var(--xhs-radius-pill);
  transition: var(--xhs-transition);
}

.batch-btn-delete:active {
  opacity: 0.85;
  transform: scale(0.95);
}

.batch-btn-disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* === XHS 风格复选框 === */
.xhs-checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2px solid var(--xhs-caption-light);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--xhs-transition);
  flex-shrink: 0;
  box-sizing: border-box;
  background: var(--xhs-surface);
}

.xhs-checkbox-checked {
  background: var(--xhs-primary);
  border-color: var(--xhs-primary);
  position: relative;
}

.xhs-checkbox-checked::after {
  content: '✓';
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  line-height: 1;
}

.record-checkbox {
  display: flex;
  align-items: center;
  padding: 0 var(--xhs-space-xs) 0 var(--xhs-space-sm);
  flex-shrink: 0;
}

/* === 卡片选择态 === */
.record-card-selectable {
  cursor: pointer;
}

.record-card-selected {
  box-shadow: var(--xhs-elevation-3);
  position: relative;
}

.record-card-selected::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: var(--xhs-primary);
  border-radius: 6rpx 0 0 6rpx;
  z-index: 2;
}

.record-card-selected .record-main {
  background: var(--xhs-primary-bg);
}
