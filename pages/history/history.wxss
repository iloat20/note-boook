/* 流水页 iOS 26.5 Frosted Glass */

/* 第一排：买入/卖出/分红 */
.liquid-slider-bg {
  background: var(--glass-bg) !important;
  backdrop-filter: blur(16px) !important;
  -webkit-backdrop-filter: blur(16px) !important;
  border: 0.5px solid var(--glass-border) !important;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06), inset 0 0.5px 0 rgba(255, 255, 255, 0.7) !important;
}
.liquid-slider-item.active {
  color: var(--color-accent) !important;
}

/* 第二排：全部/A股/港股/美股 */
.chip-active {
  background: rgba(255, 59, 48, 0.15) !important;
  color: #FF3B30 !important;
  border-color: rgba(255, 59, 48, 0.25) !important;
}

/* === 加载更多按钮 (Frosted Glass) === */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  margin: 16px 0;
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-radius: 12px;
  border: 0.5px solid var(--glass-border);
  transition: opacity 200ms ease;
}

/* === 加载动画 === */
.loading-dots {
  display: flex;
  gap: 4px;
  align-items: center;
}

.dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: rgba(255, 59, 48, 0.5);
  animation: dotPulse 1.4s infinite ease-in-out;
}

.dot:first-child { animation-delay: 0s; }
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:last-child { animation-delay: 0.4s; }

@keyframes dotPulse {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.4;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* === 没有更多数据 === */
.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px 16px;
  opacity: 0.5;
}

/* === Strategy tags (Frosted Glass) === */
.strategy-tag-mini {
  display: inline-block;
  padding: 1px 6px;
  border-radius: 3px;
  font-size: 10px;
  background: rgba(255, 59, 48, 0.08);
  color: var(--color-accent);
}
