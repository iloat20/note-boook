<view class="page-container" style="padding-top: {{statusBarHeight + navBarHeight}}px;">
  <!-- 骨架屏 -->
  <view wx:if="{{loading}}" class="xhs-skeleton">
    <view class="xhs-skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="xhs-skeleton-header">
        <view class="xhs-skeleton-tag xhs-shimmer"></view>
        <view class="xhs-skeleton-text xhs-shimmer"></view>
        <view class="xhs-skeleton-text xhs-shimmer"></view>
      </view>
      <view class="xhs-skeleton-body">
        <view class="xhs-skeleton-item xhs-shimmer"></view>
        <view class="xhs-skeleton-item xhs-shimmer"></view>
        <view class="xhs-skeleton-item xhs-shimmer"></view>
      </view>
    </view>
  </view>

  <!-- 非加载状态 -->
  <block wx:else>
    <!-- 标题栏（仅间距） -->
    <view class="page-title"></view>

    <!-- 汇总卡片 -->
    <view class="summary-card card" style="margin-bottom: var(--xhs-space-lg);">
      <view style="display: flex; align-items: center; gap: var(--xhs-space-xs); margin-bottom: var(--xhs-space-md);">
        <text class="caption">总市值</text>
        <view bindtap="onSharePortfolio" style="display: flex; align-items: center; padding: 2px;">
          <image src="/images/share.svg" mode="aspectFit" lazy-load="{{true}}" style="width: 24rpx; height: 24rpx; opacity: 0.4;" />
        </view>
      </view>
      <text class="title mono-num" style="color: var(--xhs-title);">{{summaryCurrency}}{{displayValues.totalMarketValue}}</text>
    </view>

    <!-- 市场筛选 -->
    <liquid-slider
      tabs="{{marketTabs}}"
      currentKey="{{currentMarket}}"
      showCount="{{true}}"
      bind:change="onMarketTabChange"
      style="margin-bottom: 16px;"
    />

    <!-- 持仓列表 -->
    <scroll-view wx:if="{{positions.length > 0}}" class="scroll-container {{tabAnimating ? 'tab-content-exit' : ''}}" scroll-y style="height: {{scrollHeight}}px;">
      <view wx:for="{{positions}}" wx:key="id" class="swipe-container">
        <view class="swipe-actions {{item.swipeOpen ? 'swipe-actions-open' : ''}}">
          <view class="swipe-action-btn swipe-action-edit" data-stock-id="{{item.id}}" catchtap="onSwipeEdit">
            <view style="display: flex; flex-direction: column; align-items: center; gap: 2px;">
              <text>编辑</text>
              <text style="font-size: 18rpx; opacity: 0.8;">{{item.quantityText}}股</text>
            </view>
          </view>
          <view class="swipe-action-btn swipe-action-sell" data-stock-id="{{item.id}}" catchtap="onSwipeSell">
            <view style="display: flex; flex-direction: column; align-items: center; gap: 2px;">
              <text>卖出</text>
              <text wx:if="{{item.quantity > 0}}" style="font-size: 18rpx; opacity: 0.8;">可卖{{item.quantityText}}</text>
            </view>
          </view>
          <view class="swipe-action-btn swipe-action-delete" data-stock-id="{{item.id}}" catchtap="onSwipeDelete">删除</view>
        </view>
        <view class="position-card {{item.swipeOpen ? 'swipe-card-open' : ''}} {{item.id === deletingId ? 'position-card-deleting' : ''}} {{item.entering ? 'position-card-entering' : ''}}"
          style="transform: translateX({{item.swipeOffset || 0}}px);"
          bindtouchstart="onTouchStart"
          bindtouchmove="onTouchMove"
          bindtouchend="onTouchEnd"
          bindtap="goToDetail"
          data-stock-id="{{item.id}}"
          data-index="{{index}}">
          <view style="display: flex; align-items: center; gap: var(--xhs-space-sm); margin-bottom: var(--xhs-space-md);">
            <market-tag market="{{item.market}}" label="{{item.marketLabel}}" />
            <text class="stock-code">{{item.code}}</text>
            <text class="stock-name">{{item.name}}</text>
          </view>

          <view style="display: flex; gap: var(--xhs-space-md); margin-bottom: var(--xhs-space-md); align-items: flex-start;">
            <view style="flex: 1;">
              <text class="caption">持仓</text>
              <view class="mono-num" style="color: var(--xhs-title);">{{item.quantityText}}股</view>
            </view>
            <view style="flex: 1;">
              <text class="caption">成本</text>
              <view class="mono-num" style="color: var(--xhs-title);">{{item.avgCostText}}</view>
            </view>
            <view style="flex: 1;">
              <text class="caption">现价</text>
              <view class="mono-num {{item.priceFlashClass}}" style="color: var(--xhs-title); display: flex; align-items: center; gap: var(--xhs-space-xs);">
                <text wx:if="{{item.currentPrice > 0}}">{{item.currentPriceText}}</text>
                <text wx:else style="color: var(--xhs-caption);">--</text>
                <view
                  class="refresh-btn"
                  data-stock-id="{{item.id}}"
                  catchtap="onRefreshPrice"
                >
                  <text class="refresh-icon">↻</text>
                </view>
              </view>
            </view>
          </view>

          <view style="display: flex; justify-content: space-between; align-items: center; padding-top: var(--xhs-space-md); border-top: 1px solid var(--xhs-divider);">
            <text class="mono-num {{item.floatingPnL >= 0 ? 'profit' : 'loss'}}">
              {{item.floatingPnL >= 0 ? '+' : ''}}{{item.floatingPnLText}}
            </text>
            <text class="caption mono-num {{item.floatingPnL >= 0 ? 'profit' : 'loss'}}">
              {{item.pnlPercentText}}%
            </text>
          </view>
        </view>
      </view>
      <view style="height: 160rpx;"></view>
    </scroll-view>

    <!-- 空状态 -->
    <empty-state 
      wx:if="{{positions.length === 0}}"
      icon="📊"
      title="暂无持仓"
      desc="点击右下角 + 按钮添加第一笔交易"
      showSlot="{{true}}"
    >
      <view slot="actions" style="margin-top: var(--xhs-space-xl); padding: var(--xhs-space-lg) var(--xhs-space-xl); background: var(--xhs-surface); border-radius: var(--xhs-radius-md); box-shadow: var(--xhs-card-shadow);">
        <text class="caption" style="color: var(--xhs-caption);">💡 小贴士</text>
        <text class="caption" style="display: block; margin-top: 8px; line-height: 1.6;">添加买入记录后，系统会自动计算持仓成本和浮动盈亏</text>
      </view>
    </empty-state>

    <!-- 添加按钮 -->
    <view class="fab {{showQuickRecord ? 'fab-hidden' : ''}}" bindtap="onQuickRecord" bindlongpress="goToAddTransaction">+</view>
  </block>

  <quick-record visible="{{showQuickRecord}}" bind:close="onQuickRecordClose" bind:submit="onQuickRecordSubmit" />

  <!-- 隐藏 canvas 用于生成分享图 -->
  <canvas type="2d" id="shareCanvas" style="position: fixed; left: -9999px; top: 0; width: 375px; height: 667px;"></canvas>
</view>
