<view class="page-container {{entranceDone ? '' : 'page-entrance'}}" style="padding-top: {{statusBarHeight + navBarHeight}}px;">
  <!-- 骨架屏 -->
  <view wx:if="{{loading}}" class="xhs-skeleton">
    <view class="xhs-skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="xhs-skeleton-header">
        <view class="xhs-skeleton-tag xhs-shimmer"></view>
        <view class="xhs-skeleton-text xhs-shimmer"></view>
        <view class="xhs-skeleton-text xhs-shimmer"></view>
      </view>
      <view class="xhs-skeleton-body">
        <view class="xhs-skeleton-item xhs-shimmer"></view>
        <view class="xhs-skeleton-item xhs-shimmer"></view>
        <view class="xhs-skeleton-item xhs-shimmer"></view>
      </view>
    </view>
  </view>

  <!-- 非加载状态 -->
  <block wx:else>
    <!-- 标题栏 -->
    <view class="page-title {{entranceDone ? '' : 'animate-stagger'}}" style="{{entranceDone ? '' : 'animation-delay:80ms'}}">
      <view class="title-row">
        <view class="title-icon-wrap">
          <image class="title-icon" src="/images/title-portfolio.svg" mode="aspectFit" />
        </view>
        <text class="page-subtitle">{{currentDate}}</text>
      </view>
    </view>

    <!-- 汇总卡片 -->
    <view class="summary-card {{entranceDone ? '' : 'animate-stagger'}}" style="margin-bottom: var(--xhs-space-lg);{{entranceDone ? '' : 'animation-delay:160ms'}}">
      <!-- 汇总 -->
      <view class="summary-header">
        <view class="summary-label">总资产（元）</view>
        <view class="summary-value">{{displayValues.totalMarketValue}}</view>
      </view>

      <!-- 分割线 -->
      <view class="summary-divider"></view>

      <!-- 统计信息 -->
      <view class="summary-stats">
        <view class="summary-stat">
          <text class="stat-label">资产变动</text>
          <text class="stat-value {{totalPnL >= 0 ? 'profit' : 'loss'}}">{{displayValues.totalPnL}}</text>
        </view>
        <view class="summary-stat">
          <text class="stat-label">变动幅度</text>
          <text class="stat-value {{totalPnLPercent >= 0 ? 'profit' : 'loss'}}">{{totalPnLPercent >= 0 ? '+' : ''}}{{displayValues.totalPnLPercent}}%</text>
        </view>
        <view class="summary-stat">
          <text class="stat-label">资产</text>
          <text class="stat-value">{{positionCount}}只</text>
        </view>
      </view>

      <!-- 刷新全部按钮 -->
      <view class="refresh-all-btn" bindtap="onRefreshAll">
        <text class="refresh-all-icon">↻</text>
      </view>
      <!-- 分享按钮 -->
      <view class="share-btn" bindtap="onSharePortfolio">
        <image src="/images/share.svg" mode="aspectFit" style="width: 32rpx; height: 32rpx;" />
      </view>
    </view>

    <!-- 资产列表 -->
    <scroll-view wx:if="{{positionCount > 0}}" class="scroll-container {{tabAnimating ? 'tab-content-exit' : ''}}" scroll-y style="height: {{scrollHeight}}px;" bindscroll="_onSwipeScroll" bindscrolltolower="loadMorePositions">
      <view wx:for="{{displayPositions}}" wx:key="id" class="swipe-container">
        <view class="swipe-actions {{item.swipeOpen ? 'swipe-actions-open' : ''}} {{item.swiping ? 'swipe-actions-hiding' : ''}}">
          <view class="swipe-action-btn swipe-action-edit" data-stock-id="{{item.id}}" catchtap="onSwipeEdit">
            <view class="swipe-action-content">
              <image class="swipe-action-icon" src="/images/swipe-edit.svg" mode="aspectFit" />
              <text class="swipe-action-label">编辑</text>
            </view>
          </view>
          <view class="swipe-action-btn swipe-action-sell" data-stock-id="{{item.id}}" catchtap="onSwipeSell">
            <view class="swipe-action-content">
              <image class="swipe-action-icon" src="/images/swipe-sell.svg" mode="aspectFit" />
              <text class="swipe-action-label">转出</text>
              <text wx:if="{{item.quantity > 0}}" class="swipe-action-sub">可转{{item.quantityText}}</text>
            </view>
          </view>
          <view class="swipe-action-btn swipe-action-delete" data-stock-id="{{item.id}}" catchtap="onSwipeDelete">
            <view class="swipe-action-content">
              <image class="swipe-action-icon" src="/images/swipe-delete.svg" mode="aspectFit" />
              <text class="swipe-action-label">删除</text>
            </view>
          </view>
        </view>
        <view class="position-card {{item.entering ? 'position-card-entering' : ''}} {{item.priceFlashClass}} {{item.swiping ? 'is-swiping' : ''}} {{item.id === deletingId ? 'position-card-deleting' : ''}} {{sortMode && item.id === draggingId ? 'dragging' : ''}}"
          style="transform: translateX({{item.swipeOffset || 0}}px) {{item.dragOffset ? 'translateY(' + item.dragOffset + 'px)' : ''}};"
          bindtouchstart="onTouchStart"
          bindtouchmove="onTouchMove"
          bindtouchend="onTouchEnd"
          bindtap="goToDetail"
          bindlongpress="onPositionLongPress"
          data-stock-id="{{item.id}}"
          data-index="{{index}}">
          <!-- 排序模式拖拽手柄 -->
          <view wx:if="{{sortMode}}" class="drag-handle" data-stock-id="{{item.id}}" data-index="{{index}}" catchtouchstart="onDragStart" catchtouchmove="onDragMove" catchtouchend="onDragEnd">⠿</view>

          <view class="position-header-row">
            <text class="stock-code">{{item.code}}</text>
            <text class="stock-name">{{item.name}}</text>
          </view>

          <!-- 资产占比迷你条 -->
          <view class="ratio-bar" wx:if="{{item.ratioPct > 0}}">
            <view class="ratio-fill" style="width: {{item.ratioPct}}%;"></view>
            <text class="ratio-text">{{item.ratioPct}}%</text>
          </view>

          <view class="position-data-row">
            <view style="flex: 1;">
              <text class="caption">持有</text>
              <view class="mono-num" style="color: var(--xhs-title);">{{item.quantityText}}份</view>
            </view>
            <view style="flex: 1;">
              <text class="caption">成本</text>
              <view class="mono-num" style="color: var(--xhs-title);">{{item.avgCostText}}</view>
            </view>
            <view style="flex: 1;">
              <text class="caption">当前价值</text>
              <view class="mono-num" style="color: var(--xhs-title); display: flex; align-items: center; gap: var(--xhs-space-xs);">
                <!-- [优化] 预计算 displayPriceText，消除 wx:if/wx:else -->
                <text>{{item.displayPriceText}}</text>
                <view
                  class="refresh-btn"
                  data-stock-id="{{item.id}}"
                  catchtap="onRefreshPrice"
                >
                  <text class="refresh-icon">↻</text>
                </view>
              </view>
            </view>
          </view>

          <view class="position-pnl-row">
            <view class="mono-num {{item.floatingPnL >= 0 ? 'profit' : 'loss'}}" style="align-items: center;">
              {{item.floatingPnLText}}
            </view>
            <view class="profit-badge {{item.floatingPnL >= 0 ? 'profit' : 'loss'}}">
              <text class="mono-num">{{item.pnlPercentText}}%</text>
            </view>
          </view>

          <!-- 标签 / 备注 -->
          <view class="card-tags" wx:if="{{item.tags.length > 0}}">
            <text wx:for="{{item.tags}}" wx:key="*this" class="card-tag">{{item}}</text>
          </view>
          <view class="card-note" wx:if="{{item.note}}">{{item.note}}</view>
        </view>
      </view>
      <view style="height: 160rpx;"></view>
    </scroll-view>

    <!-- 空状态 -->
    <empty-state
      wx:if="{{positionCount === 0}}"
      class="{{entranceDone ? '' : 'animate-stagger'}}"
      style="{{entranceDone ? '' : 'animation-delay:320ms'}}"
      icon="📒"
      title="开始记录吧！"
    >
    </empty-state>

    <!-- 排序模式完成栏 -->
    <view wx:if="{{sortMode}}" class="sort-bar">
      <text class="sort-tip">拖动 ⠿ 调整顺序</text>
      <view class="sort-done" bindtap="exitSortMode">完成</view>
    </view>

    <!-- 添加按钮 -->
    <view class="fab {{showQuickRecord || sortMode ? 'fab-hidden' : ''}}" bindtap="onQuickRecord" bindlongpress="goToAddTransaction">+</view>
  </block>

  <quick-record visible="{{showQuickRecord}}" bind:close="onQuickRecordClose" bind:submit="onQuickRecordSubmit" />

  <!-- 单资产备注 / 标签面板 -->
  <view wx:if="{{assetMeta.visible}}" class="meta-mask" bindtap="closeAssetMeta"></view>
  <view wx:if="{{assetMeta.visible}}" class="meta-sheet">
    <view class="meta-header">
      <text class="meta-title">备注 / 标签</text>
      <view class="meta-close" bindtap="closeAssetMeta">
        <text class="meta-close-icon">✕</text>
      </view>
    </view>
    <view class="meta-body">
      <view class="meta-field">
        <text class="meta-label">标签</text>
        <view class="meta-tag-list">
          <view wx:for="{{assetMeta.tags}}" wx:key="*this" class="meta-tag" data-tag="{{item}}" bindtap="onMetaRemoveTag">{{item}} ×</view>
          <input class="meta-tag-input" placeholder="输入标签" value="{{assetMeta.tagInput}}" bindinput="onMetaTagInput" bindconfirm="onMetaAddTag" />
          <view class="meta-tag-add" bindtap="onMetaAddTag">+ 添加</view>
        </view>
      </view>
      <view class="meta-field">
        <text class="meta-label">备注</text>
        <textarea class="meta-textarea" placeholder="记录说明（选填）" value="{{assetMeta.note}}" bindinput="onMetaNoteInput" />
      </view>
    </view>
    <view class="meta-footer">
      <view class="meta-cancel" bindtap="closeAssetMeta">取消</view>
      <view class="meta-save" bindtap="saveAssetMeta">保存</view>
    </view>
  </view>

  <!-- 隐藏 canvas 用于生成分享图 -->
  <canvas wx:if="{{generatingShare}}" type="2d" id="shareCanvas" style="position: fixed; left: -9999px; top: 0; width: 1px; height: 1px;"></canvas>
</view>
