<view class="page-container {{entranceDone ? '' : 'page-entrance'}}" style="padding-top: {{statusBarHeight + navBarHeight}}px;">
  <!-- 骨架屏 -->
  <view wx:if="{{loading}}" class="xhs-skeleton">
    <view class="xhs-skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="xhs-skeleton-header">
        <view class="xhs-skeleton-tag xhs-shimmer"></view>
        <view class="xhs-skeleton-text xhs-shimmer"></view>
        <view class="xhs-skeleton-text xhs-shimmer"></view>
      </view>
      <view class="xhs-skeleton-body">
        <view class="xhs-skeleton-item xhs-shimmer"></view>
        <view class="xhs-skeleton-item xhs-shimmer"></view>
        <view class="xhs-skeleton-item xhs-shimmer"></view>
      </view>
    </view>
  </view>

  <!-- 非加载状态 -->
  <block wx:else>
    <!-- 标题栏 -->
    <view class="page-title {{entranceDone ? '' : 'animate-stagger'}}" style="{{entranceDone ? '' : 'animation-delay:80ms'}}">
      <view class="title-row">
        <view class="title-icon-wrap">
          <image class="title-icon" src="/images/title-portfolio.svg" mode="aspectFit" />
        </view>
        <text class="page-subtitle">{{currentDate}}</text>
      </view>
    </view>

    <!-- 汇总卡片 -->
    <view class="summary-card {{entranceDone ? '' : 'animate-stagger'}}" style="margin-bottom: var(--xhs-space-lg);{{entranceDone ? '' : 'animation-delay:160ms'}}">
      <!-- 总市值 -->
      <view class="summary-header">
        <view class="summary-label">总市值（元）</view>
        <view class="summary-value">{{displayValues.totalMarketValue}}</view>
      </view>
      
      <!-- 分割线 -->
      <view class="summary-divider"></view>
      
      <!-- 统计信息 -->
      <view class="summary-stats">
        <view class="summary-stat">
          <text class="stat-label">总盈亏</text>
          <text class="stat-value {{totalPnL >= 0 ? 'profit' : 'loss'}}">{{displayValues.totalPnL}}</text>
        </view>
        <view class="summary-stat">
          <text class="stat-label">收益率</text>
          <text class="stat-value {{totalPnLPercent >= 0 ? 'profit' : 'loss'}}">{{totalPnLPercent >= 0 ? '+' : ''}}{{displayValues.totalPnLPercent}}%</text>
        </view>
        <view class="summary-stat">
          <text class="stat-label">持仓</text>
          <text class="stat-value">{{positionCount}}只</text>
        </view>
      </view>
      
      <!-- 分享按钮 -->
      <view class="share-btn" bindtap="onSharePortfolio">
        <image src="/images/share.svg" mode="aspectFit" style="width: 32rpx; height: 32rpx;" />
      </view>
    </view>

    <!-- 市场筛选 -->
    <liquid-slider
      class="{{entranceDone ? '' : 'animate-stagger'}}"
      tabs="{{marketTabs}}"
      currentKey="{{currentMarket}}"
      showCount="{{true}}"
      bind:change="onMarketTabChange"
      style="margin-bottom: 16px;{{entranceDone ? '' : 'animation-delay:240ms'}}"
    />

    <!-- 持仓列表 -->
    <scroll-view wx:if="{{positionCount > 0}}" class="scroll-container {{tabAnimating ? 'tab-content-exit' : ''}}" scroll-y style="height: {{scrollHeight}}px;" bindscrolltolower="loadMorePositions">
      <view wx:for="{{displayPositions}}" wx:key="id" class="swipe-container">
        <view class="swipe-actions {{item.swipeOpen ? 'swipe-actions-open' : ''}}">
          <view class="swipe-action-btn swipe-action-edit" data-stock-id="{{item.id}}" catchtap="onSwipeEdit">
            <view class="swipe-action-content">
              <text>编辑</text>
              <text class="swipe-action-sub">{{item.quantityText}}股</text>
            </view>
          </view>
          <view class="swipe-action-btn swipe-action-sell" data-stock-id="{{item.id}}" catchtap="onSwipeSell">
            <view class="swipe-action-content">
              <text>卖出</text>
              <text wx:if="{{item.quantity > 0}}" class="swipe-action-sub">可卖{{item.quantityText}}</text>
            </view>
          </view>
          <view class="swipe-action-btn swipe-action-delete" data-stock-id="{{item.id}}" catchtap="onSwipeDelete">删除</view>
        </view>
        <view class="{{item.cardClass}} {{item.id === deletingId ? 'position-card-deleting' : ''}}"
          style="transform: translateX({{item.swipeOffset || 0}}px);"
          bindtouchstart="onTouchStart"
          bindtouchmove="onTouchMove"
          bindtouchend="onTouchEnd"
          bindtap="goToDetail"
          bindlongpress="onPositionLongPress"
          data-stock-id="{{item.id}}"
          data-index="{{index}}">
          <view class="position-header-row">
            <!-- [优化] 内联 market-tag 组件，减少组件实例化开销 -->
            <view class="{{item.marketClass}}">{{item.marketLabel}}</view>
            <text class="stock-code">{{item.code}}</text>
            <text class="stock-name">{{item.name}}</text>
          </view>

          <view class="position-data-row">
            <view style="flex: 1;">
              <text class="caption">持仓</text>
              <view class="mono-num" style="color: var(--xhs-title);">{{item.quantityText}}股</view>
            </view>
            <view style="flex: 1;">
              <text class="caption">成本</text>
              <view class="mono-num" style="color: var(--xhs-title);">{{item.avgCostText}}</view>
            </view>
            <view style="flex: 1;">
              <text class="caption">现价</text>
              <view class="mono-num" style="color: var(--xhs-title); display: flex; align-items: center; gap: var(--xhs-space-xs);">
                <!-- [优化] 预计算 displayPriceText，消除 wx:if/wx:else -->
                <text>{{item.displayPriceText}}</text>
                <view
                  class="refresh-btn"
                  data-stock-id="{{item.id}}"
                  catchtap="onRefreshPrice"
                >
                  <text class="refresh-icon">↻</text>
                </view>
              </view>
            </view>
          </view>

          <view class="position-pnl-row">
            <view class="mono-num {{item.floatingPnL >= 0 ? 'profit' : 'loss'}}" style="align-items: center;">
              {{item.floatingPnLText}}
            </view>
            <view class="profit-badge {{item.floatingPnL >= 0 ? 'profit' : 'loss'}}">
              <text class="mono-num">{{item.pnlPercentText}}%</text>
            </view>
          </view>
        </view>
      </view>
      <view style="height: 160rpx;"></view>
    </scroll-view>

    <!-- 空状态 -->
    <empty-state
      wx:if="{{positionCount === 0}}"
      class="{{entranceDone ? '' : 'animate-stagger'}}"
      style="{{entranceDone ? '' : 'animation-delay:320ms'}}"
      icon="📈"
      title="开始您的投资之旅"
      desc="记录每一笔交易，追踪您的财富增长"
      showSlot="{{true}}"
    >
      <view slot="actions" class="empty-actions-enhanced">
        <view class="empty-btn-primary animate-scale-in" bindtap="onQuickRecord">🚀 添加第一笔交易</view>
        <view class="empty-tips-card animate-stagger" style="animation-delay:400ms">
          <text class="tips-icon">💡</text>
          <view class="tips-content">
            <text class="tips-title">小贴士</text>
            <text class="tips-desc">添加买入记录后，系统会自动计算持仓成本和浮动盈亏</text>
          </view>
        </view>
      </view>
    </empty-state>

    <!-- 添加按钮 -->
    <view class="fab {{showQuickRecord ? 'fab-hidden' : ''}} animate-scale-in" bindtap="onQuickRecord" bindlongpress="goToAddTransaction">+</view>
  </block>

  <quick-record visible="{{showQuickRecord}}" bind:close="onQuickRecordClose" bind:submit="onQuickRecordSubmit" />

  <!-- 隐藏 canvas 用于生成分享图 -->
  <canvas wx:if="{{generatingShare}}" type="2d" id="shareCanvas" style="position: fixed; left: -9999px; top: 0; width: 1px; height: 1px;"></canvas>
</view>
