/* Minimal + Spatial UI - 首页 持仓 */

/* 导航头部样式 */
.nav-header {
  display: flex;
  align-items: center;
  padding-left: 4px;
  margin-bottom: 20px;
}

page {
  background: var(--color-bg);
}

/* 持仓卡片 */
.position-card {
  transition: opacity 100ms;
}

/* 悬浮按钮 FAB */
.fab {
  position: fixed;
  right: 24px;
  bottom: calc(100px + env(safe-area-inset-bottom));
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--color-accent, #FF6B35);
  color: #ffffff;
  font-size: 28px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 16px rgba(255, 107, 53, 0.35);
  z-index: 100;
  transition: transform 0.15s ease;
}

/* 左滑菜单样式 */
.swipe-container {
  position: relative;
  overflow: hidden;
  border-radius: 12px;
  margin-bottom: 12px;
}
.swipe-card {
  position: relative;
  z-index: 2;
  transition: transform 0.2s ease;
  background: var(--color-surface, #FFFFFF);
  border-radius: 12px;
}
.swipe-actions {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  z-index: 1;
  padding-right: 12px;
  gap: 8px;
}
.swipe-action-btn {
  width: 64px;
  height: 80%;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 13px;
  font-weight: 500;
}
.swipe-action-edit {
  background: var(--color-accent, #FF6B35);
}
.swipe-action-sell {
  background: #E04040;
}
.swipe-action-delete {
  background: #999999;
}

/* 价格输入框 */
.price-input {
  background: transparent;
  text-align: right;
  padding-right: 0;
  font-size: var(--font-body);
  color: var(--color-title);
  font-weight: var(--weight-title);
}
