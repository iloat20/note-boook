/* Minimal + Spatial UI - 首页 持仓 */

/* 导航头部样式 */
.nav-header {
  display: flex;
  align-items: center;
  padding-left: 4px;
  margin-bottom: 20px;
}

page {
  background: var(--color-bg);
}

/* 持仓卡片 */
.position-card {
  transition: opacity 100ms;
}

/* 悬浮按钮 FAB */
.fab {
  position: fixed;
  right: 24px;
  bottom: calc(100px + env(safe-area-inset-bottom));
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--color-accent, #FF3B30);
  color: #ffffff;
  font-size: 28px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 16px rgba(255, 59, 48, 0.35);
  z-index: 100;
  transition: transform 0.15s ease, opacity 0.2s ease;
}

.fab-hidden {
  opacity: 0;
  pointer-events: none;
}

/* 导航栏分享按钮 */
.nav-share-btn {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}

/* 左滑菜单样式 */
.swipe-container {
  position: relative;
  overflow: hidden;
  border-radius: 12px;
  margin-bottom: 12px;
}
.swipe-card {
  position: relative;
  z-index: 2;
  transition: transform 0.2s ease;
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 0.5px solid var(--glass-border);
  box-shadow: var(--glass-shadow-out), var(--glass-shadow-in);
  border-radius: 12px;
  overflow: hidden;
}
.swipe-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.9), transparent);
  pointer-events: none;
  z-index: 3;
}
.swipe-actions {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  z-index: 1;
  padding-right: 12px;
  gap: 8px;
}
.swipe-action-btn {
  width: 64px;
  height: 80%;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 13px;
  font-weight: 500;
}
.swipe-action-edit {
  background: var(--color-accent, #FF3B30);
}
.swipe-action-sell {
  background: #FF3B30;
}
.swipe-action-delete {
  background: #999999;
}

/* 价格输入框 */
.price-input {
  background: transparent;
  text-align: right;
  padding-right: 0;
  font-size: var(--font-body);
  color: var(--color-title);
  font-weight: var(--weight-title);
}

/* 快捷记录弹窗 */
.qr-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(20px) saturate(1.6);
  -webkit-backdrop-filter: blur(20px) saturate(1.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.25s ease;
}

.qr-sheet {
  width: calc(100% - 48px);
  max-height: 80vh;
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(40px) saturate(2);
  -webkit-backdrop-filter: blur(40px) saturate(2);
  border-radius: 20px;
  border: 0.5px solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 8px 40px rgba(0, 0, 0, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  padding: 12px 20px calc(12px + env(safe-area-inset-bottom));
  animation: qrFadeIn 0.25s ease;
  display: flex;
  flex-direction: column;
}

.qr-body {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.qr-handle {
  width: 36px;
  height: 4px;
  border-radius: 2px;
  background: rgba(0, 0, 0, 0.12);
  margin: 0 auto 8px;
}

.qr-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.qr-title {
  font-size: 17px;
  font-weight: 600;
  color: var(--color-title);
}

.qr-close {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.06);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: var(--color-caption);
}

.qr-type-row {
  display: flex;
  gap: 10px;
  margin-bottom: 10px;
}

.qr-type-btn {
  flex: 1;
  height: 36px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 500;
  background: rgba(0, 0, 0, 0.04);
  backdrop-filter: blur(8px);
  border: 0.5px solid rgba(0, 0, 0, 0.06);
  color: var(--color-body);
  transition: all 0.2s ease;
}

.qr-type-buy {
  background: rgba(255, 59, 48, 0.1);
  backdrop-filter: blur(8px);
  border-color: rgba(255, 59, 48, 0.18);
  color: #FF3B30;
  font-weight: 600;
}

.qr-type-sell {
  background: rgba(81, 207, 102, 0.12);
  backdrop-filter: blur(8px);
  border-color: rgba(81, 207, 102, 0.2);
  color: #51CF66;
  font-weight: 600;
}

.qr-field {
  margin-bottom: 10px;
  position: relative;
}

.qr-label {
  font-size: 12px;
  color: var(--color-caption);
  margin-bottom: 4px;
  display: block;
}

.qr-input-wrap {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(0, 0, 0, 0.04);
  backdrop-filter: blur(8px);
  border: 0.5px solid rgba(0, 0, 0, 0.06);
  border-radius: 10px;
  padding: 0 12px;
  height: 40px;
}

.qr-input {
  flex: 1;
  font-size: 15px;
  color: var(--color-title);
  background: transparent;
  height: 40px;
}

.qr-name-tag {
  font-size: 13px;
  color: var(--color-title);
  font-weight: 500;
  white-space: nowrap;
}

.qr-qty-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.qr-qty-btn {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background: rgba(0, 0, 0, 0.04);
  backdrop-filter: blur(8px);
  border: 0.5px solid rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  font-weight: 500;
  color: var(--color-title);
  flex-shrink: 0;
}

.qr-market-tag {
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 4px;
  background: rgba(255, 59, 48, 0.1);
  backdrop-filter: blur(8px);
  border: 0.5px solid rgba(255, 59, 48, 0.18);
  color: #FF3B30;
  white-space: nowrap;
}

.qr-suggestions {
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px) saturate(1.6);
  -webkit-backdrop-filter: blur(20px) saturate(1.6);
  border: 0.5px solid rgba(255, 255, 255, 0.6);
  border-radius: 10px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.1);
  z-index: 10;
  margin-top: 4px;
  max-height: 200px;
  overflow-y: auto;
}

.qr-suggestion-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  border-bottom: 0.5px solid rgba(0, 0, 0, 0.06);
}

.qr-suggestion-item:last-child {
  border-bottom: none;
}

.qr-suggestion-code {
  font-size: 14px;
  font-weight: 600;
  color: var(--color-title);
  min-width: 60px;
}

.qr-suggestion-name {
  font-size: 13px;
  color: var(--color-body);
}

.qr-preview {
  background: rgba(0, 0, 0, 0.03);
  backdrop-filter: blur(8px);
  border: 0.5px solid rgba(0, 0, 0, 0.05);
  border-radius: 10px;
  padding: 8px 12px;
  margin-bottom: 0;
}

.qr-preview-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4px 0;
}

.qr-preview-label {
  font-size: 13px;
  color: var(--color-caption);
}

.qr-preview-value {
  font-size: 14px;
  color: var(--color-title);
}

.qr-submit {
  width: 100%;
  height: 44px;
  border-radius: 12px;
  background: linear-gradient(135deg, rgba(255, 59, 48, 0.92), rgba(255, 59, 48, 0.98));
  backdrop-filter: blur(8px);
  box-shadow: 0 4px 16px rgba(255, 59, 48, 0.3), inset 0 0.5px 0 rgba(255, 255, 255, 0.3);
  color: #fff;
  font-size: 16px;
  font-weight: 600;
  margin-top: 8px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes qrFadeIn {
  from { opacity: 0; transform: scale(0.95); }
  to { opacity: 1; transform: scale(1); }
}
