/* pages/index/index.wxss */
.home {
  padding: 20rpx;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.header {
  margin-bottom: 30rpx;
  text-align: center;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.date-list {
  flex: 1;
  overflow-y: auto;
}

.date-item {
  padding: 30rpx;
  margin-bottom: 20rpx;
  background-color: white;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
  cursor: pointer;
  transition: background-color 0.3s;
}

.date-item:hover {
  background-color: #f0f0f0;
}

.new-date {
  background-color: #e3f2fd;
  font-weight: bold;
}