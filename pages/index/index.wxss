/* ═════════════════════════════════════════╗
   小红书风格 - 首页持仓
   ╚════════════════════════════════════════╝ */

@import '../../styles/common.wxss';

page {
  background: var(--xhs-bg);
}

/* === 页面标题 === */
.page-title {
  margin-bottom: var(--xhs-space-lg);
}

.page-title-text {
  font-size: var(--xhs-font-4xl);
  font-weight: var(--xhs-weight-bold);
  color: var(--xhs-title);
  letter-spacing: -0.02em;
  line-height: 1.15;
}

/* === 汇总卡片 (白卡 + 红字) === */
.summary-card {
  background: var(--xhs-surface);
  border-radius: var(--xhs-radius-md);
  box-shadow: var(--xhs-card-shadow);
  padding: var(--xhs-space-xl);
  margin-bottom: var(--xhs-space-lg);
  position: relative;
  overflow: hidden;
}

.summary-card .caption {
  color: var(--xhs-caption);
  font-size: var(--xhs-font-sm);
  font-weight: var(--xhs-weight-medium);
}

.summary-card .title {
  font-size: var(--xhs-font-4xl);
  font-weight: var(--xhs-weight-bold);
  color: var(--xhs-title);
  letter-spacing: 0.01em;
}

/* 汇总卡片中的数字颜色 */
.summary-card .profit {
  color: var(--xhs-profit) !important;
}

.summary-card .loss {
  color: var(--xhs-loss) !important;
}

/* === 液体滑块 === */
.liquid-slider {
  display: flex;
  background: var(--xhs-bg-secondary);
  border-radius: var(--xhs-radius-pill);
  padding: 3px;
  position: relative;
  margin-bottom: var(--xhs-space-lg);
}

.liquid-slider-bg {
  position: absolute;
  top: 3px;
  bottom: 3px;
  background: var(--xhs-surface);
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
  border-radius: var(--xhs-radius-pill);
  transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 1;
}

.liquid-slider-item {
  flex: 1;
  text-align: center;
  padding: 7px 0;
  font-size: var(--xhs-font-sm);
  font-weight: var(--xhs-weight-medium);
  color: var(--xhs-caption);
  position: relative;
  z-index: 2;
  transition: var(--xhs-transition);
}

.liquid-slider-item.active {
  color: var(--xhs-primary);
  font-weight: var(--xhs-weight-semibold);
}

/* === 持仓卡片 (纯白卡 + 灰阴影) === */
.position-card {
  background: var(--xhs-surface);
  border-radius: var(--xhs-radius-md);
  box-shadow: var(--xhs-card-shadow);
  padding: var(--xhs-space-lg);
  margin-bottom: var(--xhs-space-sm);
  position: relative;
  z-index: 2;
  overflow: hidden;
  transition: var(--xhs-transition-slow);
}

.position-card:active {
  transform: scale(0.98);
  box-shadow: var(--xhs-card-shadow-hover);
}

.position-card .stock-code {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption-light);
  font-weight: var(--xhs-weight-regular);
}

.position-card .stock-name {
  font-size: var(--xhs-font-lg);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
  letter-spacing: -0.01em;
}

.position-card .stock-code {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption-light);
  font-weight: var(--xhs-weight-regular);
  line-height: 1;
}

.position-card .caption {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
  font-weight: var(--xhs-weight-medium);
  letter-spacing: 0.02em;
  line-height: 1;
  display: block;
  margin-bottom: 4rpx;
}

.position-card .mono-num {
  font-size: var(--xhs-font-lg);
  font-weight: var(--xhs-weight-semibold);
  letter-spacing: 0.01em;
  color: var(--xhs-title);
  line-height: 1.2;
}

/* 持仓卡片底部盈亏数字 (最后一行) */
.position-card > view:last-child .mono-num {
  font-size: var(--xhs-font-lg);
  font-weight: var(--xhs-weight-semibold);
}

.position-card .profit {
  color: var(--xhs-profit) !important;
}

.position-card .loss {
  color: var(--xhs-loss) !important;
}

/* === 左滑菜单 === */
.swipe-container {
  position: relative;
  overflow: hidden;
  border-radius: var(--xhs-radius-md);
  margin-bottom: var(--xhs-space-sm);
}

.swipe-card {
  position: relative;
  z-index: 2;
  transition: transform 0.2s ease;
  background: var(--xhs-surface);
  border-radius: var(--xhs-radius-md);
  box-shadow: var(--xhs-card-shadow);
  overflow: hidden;
}

.swipe-actions {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  z-index: 1;
  padding: 0 var(--xhs-space-md) 0 10px;
  gap: var(--xhs-space-sm);
  background: var(--xhs-bg);
}

.swipe-action-btn {
  width: 128rpx;
  height: calc(100% - 48rpx);
  border-radius: var(--xhs-radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: var(--xhs-font-sm);
  font-weight: var(--xhs-weight-semibold);
  letter-spacing: 0.02em;
}

.swipe-action-edit {
  background: var(--xhs-primary);
}

.swipe-action-sell {
  background: #FF6B6B;
}

.swipe-action-delete {
  background: var(--xhs-caption);
}

/* === 刷新按钮 === */
.refresh-btn {
  min-height: 32rpx;
  min-width: 32rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--xhs-radius-round);
  transition: var(--xhs-transition);
}

.refresh-btn:active {
  background: var(--xhs-bg-secondary);
  transform: scale(0.9);
}

.refresh-icon {
  font-size: 22rpx;
  color: var(--xhs-caption-light);
  line-height: 1;
  transition: transform 300ms ease;
}

.refresh-btn:active .refresh-icon {
  transform: rotate(180deg);
}

/* 现价容器 - 添加闪光动画 */
.price-flash-profit {
  animation: price-flash-profit 600ms ease-out;
}

.price-flash-loss {
  animation: price-flash-loss 600ms ease-out;
}

@keyframes price-flash-profit {
  0% { background-color: var(--xhs-profit-bg); }
  100% { background-color: transparent; }
}

@keyframes price-flash-loss {
  0% { background-color: var(--xhs-loss-bg); }
  100% { background-color: transparent; }
}

/* 数字翻滚动画 */
@keyframes number-roll {
  0% { transform: translateY(0); opacity: 1; }
  50% { transform: translateY(-8px); opacity: 0; }
  51% { transform: translateY(8px); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}
.number-rolling {
  animation: number-roll 400ms ease-out;
}

/* === Price Display === */
.price-mono {
  letter-spacing: 0.01em;
  font-weight: var(--xhs-weight-semibold);
}

/* === Profit/Loss Badge === */
.profit-badge {
  display: inline-flex;
  align-items: center;
  padding: 3px 10px;
  border-radius: var(--xhs-radius-pill);
  font-size: var(--xhs-font-sm);
  font-weight: var(--xhs-weight-semibold);
  transition: all 300ms ease-out;
  letter-spacing: 0.01em;
}

.profit-badge.profit {
  background: var(--xhs-profit-bg);
  color: var(--xhs-profit);
}

.profit-badge.loss {
  background: var(--xhs-loss-bg);
  color: var(--xhs-loss);
}

/* === FAB === */
.fab {
  position: fixed;
  right: var(--xhs-space-lg);
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: var(--xhs-radius-round);
  background: var(--xhs-primary);
  color: #FFFFFF;
  font-size: 52rpx;
  font-weight: var(--xhs-weight-bold);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--xhs-btn-shadow);
  z-index: 100;
  transition: var(--xhs-transition);
  border: none;
}

.fab:active {
  transform: scale(0.9);
  box-shadow: var(--xhs-btn-shadow-hover);
}

.fab-hidden {
  opacity: 0;
  pointer-events: none;
  transform: scale(0.8) rotate(90deg);
}

/* === 骨架屏 === */
.skeleton-container {
  padding: 0;
}

.skeleton-card {
  background: var(--xhs-surface);
  border-radius: var(--xhs-radius-md);
  box-shadow: var(--xhs-card-shadow);
  padding: var(--xhs-space-lg);
  margin-bottom: var(--xhs-space-md);
}

.skeleton-header {
  display: flex;
  align-items: center;
  gap: var(--xhs-space-sm);
  margin-bottom: var(--xhs-space-md);
}

.skeleton-tag {
  width: 48px;
  height: 24px;
  border-radius: var(--xhs-radius-pill);
  background: var(--xhs-divider);
}

.skeleton-text {
  height: 16px;
  border-radius: 4px;
  background: var(--xhs-divider);
}

.skeleton-header .skeleton-text:first-child {
  width: 80px;
}

.skeleton-header .skeleton-text:last-child {
  width: 100px;
}

.skeleton-body {
  display: flex;
  gap: var(--xhs-space-md);
}

.skeleton-body .skeleton-item {
  flex: 1;
}

.skeleton-item {
  height: 36px;
  border-radius: 4px;
  background: var(--xhs-divider);
}

.shimmer {
  background: linear-gradient(90deg, var(--xhs-divider) 25%, rgba(0,0,0,0.06) 50%, var(--xhs-divider) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* === Stat Item === */
.stat-item {
  flex: 1;
}

.stat-label {
  font-size: var(--xhs-font-xs);
  color: var(--xhs-caption);
  margin-bottom: var(--xhs-space-xs);
  display: block;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.stat-value {
  font-size: var(--xhs-font-lg);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
}

/* === Position Header === */
.position-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--xhs-space-md);
}

/* === Position Body === */
.position-body {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

/* === Position Stats === */
.position-stats {
  display: flex;
  gap: var(--xhs-space-lg);
  margin-top: var(--xhs-space-md);
  padding-top: var(--xhs-space-md);
  border-top: 1px solid var(--xhs-divider);
}

/* === Retrofit: WXML 使用的旧类名 === */
.card {
  background: var(--xhs-surface);
  border-radius: var(--xhs-radius-md);
  box-shadow: var(--xhs-card-shadow);
  padding: var(--space-card-pad, var(--xhs-space-lg));
  position: relative;
  overflow: hidden;
  transition: var(--xhs-transition-slow);
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 6px 14px;
  border-radius: var(--xhs-radius-pill);
  background: transparent;
  font-size: var(--xhs-font-sm);
  color: #999;
  min-height: 32px;
  transition: var(--xhs-transition);
}

.chip-active {
  color: #1C1C1E;
  font-weight: var(--xhs-weight-semibold);
  position: relative;
  background: transparent;
  border-color: transparent;
}

	.text-btn {
  color: var(--xhs-primary);
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-semibold);
  padding: var(--xhs-space-sm) 0;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--xhs-transition);
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 2px 10px;
  border-radius: var(--xhs-radius-pill);
  font-size: var(--xhs-font-xs);
  font-weight: var(--xhs-weight-medium);
  letter-spacing: 0.01em;
}
