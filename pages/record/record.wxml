<view class="page-container" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar" style="height: {{navBarHeight}}px; display: flex; align-items: flex-end; padding: 0 16px;">
    <view bindtap="goBack" style="min-height: 44px; min-width: 44px; display: flex; align-items: center; justify-content: flex-start;">
      <text style="font-size: 22px; color: var(--color-accent); font-weight: 300;">‹</text>
    </view>
    <text class="nav-header-title" style="flex: 1;">{{isEdit ? '编辑交易' : '添加交易'}}</text>
  </view>

  <scroll-view class="scroll-container" scroll-y="true">
    <text class="title" style="display: block; margin-bottom: 12px;">基本信息</text>
    <view class="card section">
      <view class="tab-bar-line">
        <view wx:for="{{markets}}" wx:key="key" class="tab-line-item {{market === item.key ? 'tab-line-active' : ''}}" bindtap="selectMarket" data-market="{{item.key}}">{{item.label}}</view>
      </view>

      <view style="margin-bottom: 12px;">
        <text class="caption" style="display: block; margin-bottom: 4px;">股票代码</text>
        <input class="input" style="width: 100%;" placeholder="请输入股票代码" value="{{code}}" bindinput="onCodeInput" bindblur="hideSuggestions"/>
        <text wx:if="{{codeError}}" class="caption" style="color: var(--color-profit); margin-top: 4px;">{{codeError}}</text>
        <view wx:if="{{showSuggestions}}" class="card" style="margin-top: 4px; max-height: 200px; overflow-y: auto; position: relative; z-index: 100;">
          <view wx:for="{{suggestions}}" wx:key="code"
                bindtap="onSelectSuggestion" data-item="{{item}}"
                style="padding: 10px 12px; border-bottom: 1px solid var(--color-separator); display: flex; justify-content: space-between; align-items: center;">
            <text class="body" style="color: var(--color-title);">{{item.code}}</text>
            <text class="caption" style="color: var(--color-body);">{{item.name}}</text>
          </view>
        </view>
      </view>

      <view style="margin-bottom: 12px;">
        <text class="caption" style="display: block; margin-bottom: 4px;">股票名称</text>
        <input class="input" style="width: 100%;" placeholder="请输入股票名称" value="{{name}}" bindinput="onNameInput"/>
      </view>

      <view class="tab-bar-line">
        <view class="tab-line-item {{type === 'BUY' ? 'tab-line-active' : ''}}" bindtap="selectType" data-type="BUY">买入</view>
        <view class="tab-line-item {{type === 'SELL' ? 'tab-line-active' : ''}}" bindtap="selectType" data-type="SELL">卖出</view>
      </view>
    </view>

    <text class="title" style="display: block; margin-bottom: 12px;">交易详情</text>
    <view class="card section">
      <view style="margin-bottom: 12px;">
        <text class="caption" style="display: block; margin-bottom: 4px;">成交价格</text>
        <input class="input" style="width: 100%;" type="digit" placeholder="0.00" value="{{price}}" bindinput="onPriceInput"/>
      </view>
      <view style="margin-bottom: 12px;">
        <text class="caption" style="display: block; margin-bottom: 4px;">成交数量（股）</text>
        <input class="input" style="width: 100%;" type="digit" placeholder="0" value="{{quantity}}" bindinput="onQuantityInput"/>
      </view>
      <view style="margin-bottom: 12px;">
        <text class="caption" style="display: block; margin-bottom: 4px;">手续费</text>
        <input class="input" style="width: 100%;" type="digit" placeholder="0.00" value="{{fee}}" bindinput="onFeeInput"/>
        <view wx:if="{{feePreview.length}}" style="margin-top: 8px;">
          <view wx:for="{{feePreview}}" wx:key="name" style="display: flex; justify-content: space-between; padding: 4px 0;">
            <text class="caption">{{item.name}}</text>
            <text class="caption">{{item.vt}}</text>
          </view>
        </view>
      </view>
      <view style="margin-bottom: 12px;">
        <text class="caption" style="display: block; margin-bottom: 4px;">交易日期</text>
        <picker mode="date" value="{{date}}" bindchange="onDateChange">
          <view class="input" style="display: flex; align-items: center; justify-content: space-between;">
            <text>{{date || '选择日期'}}</text>
            <text class="caption">›</text>
          </view>
        </picker>
      </view>
      <view style="margin-bottom: 12px;">
        <text class="caption" style="display: block; margin-bottom: 4px;">交易时间</text>
        <picker mode="time" value="{{time}}" bindchange="onTimeChange">
          <view class="input" style="display: flex; align-items: center; justify-content: space-between;">
            <text>{{time || '选择时间'}}</text>
            <text class="caption">›</text>
          </view>
        </picker>
      </view>
      <view>
        <text class="caption" style="display: block; margin-bottom: 4px;">备注（选填）</text>
        <textarea class="input" style="width: 100%; height: 80px; padding: 12px;" placeholder="添加备注..." value="{{note}}" bindinput="onNoteInput"/>
      </view>
    </view>

    <view class="section">
      <text class="title" style="display: block; margin-bottom: 12px;">预览</text>
      <view class="card-sm">
        <view style="display: flex; justify-content: space-between; padding: 8px 0;">
          <text class="body">交易金额</text>
          <text class="body" style="color: var(--color-title);">{{amountText}}</text>
        </view>
        <view style="display: flex; justify-content: space-between; padding: 8px 0; border-top: 1px solid var(--color-separator);">
          <text class="body" style="font-weight: var(--weight-title); color: var(--color-title);">实际{{type === 'BUY' ? '支出' : '收入'}}</text>
          <text class="body" style="font-weight: var(--weight-title); color: var(--color-title);">{{actualText}}</text>
        </view>
      </view>
    </view>
    <view style="height: 100px;"></view>
  </scroll-view>

  <view class="cta-btn" style="margin: 0 var(--space-page); position: fixed; bottom: calc(20px + env(safe-area-inset-bottom)); left: 0; right: 0; z-index: 10; background-color: var(--color-accent); color: #FFFFFF;" bindtap="submit">{{isEdit ? '保存修改' : '确认添加'}}</view>
</view>
