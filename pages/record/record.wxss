/* Minimal + Spatial UI - 记录页 */

/* === Tab Bar Line === */
.tab-bar-line {
  display: flex;
  gap: 8px;
  margin-bottom: 12px;
}

.tab-line-item {
  flex: 1;
  max-width: 100px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: var(--color-caption);
  border-radius: 8px;
  transition: all 0.2s ease;
  position: relative;
  background: var(--color-glass);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.tab-line-item:active {
  opacity: 0.7;
}

.tab-line-active {
  color: var(--color-accent);
  background: var(--glass-bg);
  font-weight: 600;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

/* === Form Input Focus === */
.form-input:focus {
  background: var(--color-bg);
}
