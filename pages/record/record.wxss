/* Minimal + Spatial UI - 记录页 */

/* === Tab Bar Line === */
.tab-bar-line {
  display: flex;
  gap: 8px;
  margin-bottom: 12px;
}

.tab-line-item {
  flex: 1;
  max-width: 100px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: var(--color-caption);
  border-radius: 8px;
  transition: all 0.2s ease;
  position: relative;
  background: var(--color-surface);
}

.tab-line-active {
  color: var(--color-accent);
  background: var(--glass-bg);
  font-weight: 600;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

/* === Journal Section === */
.journal-toggle {
  display: flex;
  align-items: center;
  padding: 4px 0;
}

.journal-toggle-icon {
  font-size: 18px;
  color: var(--color-caption);
  transition: transform 0.3s ease;
  transform: rotate(0deg);
}

.journal-toggle-icon-open {
  transform: rotate(90deg);
}

.journal-body {
  padding-top: 12px;
  border-top: 1px solid var(--color-separator);
  margin-top: 12px;
}

.strategy-count-tag {
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 4px;
  background: rgba(255, 59, 48, 0.08);
  color: var(--color-accent);
}

.strategy-chip {
  padding: 6px 14px;
  border-radius: 8px;
  font-size: 13px;
  background: var(--color-surface);
  color: var(--color-body);
  transition: all 0.2s ease;
}

.strategy-chip-selected {
  padding: 6px 14px;
  border-radius: 8px;
  font-size: 13px;
  background: var(--color-accent);
  color: #FFFFFF;
  display: flex;
  align-items: center;
}

.strategy-chip-add {
  padding: 6px 14px;
  border-radius: 8px;
  font-size: 13px;
  background: rgba(255, 59, 48, 0.08);
  color: var(--color-accent);
  border: 1px dashed var(--color-accent);
}

.strategy-picker-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(20px) saturate(1.6);
  -webkit-backdrop-filter: blur(20px) saturate(1.6);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.strategy-picker-card {
  width: 100%;
  max-height: 70vh;
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(40px) saturate(2);
  -webkit-backdrop-filter: blur(40px) saturate(2);
  border: 0.5px solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 8px 40px rgba(0, 0, 0, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.8);
  border-radius: 16px 16px 0 0;
  padding: 20px;
  padding-bottom: calc(20px + env(safe-area-inset-bottom));
  overflow-y: auto;
}
