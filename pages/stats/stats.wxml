<view class="page-container {{entranceDone ? '' : 'page-entrance'}}" style="padding-top: {{statusBarHeight + navBarHeight}}px;">
  <!-- 标题栏 -->
  <view class="page-title animate-stagger" style="animation-delay:80ms">
    <view class="title-row">
      <view class="title-icon-wrap">
        <image class="title-icon" src="/images/title-stats.svg" mode="aspectFit" />
      </view>
    </view>
  </view>
  
  <!-- 骨架屏 -->
  <view wx:if="{{loading}}" class="skeleton-container">
    <view class="xhs-skeleton-card" wx:for="{{[1,2,3,4]}}" wx:key="*this">
      <view class="xhs-skeleton-header">
        <view class="xhs-skeleton-tag xhs-shimmer"></view>
        <view class="xhs-skeleton-text xhs-shimmer" style="width: 60%;"></view>
      </view>
      <view class="xhs-skeleton-body">
        <view class="xhs-skeleton-item xhs-shimmer"></view>
        <view class="xhs-skeleton-item xhs-shimmer"></view>
      </view>
    </view>
  </view>

  <scroll-view wx:else class="xhs-scroll" scroll-y>
    <!-- 双列统计卡片 (小红书笔记风格，资产中性) -->
    <view class="xhs-feed-grid animate-stagger" style="animation-delay:240ms">
      <!-- 资产变动 -->
      <view class="xhs-feed-card">
        <view class="xhs-feed-card-inner">
          <view class="xhs-feed-card-cover cover-pnl">
            <text class="xhs-feed-card-emoji">📈</text>
          </view>
          <view class="xhs-feed-card-body">
            <text class="xhs-feed-card-value {{stats.totalPnL >= 0 ? 'xhs-profit' : 'xhs-loss'}}">
              {{stats.totalPnLText}}
            </text>
            <text class="xhs-feed-card-label">资产变动</text>
          </view>
        </view>
      </view>

      <!-- 记录次数 -->
      <view class="xhs-feed-card">
        <view class="xhs-feed-card-inner">
          <view class="xhs-feed-card-cover cover-rate">
            <text class="xhs-feed-card-emoji">📋</text>
          </view>
          <view class="xhs-feed-card-body">
            <text class="xhs-feed-card-value">
              {{stats.recordCount}}
            </text>
            <text class="xhs-feed-card-label">记录次数</text>
          </view>
        </view>
      </view>

      <!-- 期末资产 -->
      <view class="xhs-feed-card">
        <view class="xhs-feed-card-inner">
          <view class="xhs-feed-card-cover cover-recover">
            <text class="xhs-feed-card-emoji">💰</text>
          </view>
          <view class="xhs-feed-card-body">
            <text class="xhs-feed-card-value">
              {{stats.endingAssetText}}
            </text>
            <text class="xhs-feed-card-label">期末资产</text>
          </view>
        </view>
      </view>

      <!-- 记录天数 -->
      <view class="xhs-feed-card">
        <view class="xhs-feed-card-inner">
          <view class="xhs-feed-card-cover cover-days">
            <text class="xhs-feed-card-emoji">🗓️</text>
          </view>
          <view class="xhs-feed-card-body">
            <text class="xhs-feed-card-value">
              {{stats.recordDays}}
            </text>
            <text class="xhs-feed-card-label">记录天数</text>
          </view>
        </view>
      </view>

    </view>

    <!-- 完整资产明细 (小红书长笔记风格) -->
    <view class="xhs-feed-card-full animate-stagger" style="animation-delay:320ms">
      <view class="xhs-feed-card-full-header">
        <text class="xhs-feed-card-full-title">📝 完整明细</text>
        <view class="xhs-feed-card-full-action" bindtap="onExportMD">
          <text class="xhs-feed-card-full-action-text">导出</text>
        </view>
      </view>
      <view class="xhs-feed-card-full-body">
        <view wx:if="{{completeTrades.length > 0}}" class="detail-list detail-list--plain">
          <view wx:for="{{completeTrades}}" wx:key="id" class="detail-item">
            <view class="detail-row-single">
              <view class="detail-info">
                <view class="{{item.typeTagClass}}">{{item.typeText}}</view>
                <text class="detail-code">{{item.code}}</text>
                <text class="detail-name">{{item.name}}</text>
              </view>
              <text class="detail-date-inline">{{item.dateText}}</text>
            </view>
            <view wx:if="{{item.type !== 'DIVIDEND'}}" class="detail-row-detail">
              <text class="detail-d-price mono-num">¥{{item.priceText || '0.00'}}</text>
              <text class="detail-d-multiply">×</text>
              <text class="detail-d-shares">{{item.quantity || 0}}份</text>
              <text class="{{item.amountClass}}">
                ¥{{item.amountText || '0.00'}}
              </text>
            </view>
            <view wx:if="{{item.type === 'DIVIDEND'}}" class="detail-row-detail">
              <text class="{{item.amountClass}}">¥{{item.amountText || '0.00'}}</text>
            </view>
          </view>
        </view>
        <view wx:else class="detail-empty">暂无资产记录</view>
      </view>
    </view>

    <!-- 已结束资产 -->
    <view class="xhs-feed-card-full">
      <view class="xhs-feed-card-full-header">
        <text class="xhs-feed-card-full-title">💼 已结束资产</text>
      </view>
      <view class="xhs-feed-card-full-body">
        <view wx:if="{{clearedPositions.length > 0}}" class="detail-list">
          <view wx:for="{{clearedPositions}}" wx:key="id" class="detail-item">
            <view class="detail-top">
              <view>
                <text class="detail-code">{{item.name}}</text>
                <text class="detail-name" style="margin-left: 8px;">{{item.code}}</text>
              </view>
              <text class="detail-amount mono-num {{item.pnlClass}}">
                {{item.totalPnLText}}
              </text>
            </view>
            <view class="detail-meta">
              <text class="detail-meta-text">净变动: {{item.realizedPnLText}}</text>
            </view>
          </view>
        </view>
        <view wx:else class="detail-empty">暂无已结束资产</view>
      </view>
    </view>

    <!-- 底部年度报告 CTA -->
    <view class="xhs-feed-footer animate-stagger" style="animation-delay:480ms">
      <view class="xhs-feed-cta hover-lift" bindtap="onOpenAnnualReport">
        <text>📊 查看年度资产复盘</text>
      </view>
    </view>

    <!-- 清除所有数据 -->
    <view class="xhs-feed-footer">
      <view class="xhs-feed-cta-danger hover-lift" bindtap="onClearAllData">
        <text>🗑️ 一键清除所有数据</text>
      </view>
    </view>

    <view style="height: 40rpx;"></view>
  </scroll-view>

  <annual-report wx:if="{{showAnnualReport}}" data="{{annualReportData}}" statusBarHeight="{{statusBarHeight}}" navBarHeight="{{navBarHeight}}" bind:close="onCloseAnnualReport" />
</view>
