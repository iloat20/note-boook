<view class="page-container" style="padding-top: {{statusBarHeight}}px;">
  <!-- 页面标题 -->
  <!-- 标题栏（仅间距） -->
  <view class="page-title"></view>

  <!-- 骨架屏 -->
  <view wx:if="{{loading}}" class="skeleton-container">
    <view class="xhs-skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="xhs-skeleton-header">
        <view class="xhs-skeleton-tag xhs-shimmer"></view>
        <view class="xhs-skeleton-text xhs-shimmer"></view>
      </view>
      <view class="xhs-skeleton-body">
        <view class="xhs-skeleton-item xhs-shimmer"></view>
        <view class="xhs-skeleton-item xhs-shimmer"></view>
      </view>
    </view>
  </view>

  <scroll-view wx:else class="scroll-container" scroll-y>

    <!-- 时段选择 (pill 风格) -->
    <view class="period-tabs">
      <view
        wx:for="{{periodTabs}}"
        wx:key="key"
        class="period-tab {{currentPeriod === item.key ? 'period-active' : ''}}"
        bindtap="switchPeriod"
        data-period="{{item.key}}"
      >{{item.label}}</view>
    </view>

    <!-- 统计卡片网格 (2x2) -->
    <view class="stats-grid">
      <view class="stat-card">
        <text class="stat-label">投入</text>
        <text class="stat-value">{{stats.totalInvestmentText}}</text>
      </view>
      <view class="stat-card">
        <text class="stat-label">回收</text>
        <text class="stat-value">{{stats.totalRecoverText}}</text>
      </view>
      <view class="stat-card">
        <text class="stat-label">盈亏</text>
        <text class="stat-value {{stats.totalPnL >= 0 ? 'stat-profit' : 'stat-loss'}}">
          {{stats.totalPnL >= 0 ? '+' : ''}}{{stats.totalPnLText}}
        </text>
      </view>
      <view class="stat-card">
        <text class="stat-label">收益率</text>
        <text class="stat-value {{stats.totalPnL >= 0 ? 'stat-profit' : 'stat-loss'}}">
          {{stats.totalReturnRateText || '0.00%'}}
        </text>
      </view>
    </view>



    <!-- 完整交易明细 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">完整交易明细</text>
        <view class="export-btn" bindtap="onExportMD"><text class="btn-icon icon-download"></text> 导出</view>
      </view>
      <view class="xhs-card">
        <view wx:if="{{completeTrades.length > 0}}" class="detail-list">
          <view wx:for="{{completeTrades}}" wx:key="id" class="detail-item">
            <view class="detail-top">
              <view class="detail-info">
                <view class="tag type-tag {{item.type === 'BUY' ? 'tag-buy' : item.type === 'SELL' ? 'tag-sell' : 'tag-dividend'}}">{{item.typeText}}</view>
                <text class="detail-code">{{item.code}}</text>
                <text class="detail-name">{{item.name}}</text>
              </view>
              <text class="detail-amount mono-num">{{item.amountText}}</text>
            </view>
            <text class="detail-date">{{item.dateText}}</text>
          </view>
        </view>
        <view wx:else class="detail-empty">暂无交易记录</view>
      </view>
    </view>

    <!-- 已清仓股票 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">已清仓股票</text>
        <view class="annual-btn" bindtap="onOpenAnnualReport"><text class="btn-icon icon-report"></text> 年度报告</view>
      </view>
      <view class="xhs-card">
        <view wx:if="{{clearedPositions.length > 0}}" class="detail-list">
          <view wx:for="{{clearedPositions}}" wx:key="id" class="detail-item">
            <view class="detail-top">
              <view>
                <text class="detail-code">{{item.name}}</text>
                <text class="detail-name" style="margin-left: 8px;">{{item.code}}</text>
              </view>
              <text class="detail-amount mono-num {{item.pnlClass}}">
                {{item.totalPnL >= 0 ? '+' : ''}}{{item.totalPnLText}}
              </text>
            </view>
            <view class="detail-meta">
              <text>已实现: {{item.realizedPnLText}}</text>
              <text>分红: +{{item.dividendIncomeText}}</text>
            </view>
          </view>
        </view>
        <view wx:else class="detail-empty">暂无已清仓股票</view>
      </view>
    </view>

    <!-- 综合明细 -->
    <view class="section">
      <text class="section-title">综合明细</text>
      <view class="xhs-card">
        <view wx:for="{{detailItems}}" wx:key="label" class="detail-row">
          <text class="detail-row-label">{{item.label}}</text>
          <text class="detail-row-value {{item.colorClass}}">{{item.prefix}}{{item.value}}</text>
        </view>
      </view>
    </view>

    <view style="height: 160rpx;"></view>
  </scroll-view>

  <annual-report wx:if="{{showAnnualReport}}" data="{{annualReportData}}" bind:close="onCloseAnnualReport" />
</view>