/* ═════════════════════════════════════════╗
   小红书首页风格 - 统计页 v3
   ╚════════════════════════════════════════╝ */

@import '../../styles/common.wxss';

/* === 骨架屏间距 === */
.skeleton-container {
  padding-top: var(--xhs-space-lg);
}

/* === 时段 Tab (选中黑色 + 红色下划线) === */
.period-tabs {
  display: flex;
  margin-bottom: var(--xhs-space-lg);
}

.period-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0 24rpx;
  font-size: var(--xhs-font-md);
  color: var(--xhs-caption);
  font-weight: var(--xhs-weight-medium);
  position: relative;
  transition: var(--xhs-transition);
}

.period-tab:active {
  opacity: 0.7;
}

.period-tab.active {
  color: var(--xhs-title);
  font-weight: var(--xhs-weight-semibold);
}

.period-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 36%;
  right: 36%;
  height: 4rpx;
  background: var(--xhs-primary);
  border-radius: 2rpx;
}

/* === 双列统计卡片 (小红书笔记风格) === */
.xhs-feed-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
  margin-bottom: var(--xhs-space-lg);
}

.xhs-feed-card {
  width: 50%;
  padding: 0 8rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.xhs-feed-card-inner {
  background: var(--xhs-surface);
  border-radius: var(--xhs-radius-md);
  box-shadow: var(--xhs-card-shadow);
  overflow: hidden;
  transition: var(--xhs-transition-slow);
}

.xhs-feed-card-inner:active {
  transform: scale(0.97);
}

/* 封面图区域 (模仿小红书笔记封面) */
.xhs-feed-card-cover {
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.xhs-feed-card-emoji {
  font-size: 48rpx;
  opacity: 0.9;
}

/* 四色封面渐变 */
.cover-invest {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
}

.cover-recover {
  background: linear-gradient(135deg, #F093FB 0%, #F5576C 100%);
}

.cover-pnl {
  background: linear-gradient(135deg, #4FACFE 0%, #00F2FE 100%);
}

.cover-rate {
  background: linear-gradient(135deg, #43E97B 0%, #38F9D7 100%);
}

/* 卡片内容区 */
.xhs-feed-card-body {
  padding: 16rpx 20rpx 20rpx;
  text-align: center;
}

.xhs-feed-card-value {
  display: block;
  font-size: 40rpx;
  font-weight: var(--xhs-weight-bold);
  color: var(--xhs-title);
  letter-spacing: -0.01em;
  line-height: 1.2;
  margin-bottom: 4rpx;
  word-break: break-all;
}

.xhs-feed-card-label {
  display: block;
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
  font-weight: var(--xhs-weight-medium);
}

/* === 全宽内容卡片 (小红书长笔记风格) === */
.xhs-feed-card-full {
  background: var(--xhs-surface);
  border-radius: var(--xhs-radius-md);
  box-shadow: var(--xhs-card-shadow);
  margin-bottom: var(--xhs-space-md);
  overflow: hidden;
  transition: var(--xhs-transition-slow);
}

.xhs-feed-card-full-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--xhs-space-md) var(--xhs-space-md) 0;
}

.xhs-feed-card-full-title {
  font-size: var(--xhs-font-lg);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
}

.xhs-feed-card-full-action {
  display: flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border: 1px solid var(--xhs-divider-strong);
  border-radius: var(--xhs-radius-pill);
  transition: var(--xhs-transition);
}

.xhs-feed-card-full-action:active {
  background: var(--xhs-bg-secondary);
  transform: scale(0.95);
}

.xhs-feed-card-full-action-text {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-title);
  font-weight: var(--xhs-weight-medium);
}

.xhs-feed-card-full-body {
  padding: var(--xhs-space-sm) var(--xhs-space-md) var(--xhs-space-md);
}

/* === 交易明细列表 (卡片内) === */
.detail-list {
  max-height: 800rpx;
  overflow-y: auto;
}

.detail-item {
  padding: var(--xhs-space-md) 0;
  border-bottom: 1px solid var(--xhs-divider);
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--xhs-space-xs);
}

.detail-info {
  display: flex;
  align-items: center;
  gap: var(--xhs-space-sm);
  flex: 1;
  min-width: 0;
}

.detail-code {
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
}

.detail-name {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
}

.detail-amount {
  font-size: var(--xhs-font-lg);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
  flex-shrink: 0;
}

.detail-date {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
}

.detail-meta {
  display: flex;
  gap: var(--xhs-space-lg);
  margin-top: var(--xhs-space-xs);
}

.detail-meta-text {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
}

.detail-empty {
  text-align: center;
  padding: 60rpx 0;
  font-size: var(--xhs-font-md);
  color: var(--xhs-caption);
}

/* === 综合明细行 === */
.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--xhs-space-md) 0;
  border-bottom: 1px solid var(--xhs-divider);
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-row-label {
  font-size: var(--xhs-font-md);
  color: var(--xhs-body);
}

.detail-row-value {
  font-size: var(--xhs-font-lg);
  font-weight: var(--xhs-weight-semibold);
}

/* === 底部年度报告 CTA (小红书发布按钮风格) === */
.xhs-feed-footer {
  padding: var(--xhs-space-lg) 0;
  text-align: center;
}

.xhs-feed-cta {
  display: inline-flex;
  align-items: center;
  gap: var(--xhs-space-sm);
  background: var(--xhs-primary);
  color: #FFFFFF;
  font-size: var(--xhs-font-lg);
  font-weight: var(--xhs-weight-semibold);
  padding: 0 56rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: var(--xhs-radius-pill);
  box-shadow: var(--xhs-btn-shadow);
  transition: var(--xhs-transition);
}

.xhs-feed-cta:active {
  transform: scale(0.96);
  box-shadow: var(--xhs-btn-shadow-hover);
}

/* === 类型标签 === */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 2px 10px;
  border-radius: var(--xhs-radius-pill);
  font-size: var(--xhs-font-xs);
  font-weight: var(--xhs-weight-medium);
  letter-spacing: 0.01em;
  flex-shrink: 0;
}

.type-tag { margin: 0; }

.tag-buy {
  background: var(--xhs-profit-bg);
  color: var(--xhs-profit);
}

.tag-sell {
  background: var(--xhs-loss-bg);
  color: var(--xhs-loss);
}

.tag-dividend {
  background: var(--xhs-dividend-bg);
  color: var(--xhs-dividend);
}

/* === Profit/Loss === */
.profit { color: var(--xhs-profit); }
.loss { color: var(--xhs-loss); }
