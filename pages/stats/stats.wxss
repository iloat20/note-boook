/* stats.wxss - Liquid Glass Design */

/* === Glass Card === */
.card-glass {
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border-radius: var(--glass-radius);
  border: 0.5px solid var(--glass-border);
  box-shadow: var(--glass-shadow-out), var(--glass-shadow-in);
  padding: var(--space-card-pad);
  transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}
.card-glass::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.9), transparent);
  pointer-events: none;
}

.card-glass-sm {
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border-radius: var(--glass-radius);
  border: 0.5px solid var(--glass-border);
  box-shadow: var(--glass-shadow-out), var(--glass-shadow-in);
  padding: var(--space-card-pad);
  transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}
.card-glass-sm::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.9), transparent);
  pointer-events: none;
}

/* === Heatmap Liquid Glass === */
.heatmap-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.heatmap-nav {
  min-height: 44px;
  min-width: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-caption);
  font-size: 24px;
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-radius: 12px;
  border: 0.5px solid var(--glass-border);
  transition: all 200ms ease;
  position: relative;
  z-index: 1;
}

.heatmap-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  padding: 4px;
}

.heatmap-cell {
  width: calc((100% - 36px) / 7);
  aspect-ratio: 1;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--glass-bg);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 0.5px solid var(--glass-border);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04), inset 0 0.5px 0 rgba(255, 255, 255, 0.7);
  transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.heatmap-cell::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.5), transparent);
  border-radius: 10px 10px 0 0;
  pointer-events: none;
}

.heatmap-day {
  font-size: 11px;
  font-weight: 600;
  color: var(--color-caption);
  position: relative;
  z-index: 1;
}

/* Heatmap Levels with iOS Glass */
.heatmap-level-0 {
  background: rgba(0, 0, 0, 0.03);
}

.heatmap-level-1 {
  background: rgba(255, 59, 48, 0.08);
  border-color: rgba(255, 59, 48, 0.15);
  box-shadow: 0 2px 8px rgba(255, 59, 48, 0.06), inset 0 0.5px 0 rgba(255, 255, 255, 0.6);
}

.heatmap-level-2 {
  background: rgba(255, 59, 48, 0.15);
  border-color: rgba(255, 59, 48, 0.22);
  box-shadow: 0 3px 10px rgba(255, 59, 48, 0.1), inset 0 0.5px 0 rgba(255, 255, 255, 0.6);
}

.heatmap-level-3 {
  background: rgba(255, 59, 48, 0.25);
  border-color: rgba(255, 59, 48, 0.35);
  box-shadow: 0 4px 12px rgba(255, 59, 48, 0.15), inset 0 0.5px 0 rgba(255, 255, 255, 0.5);
}

.heatmap-level-3 .heatmap-day {
  color: #FF3B30;
  font-weight: 600;
}

.heatmap-level-4 {
  background: rgba(255, 59, 48, 0.4);
  border-color: rgba(255, 59, 48, 0.5);
  box-shadow: 0 4px 16px rgba(255, 59, 48, 0.25), inset 0 0.5px 0 rgba(255, 255, 255, 0.4);
}

.heatmap-level-4 .heatmap-day {
  color: #FF3B30;
  font-weight: 700;
}

/* === Heatmap Legend === */
.heatmap-legend {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid rgba(255, 255, 255, 0.3);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 10px;
  color: var(--color-caption);
}

.legend-color {
  width: 12px;
  height: 12px;
  border-radius: 3px;
  border: 0.5px solid rgba(255, 255, 255, 0.4);
}

/* === Tab Bar Frosted Glass === */
.tab-bar-line {
  display: flex;
  justify-content: center;
  gap: 8px;
  padding: 12px 16px;
  background: rgba(242, 242, 247, 0.6);
  backdrop-filter: saturate(180%) blur(40px);
  -webkit-backdrop-filter: saturate(180%) blur(40px);
  border-bottom: 0.5px solid rgba(255, 255, 255, 0.5);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-line-item {
  flex: 1;
  max-width: 100px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: var(--color-caption);
  background: transparent;
  border-radius: 10px;
  transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.tab-line-active {
  color: var(--color-accent);
  font-weight: 600;
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 0.5px solid var(--glass-border);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06), inset 0 0.5px 0 rgba(255, 255, 255, 0.7);
}

/* === Stats Card Grid === */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: var(--space-module);
  padding-top: 12px;
}

.stat-card {
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border-radius: var(--glass-radius);
  border: 0.5px solid var(--glass-border);
  box-shadow: var(--glass-shadow-out), var(--glass-shadow-in);
  padding: 16px;
  transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  width: calc(50% - 6px);
  box-sizing: border-box;
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.9), transparent);
  pointer-events: none;
}

.stat-label {
  font-size: 12px;
  color: var(--color-caption);
  font-weight: 400;
  display: block;
  margin-bottom: 4px;
  position: relative;
  z-index: 1;
}

.stat-value {
  font-size: 20px;
  color: var(--color-title);
  font-weight: 600;
  display: block;
  position: relative;
  z-index: 1;
}

/* === Section Title === */
.section-title {
  font-size: 20px;
  font-weight: 600;
  color: var(--color-title);
  display: block;
  margin-bottom: 12px;
  letter-spacing: 0.02em;
}

/* === List Item Glass === */
.list-item-glass {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
  border-bottom: 0.5px solid rgba(60, 60, 67, 0.08);
  transition: all 200ms ease;
}

.list-item-glass:last-child {
  border-bottom: none;
}

/* === Empty State Glass === */
.empty-state-glass {
  text-align: center;
  padding: 40px 20px;
  color: var(--color-caption);
  font-size: 14px;
}

/* === Chart Box === */
.chart-box {
  width: 100%;
  height: 220px;
  min-height: 220px;
  position: relative;
  padding: 0;
  overflow: hidden;
}

.chart-box ec-canvas {
  display: block;
  width: 100%;
  height: 100%;
}

/* === Chart Skeleton Loading === */
.chart-skeleton {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  padding: 40px 20px 40px 40px;
  z-index: 10;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.skeleton-bar {
  flex: 1;
  margin: 0 4px;
  background: linear-gradient(135deg, rgba(255, 59, 48, 0.15), rgba(255, 59, 48, 0.06));
  border-radius: 4px 4px 0 0;
  animation: chart-shimmer 1.5s infinite;
  position: relative;
  overflow: hidden;
}

.skeleton-bar::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
  animation: chart-shimmer-slide 1.5s infinite;
}

/* === Trend Chart Skeleton === */
.skeleton-line {
  position: absolute;
  left: 50px;
  right: 20px;
  height: 2px;
  background: linear-gradient(90deg, rgba(255, 59, 48, 0.2), rgba(255, 59, 48, 0.08));
  border-radius: 1px;
  animation: chart-shimmer 1.5s infinite;
}

.skeleton-bar-group {
  position: absolute;
  bottom: 40px;
  left: 50px;
  right: 20px;
  height: 150px;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
}

.skeleton-bar-small {
  width: 20px;
  height: 40%;
  background: linear-gradient(135deg, rgba(255, 59, 48, 0.2), rgba(255, 59, 48, 0.08));
  border-radius: 3px 3px 0 0;
  animation: chart-shimmer 1.5s infinite;
  animation-delay: inherit;
}

/* === Scatter Chart Skeleton === */
.scatter-skeleton {
  justify-content: center;
  align-items: center;
}

.skeleton-dot {
  position: absolute;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 59, 48, 0.2), rgba(255, 59, 48, 0.08));
  animation: chart-shimmer 1.5s infinite;
  animation-delay: inherit;
}

/* === Annual Report Button (Frosted Glass) === */
.annual-report-btn {
  padding: 6px 14px;
  background: var(--glass-bg);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 0.5px solid var(--glass-border);
  border-radius: 8px;
  margin-bottom: 16px;
}

/* === Chart Shimmer Animation === */
@keyframes chart-shimmer {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

@keyframes chart-shimmer-slide {
  0% { left: -100%; }
  100% { left: 100%; }
}
