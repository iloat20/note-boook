/* ═════════════════════════════════════════╗
   小红书风格 - 统计页 v2
   ╚════════════════════════════════════════╝ */

@import '../../styles/common.wxss';

page {
  background: var(--xhs-bg);
}

/* === 骨架屏 === */
.skeleton-container {
  padding-top: var(--xhs-space-lg);
}

.page-title {
  margin-bottom: var(--xhs-space-lg);
}

.page-title-text {
  font-size: var(--xhs-font-4xl);
  font-weight: var(--xhs-weight-bold);
  color: var(--xhs-title);
  letter-spacing: -0.02em;
  line-height: 1.15;
}

/* === 时段选择 (pill 风格) === */
.period-tabs {
  display: flex;
  justify-content: center;
  gap: var(--xhs-space-sm);
  padding: var(--xhs-space-md) 0;
  margin-bottom: var(--xhs-space-sm);
}

.period-tab {
  flex: 1;
  max-width: 120rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--xhs-font-md);
  color: var(--xhs-caption);
  font-weight: var(--xhs-weight-medium);
  border-radius: var(--xhs-radius-pill);
  transition: var(--xhs-transition);
}

.period-active {
  color: #1C1C1E;
  font-weight: var(--xhs-weight-semibold);
  position: relative;
  background: transparent;
  border: none;
}

.period-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 4rpx;
  background: #FF2442;
  border-radius: 2rpx;
}

/* === 统计卡片网格 === */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--xhs-space-sm);
  margin-bottom: var(--xhs-space-xl);
}

.stat-card {
  background: var(--xhs-surface);
  border-radius: var(--xhs-radius-md);
  box-shadow: var(--xhs-card-shadow);
  padding: var(--xhs-space-md);
  transition: var(--xhs-transition-slow);
  width: calc(50% - 6px);
  box-sizing: border-box;
}

.stat-card:active {
  transform: scale(0.97);
}

/* 统计卡片顶部色条 */
.stat-card:nth-child(1) { border-top: 4rpx solid var(--xhs-primary); }
.stat-card:nth-child(2) { border-top: 4rpx solid var(--xhs-market-a); }
.stat-card:nth-child(3) { border-top: 4rpx solid var(--xhs-market-hk); }
.stat-card:nth-child(4) { border-top: 4rpx solid var(--xhs-market-us); }

.stat-label {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
  font-weight: var(--xhs-weight-medium);
  display: block;
  margin-bottom: var(--xhs-space-xs);
  letter-spacing: 0.02em;
}

.stat-value {
  font-size: var(--xhs-font-2xl);
  color: var(--xhs-title);
  font-weight: var(--xhs-weight-bold);
  display: block;
  letter-spacing: 0.01em;
}

.stat-profit { color: var(--xhs-profit); }
.stat-loss { color: var(--xhs-loss); }

/* === Section 通用 === */
.section {
  margin-bottom: var(--xhs-space-xl);
}

.section-title {
  font-size: var(--xhs-font-2xl);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
  display: block;
  letter-spacing: -0.01em;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--xhs-space-md);
}

/* === XHS Card (替代旧的 card-glass) === */
.xhs-card {
  background: var(--xhs-surface);
  border-radius: var(--xhs-radius-md);
  box-shadow: var(--xhs-card-shadow);
  padding: var(--xhs-space-lg);
  position: relative;
  overflow: hidden;
  transition: var(--xhs-transition-slow);
}

/* === 热力图 === */
/* === 明细列表 === */
.detail-list {
  max-height: 800rpx;
  overflow-y: auto;
}

.detail-item {
  padding: var(--xhs-space-md) 0;
  border-bottom: 1px solid var(--xhs-divider);
  transition: var(--xhs-transition);
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--xhs-space-xs);
}

.detail-info {
  display: flex;
  align-items: center;
  gap: var(--xhs-space-sm);
  flex: 1;
  min-width: 0;
}

.detail-code {
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
}

.detail-name {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
}

.detail-amount {
  font-size: var(--xhs-font-lg);
  font-weight: var(--xhs-weight-semibold);
  letter-spacing: 0.01em;
  color: var(--xhs-title);
  flex-shrink: 0;
}

.detail-date {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
}

.detail-meta {
  display: flex;
  gap: var(--xhs-space-lg);
  margin-top: var(--xhs-space-xs);
}

.detail-meta text {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
}

.detail-empty {
  text-align: center;
  padding: 60rpx 0;
  font-size: var(--xhs-font-md);
  color: var(--xhs-caption);
}

/* === 综合明细行 === */
.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--xhs-space-md) 0;
  border-bottom: 1px solid var(--xhs-divider);
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-row-label {
  font-size: var(--xhs-font-md);
  color: var(--xhs-body);
}

.detail-row-value {
  font-size: var(--xhs-font-lg);
  font-weight: var(--xhs-weight-semibold);
  letter-spacing: 0.01em;
}

/* === 按钮 === */
.btn-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

/* 下载图标：向下箭头 + 底部横线 */
.icon-download {
  position: relative;
  width: 24rpx;
  height: 24rpx;
}
.icon-download::before {
  content: '';
  position: absolute;
  bottom: 2rpx;
  left: 2rpx;
  right: 2rpx;
  height: 2rpx;
  background: currentColor;
  border-radius: 1rpx;
}
.icon-download::after {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-top: 8rpx solid currentColor;
}

/* 报告图标：文档 + 折角 */
.icon-report {
  position: relative;
  width: 24rpx;
  height: 24rpx;
}
.icon-report::before {
  content: '';
  position: absolute;
  top: 2rpx;
  left: 2rpx;
  right: 2rpx;
  bottom: 2rpx;
  border: 2rpx solid currentColor;
  border-radius: 3rpx;
}
.icon-report::after {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  right: 2rpx;
  height: 2rpx;
  background: currentColor;
  border-radius: 1rpx;
  box-shadow: 0 6rpx 0 currentColor;
}

.export-btn {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 16rpx;
  border: 1px solid var(--xhs-divider-strong);
  border-radius: var(--xhs-radius-pill);
  font-size: var(--xhs-font-sm);
  color: var(--xhs-title);
  font-weight: var(--xhs-weight-medium);
  transition: var(--xhs-transition);
  min-height: 48rpx;
}

.export-btn:active {
  background: var(--xhs-bg-secondary);
  transform: scale(0.96);
}

.annual-btn {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  background: var(--xhs-primary);
  border-radius: var(--xhs-radius-pill);
  font-size: var(--xhs-font-sm);
  color: #FFFFFF;
  font-weight: var(--xhs-weight-medium);
  transition: var(--xhs-transition);
  min-height: 48rpx;
}

.annual-btn:active {
  opacity: 0.85;
  transform: scale(0.96);
}

/* === 类型标签 === */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 2px 10px;
  border-radius: var(--xhs-radius-pill);
  font-size: var(--xhs-font-xs);
  font-weight: var(--xhs-weight-medium);
  letter-spacing: 0.01em;
  flex-shrink: 0;
}

.type-tag {
  margin: 0;
}

.tag-buy {
  background: var(--xhs-loss-bg);
  color: var(--xhs-loss);
}

.tag-sell {
  background: var(--xhs-profit-bg);
  color: var(--xhs-profit);
}

.tag-dividend {
  background: var(--xhs-dividend-bg);
  color: var(--xhs-dividend);
}

/* === Profit/Loss colors for detail rows === */
.profit { color: var(--xhs-profit); }
.loss { color: var(--xhs-loss); }
