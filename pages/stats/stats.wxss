/* ═════════════════════════════════════════╗
   小红书首页风格 - 统计页 v4
   ╚════════════════════════════════════════╝ */

@import '../../styles/common.wxss';

.page-title {
  margin-bottom: var(--xhs-space-lg);
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 var(--page-margin);
}

/* === 骨架屏间距 === */
.skeleton-container {
  padding-top: var(--page-margin);
}

/* === 时段 Tab === */
.period-tabs {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  padding: 0 var(--page-margin);
  margin-bottom: var(--xhs-space-sm);
  position: relative;
}

.period-tab {
  padding: var(--xhs-space-sm) var(--xhs-space-md);
  font-size: 20rpx;
  font-weight: var(--xhs-weight-medium);
  color: var(--xhs-caption);
  position: relative;
  transition: color 250ms ease, font-weight 250ms ease;
}

.period-tab.active {
  color: var(--xhs-title);
  font-weight: var(--xhs-weight-semibold);
}

.period-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 50%;
  height: 3rpx;
  background: var(--xhs-primary);
  border-radius: 1.5rpx;
}

/* === 双列网格 (小红书笔记风格) === */
.xhs-feed-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--xhs-space-sm);
  padding: 0 var(--page-margin);
  margin-bottom: var(--xhs-space-sm);
}

.xhs-feed-card {
  width: calc(50% - var(--xhs-space-lg) / 2);
  background: var(--xhs-surface);
  border-radius: var(--xhs-radius-md);
  box-shadow: var(--xhs-elevation-2);
  overflow: hidden;
  transition: var(--xhs-transition-slow);
}

.xhs-feed-card:active {
  transform: scale(0.98);
}

.xhs-feed-card-inner {
  display: flex;
  flex-direction: column;
}

.xhs-feed-card-cover {
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.xhs-feed-card-emoji {
  font-size: 56rpx;
  position: relative;
  z-index: 1;
}

.xhs-feed-card-body {
  padding: var(--page-margin);
}

.xhs-feed-card-value {
  font-size: var(--xhs-font-xl);
  font-weight: var(--xhs-weight-bold);
  color: var(--xhs-title);
  letter-spacing: 0.02em;
  display: block;
  margin-bottom: var(--xhs-space-xxs);
  line-height: 1.2;
}

.xhs-feed-card-label {
  font-size: var(--xhs-font-xs);
  color: var(--xhs-caption);
  font-weight: var(--xhs-weight-medium);
  letter-spacing: 0.02em;
  text-transform: uppercase;
}

/* Cover 配色 */
.cover-invest { background: linear-gradient(135deg, #FFF5E6 0%, #FFE4CC 100%); }
.cover-recover { background: linear-gradient(135deg, #E6F3FF 0%, #CCE5FF 100%); }
.cover-pnl { background: linear-gradient(135deg, #FFF0F0 0%, #FFE0E0 100%); }
.cover-rate { background: linear-gradient(135deg, #F0FFF0 0%, #E0FFE0 100%); }
.cover-dividend { background: linear-gradient(135deg, #FFF8E6 0%, #FFEDCC 100%); }
.cover-days { background: linear-gradient(135deg, #F0F0FF 0%, #E0E0FF 100%); }

/* 盈亏色 */
.xhs-profit { color: var(--xhs-profit); }
.xhs-loss { color: var(--xhs-loss); }

/* === 完整卡片 (小红书长笔记风格) === */
.xhs-feed-card-full {
  margin: 0 var(--page-margin) var(--xhs-space-sm);
  background: var(--xhs-surface);
  border-radius: var(--xhs-radius-md);
  box-shadow: var(--xhs-elevation-2);
  overflow: hidden;
}

.xhs-feed-card-full-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--page-margin);
  border-bottom: 1px solid var(--xhs-divider);
}

.xhs-feed-card-full-title {
  font-size: var(--xhs-font-lg);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
}

.xhs-feed-card-full-action {
  display: flex;
  align-items: center;
  padding: var(--xhs-space-xs) var(--xhs-space-sm);
  border-radius: var(--xhs-radius-pill);
  background: #FCF6E8;
}

.xhs-feed-card-full-action-text {
  font-size: var(--xhs-font-xs);
  color: var(--xhs-caption);
  font-weight: var(--xhs-weight-medium);
}

.xhs-feed-card-full-body {
  padding: var(--page-margin);
}

/* 明细列表 */
.detail-list {
  display: flex;
  flex-direction: column;
  gap: var(--xhs-space-sm);
}

.detail-item {
  padding: var(--page-margin);
  background: var(--xhs-bg-secondary);
  border-radius: var(--xhs-radius-md);
  position: relative;
}

/* 完整明细列表：去掉单项底色，仅用分隔线区隔 */
.detail-list--plain .detail-item {
  background: transparent;
  border-radius: 0;
}

.detail-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--xhs-space-xs);
}

.detail-info {
  display: flex;
  align-items: center;
  gap: var(--xhs-space-xs);
  flex: 1;
  min-width: 0;
}

.detail-code {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
  font-weight: var(--xhs-weight-medium);
  flex-shrink: 0;
}

.detail-name {
  font-size: var(--xhs-font-md);
  color: var(--xhs-title);
  font-weight: var(--xhs-weight-semibold);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-amount {
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
  flex-shrink: 0;
  margin-left: var(--xhs-space-xs);
}

.detail-date {
  font-size: var(--xhs-font-xs);
  color: var(--xhs-caption);
  display: block;
}

.detail-row-single {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--xhs-space-xs);
  flex-wrap: nowrap;
}

.detail-row-single .detail-info {
  display: flex !important;
  align-items: center !important;
  gap: var(--xhs-space-xs) !important;
  flex: 1;
  min-width: 0;
}

.detail-row-single .detail-info .detail-code,
.detail-row-single .detail-info .detail-name {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.detail-date-inline {
  font-size: var(--xhs-font-xs);
  color: var(--xhs-caption);
  flex-shrink: 0;
  white-space: nowrap;
  margin-left: var(--xhs-space-xs);
}

/* === 第二行：股价 × 股数 (左)  ...  金额 (右) === */
.detail-row-detail {
  display: flex;
  align-items: flex-end;
  margin-top: 6rpx;
  padding-top: 6rpx;
  border-top: 1px solid var(--xhs-divider);
  line-height: 1;
}

.detail-d-price {
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-profit);
}

.detail-d-multiply {
  font-size: var(--xhs-font-md);
  color: var(--xhs-caption);
  margin: 0 4rpx;
}

.detail-d-shares {
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
}

.detail-d-amount {
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-semibold);
  margin-left: auto;
  flex-shrink: 0;
}

.detail-meta {
  display: flex;
  gap: var(--xhs-space-sm);
  margin-top: var(--xhs-space-xs);
}

.detail-meta-text {
  font-size: var(--xhs-font-xs);
  color: var(--xhs-caption);
}

.detail-empty {
  text-align: center;
  padding: var(--xhs-space-xl);
  color: var(--xhs-caption);
  font-size: var(--xhs-font-sm);
}

/* 明细行 */
.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--xhs-space-sm) 0;
  border-bottom: 1px solid var(--xhs-divider);
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-row-label {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
}

.detail-row-value {
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-semibold);
  color: var(--xhs-title);
}

/* === Tag === */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 3px 10px;
  border-radius: var(--xhs-radius-pill);
  font-size: var(--xhs-font-xs);
  font-weight: var(--xhs-weight-medium);
  line-height: 1.2;
  flex-shrink: 0;
}

.tag-buy {
  background: var(--xhs-profit-bg);
  color: var(--xhs-profit);
}

.tag-sell {
  background: var(--xhs-loss-bg);
  color: var(--xhs-loss);
}

.tag-dividend {
  background: var(--xhs-primary-bg);
  color: var(--xhs-primary);
}

.type-tag {
}

/* === CTA 按钮 === */
.xhs-feed-footer {
  padding: var(--page-margin);
  display: flex;
  justify-content: center;
}

.xhs-feed-cta {
  background: var(--xhs-surface);
  border: 2px solid var(--xhs-primary);
  color: var(--xhs-primary);
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-semibold);
  padding: var(--page-margin) var(--xhs-space-lg);
  border-radius: var(--xhs-radius-pill);
  text-align: center;
  transition: transform 200ms ease, background-color 200ms ease, border-color 200ms ease;
}

.xhs-feed-cta-danger {
  background: var(--xhs-surface);
  border: 2px solid #FF4D4F;
  color: #FF4D4F;
  font-size: var(--xhs-font-md);
  font-weight: var(--xhs-weight-semibold);
  padding: var(--page-margin) var(--xhs-space-lg);
  border-radius: var(--xhs-radius-pill);
  text-align: center;
  transition: transform 200ms ease, background-color 200ms ease, border-color 200ms ease;
}

.xhs-feed-cta-danger:active {
  background: #FFF0F0;
}

/* === Scroll === */
.xhs-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

/* === No More === */
.no-more {
  text-align: center;
  padding: var(--page-margin);
}

.no-more-text {
  font-size: var(--xhs-font-sm);
  color: var(--xhs-caption);
}
